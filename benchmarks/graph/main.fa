-- Graph traversal: adjacency lists (an array of arrays) grown one edge at a time, for V vertices and
-- 8V random edges, then a breadth-first search from four sources over a reused queue and distance
-- array. Random accesses at indices that come from data, so they are indexed with `try`. Vertex
-- ids and distances are `Int32`, as in the Rust and Goose versions.

let degree = 8
let sources = 4

-- The xorshift64 generator of the Goose suite.
function xorshift = (x: UInt64): UInt64 => {
	mutable value = x
	value = value.bitXor(value.shiftLeft(13))
	value = value.bitXor(value.shiftRight(7))
	value = value.bitXor(value.shiftLeft(17))
	value
}

-- A number between 0 and `bound` (excluded), as the Goose suite reduces its random numbers.
function randomBelow = (x: UInt64, bound: Integer<min = 1>): Integer => Integer(x %% UInt64(bound))

let vertexCount = 100_000 -- BENCH_N: a constant, as in the Goose version (`run.ts` rewrites it)
let edgeCount = vertexCount * degree

mutable adjacency = Array<Array<Int32>>.from([], capacity = vertexCount)
for 0..vertexCount {
	adjacency.push([])
}
mutable state: UInt64 = 12345
for 0..edgeCount {
	state = xorshift(state)
	let from = randomBelow(state, vertexCount)
	try adjacency[from].push(try Int32(randomBelow(state.shiftRight(24), vertexCount)))
}

-- Breadth-first search: the distances are shortest paths, so the checksum doesn't depend on the order
-- of the neighbours.
mutable distances = Array<Int32>.from([], capacity = vertexCount)
for 0..vertexCount {
	distances.push(-1)
}
mutable queue = Array<Int32>.from([], capacity = vertexCount)
mutable total = 0
mutable seed: UInt64 = 999
for 0..sources {
	seed = xorshift(seed)
	let source = randomBelow(seed, vertexCount)
	for distance in distances {
		distance = -1
	}
	queue.clear()
	try distances[source] = 0
	queue.push(try Int32(source))
	mutable head = 0
	while head < queue.length {
		let vertex = queue[head]
		head += 1
		let distance = try distances[vertex]
		total += distance
		for neighbor in try adjacency[vertex] {
			if try distances[neighbor] < 0 {
				try distances[neighbor] = distance + 1
				queue.push(neighbor)
			}
		}
	}
}
console.log(vertexCount + edgeCount)
console.log(total)
