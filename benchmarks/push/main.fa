-- Pushing records into a growing collection, without reserving the final size, as Goose does.
-- Items keep their addresses across growth. Fa's local collections can't hold references, so
-- the marks are indices, as prescribed by the reference documentation and the safe Rust row.
-- `array.fa` keeps the original reserved Array version as the `push-array` audit variant.

type Item = {
	key: Int32
	value: Int32
}

-- The xorshift64 generator of the Goose suite (`rng.goose`).
function xorshift = (x: UInt64): UInt64 => {
	mutable v = x
	v = v.bitXor(v.shiftLeft(13))
	v = v.bitXor(v.shiftRight(7))
	v.bitXor(v.shiftLeft(17))
}

let n = 32_000_000 -- BENCH_N: a constant, as in the Goose version (`run.ts` rewrites it)

mutable items: GrowingArray<Item> = []
mutable marks: Array<Integer> = []
mutable r: UInt64 = 12345
for i in 0..n {
	r = xorshift(r)
	items.push({ key = Int32(r %% 1_000_000), value = Int32(i %% 97) })
	if i %% 64 == 0 {
		marks.push(items.length - 1)
	}
}

mutable total = 0
for item in items {
	total += item.key
}
mutable markedTotal = 0
for mark in marks {
	markedTotal += try items[mark].value
}
console.log(items.length)
console.log(marks.length)
console.log(total)
console.log(markedTotal)
