function recursive = (depth: Integer, key: UInt32): Integer => {
	mutable map0 = Map<UInt32, UInt32>.from([(key, 0)], capacity = 32)
	map0[UInt32.maxValue] = 1
	mutable map1 = Map<UInt32, UInt32>.from([(key, 1)], capacity = 32)
	map1[UInt32.maxValue] = 2
	mutable map2 = Map<UInt32, UInt32>.from([(key, 2)], capacity = 32)
	map2[UInt32.maxValue] = 3
	mutable map3 = Map<UInt32, UInt32>.from([(key, 3)], capacity = 32)
	map3[UInt32.maxValue] = 4
	mutable map4 = Map<UInt32, UInt32>.from([(key, 4)], capacity = 32)
	map4[UInt32.maxValue] = 5
	mutable map5 = Map<UInt32, UInt32>.from([(key, 5)], capacity = 32)
	map5[UInt32.maxValue] = 6
	mutable map6 = Map<UInt32, UInt32>.from([(key, 6)], capacity = 32)
	map6[UInt32.maxValue] = 7
	mutable map7 = Map<UInt32, UInt32>.from([(key, 7)], capacity = 32)
	map7[UInt32.maxValue] = 8
	let inner = if depth > 0 { recursive(depth - 1, key) } else { 0 }
	assert map0.get(key) == 0
	assert map1.get(key) == 1
	assert map2.get(key) == 2
	assert map3.get(key) == 3
	assert map4.get(key) == 4
	assert map5.get(key) == 5
	assert map6.get(key) == 6
	assert map7.get(key) == 7
	inner + map0.size + map1.size + map2.size + map3.size + map4.size + map5.size + map6.size + map7.size
}
assert many(0, 7) == 96
assert recursive(20, 7) == 336
console.log("budgets ok") -- prints: budgets ok
