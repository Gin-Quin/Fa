	]
	mutable map: Map<UInt32, Int64> = []
	for turn in 0..2000 {
		let index = (turn * 37) %% 128
		let key = keys[index]
		let before = map.get(key)
		if expected[index] == Int64(-1) { assert before is none } else {
			assert before == expected[index]
		}
		if turn %% 3 == 0 {
			let other = (index + 11) %% 128
			map.delete(keys[other])
			expected[other] = -1
		}
		if turn %% 7 == 0 {
			map.delete(key)
			expected[index] = -1
		} else {
			map[key] = Int64(turn)
			expected[index] = Int64(turn)
		}
		if turn %% 113 == 0 { map.reserve(300) }
		if turn %% 401 == 0 {
			map.clear()
			for i in 0..128 { expected[i] = -1 }
		}
		mutable count = 0
		for i in 0..128 {
			let found = map.get(keys[i])
			if expected[i] == Int64(-1) { assert found is none } else {
				assert found == expected[i]
				count += 1
			}
		}
		assert map.size == count
	}
}
