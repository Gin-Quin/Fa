-- asynchronous: false
let exact: Int64 = 9007199254740993
function verify = (condition: Boolean) => { assert condition }
function testInt8 = (runtime: Int8) => {
	let literal: Map<Int8, Int64> = [(0, Int64.minValue), (-1, Int64.maxValue), (Int8.minValue, 123), (Int8.maxValue, -456)]
	assert literal.get(0) == Int64.minValue
	assert literal.get(-1) == Int64.maxValue
	assert literal.get(Int8.minValue) == Int64(123)
	assert literal.get(Int8.maxValue) == Int64(-456)
	mutable map = copy literal
	map.reserve(300)
	map[runtime] = 9007199254740993
	assert map.get(runtime) == exact
	assert map.delete(runtime)
	assert map.get(runtime) is none
	map[runtime] = Int64.maxValue
	assert map.take(runtime) == Int64.maxValue
	map.clear()
	assert map.size == 0
	map[Int8.maxValue] = 42
	assert map.get(Int8.maxValue) == Int64(42)
	let frame: Map<Int8, Int64> = [(runtime, Int64.minValue)]
	assert frame.get(runtime) == Int64.minValue
	mutable flags: Map<Int8, Boolean> = []
	flags[runtime] = true
	flags.reserve(200)
	assert flags.get(runtime) == true
	mutable narrow: Map<Int8, Int16> = []
	narrow[runtime] = Int16.minValue
	assert narrow.get(runtime) == Int16.minValue
	mutable floats: Map<Int8, Float> = [(runtime, -0.0)]
	floats.reserve(300)
	verify(floats.get(runtime) == 0.0)
	floats[runtime] = -1.25
	verify(floats.take(runtime) == -1.25)
}
testInt8(7)
function testUInt8 = (runtime: UInt8) => {
	let literal: Map<UInt8, Int64> = [(0, Int64.minValue), (1, Int64.maxValue), (128, 123), (UInt8.maxValue, -456)]
	assert literal.get(0) == Int64.minValue
	assert literal.get(1) == Int64.maxValue
	assert literal.get(128) == Int64(123)
	assert literal.get(UInt8.maxValue) == Int64(-456)
	mutable map = copy literal
	map.reserve(300)
	map[runtime] = 9007199254740993
	assert map.get(runtime) == exact
	assert map.delete(runtime)
	assert map.get(runtime) is none
	map[runtime] = Int64.maxValue
	assert map.take(runtime) == Int64.maxValue
	map.clear()
	assert map.size == 0
	map[UInt8.maxValue] = 42
	assert map.get(UInt8.maxValue) == Int64(42)
	let frame: Map<UInt8, Int64> = [(runtime, Int64.minValue)]
	assert frame.get(runtime) == Int64.minValue
	mutable flags: Map<UInt8, Boolean> = []
	flags[runtime] = true
	flags.reserve(200)
	assert flags.get(runtime) == true
	mutable narrow: Map<UInt8, Int16> = []
	narrow[runtime] = Int16.minValue
	assert narrow.get(runtime) == Int16.minValue
	mutable floats: Map<UInt8, Float> = [(runtime, -0.0)]
	floats.reserve(300)
	verify(floats.get(runtime) == 0.0)
	floats[runtime] = -1.25
	verify(floats.take(runtime) == -1.25)
}
