-- Bound async function values must mutate the caller's inline storage.
async function append = <capacity: UInt32>(items: InlineArray<String, capacity>)
	throws CapacityError mutates items.length => {
	await Task.yield()
	try items.push("entry {items.length} has a long string that must survive the callback")
}
mutable items: InlineArray<String, 1> = []
let callback = append<1>
try await callback(items)
console.log(items) -- prints: ["entry 0 has a long string that must survive the callback"]
