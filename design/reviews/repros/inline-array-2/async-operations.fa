-- Every operation through generic methods, callbacks and compile-time calls.
async function append = <Item, capacity: UInt32>(items: InlineArray<Item, capacity>, item: Item)
	throws CapacityError mutates items.length => {
 await Task.yield()
 try items.push(item)
}
async function operate = <capacity: UInt32>(items: InlineArray<String, capacity>)
	throws CapacityError | IndexError mutates items => {
	assert items.length == 0
	assert items.capacity == capacity
	assert items.pop() is none
	assert items.get(-1) is none
	try await append<String, capacity>(items, "one")
	try await append<String, capacity>(items, "two")
	try await append<String, capacity>(items, "three")
	mutable overflowed = false
	items.push("overflow") catch _error => { overflowed = true }
	assert overflowed
	assert items.length == 3
	assert items[2] == "three"
	assert items.get(0) == "one"
	assert items.get(3) is none
	items[1] = "changed"
	for item in items { item += "!" }
	assert items.pop() == "three!"
	assert items.take(1) == "changed!"
	try await append<String, capacity>(items, "deleted")
	try items.delete(0)
	assert try items[0] == "deleted"
	items.clear()
	assert items.length == 0
	assert items.pop() is none
	try await append<String, capacity>(items, "result")
}
type Buffer<capacity: UInt32> = {
	items: InlineArray<String, capacity> = []
	async function exercise = (self) throws CapacityError | IndexError mutates self.items => {
		let callback = operate<capacity>
		try await callback(self.items)
	}
}
async function build = (): InlineArray<String, 3> throws CapacityError | IndexError => {
	mutable buffer: Buffer<3> = {}
	try await buffer.exercise()
	let expected: InlineArray<String, 3> = ["result"]
	assert buffer.items == expected
	buffer.items
}
console.log(try await build()) -- prints: ["result"]
