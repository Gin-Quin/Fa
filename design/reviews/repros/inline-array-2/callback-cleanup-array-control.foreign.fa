type Resource = {
	name: String
	function destroy = (self) => { console.log("drop {self.name}") }
}
function clear = <Item, capacity: UInt32>(items: Array<Item>) mutates items => { items.clear() }
function run = <Item, capacity: UInt32>(create: () => Item) => {
	mutable items: Array<Item> = []
	items.push(create())
	let cleanup = clear<Item, capacity>
	cleanup(items) -- prints: drop callback
	console.log(items.length) -- prints: 0
}
run<Resource, 1>(() => Resource { name = "callback" })
