-- Print every endpoint comparison so a mismatch cannot stop later widths.
function observeInt8 = (value: Int8) => {
	let divisor: Int8 = 7
	for 0..1 {
		console.log("Int8", value %% divisor, value %% 7)
	}
}
observeInt8(Int8.minValue)
observeInt8(Int8.maxValue)
