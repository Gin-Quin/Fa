function slowUInt128 = (x: UInt128, d: UInt128) throws DivisionByZero => try x %% d
function checkUInt128 = (value: UInt128) throws DivisionByZero => {
	let one: UInt128 = 1
	let two: UInt128 = 2
	let power: UInt128 = 16
	let seven: UInt128 = 7
	for 0..3 {
		assert value %% one == (try slowUInt128(value, one))
		assert value %% two == (try slowUInt128(value, two))
		assert value %% power == (try slowUInt128(value, power))
		assert value %% seven == (try slowUInt128(value, seven))
		assert value %% 7 == (try slowUInt128(value, 7))
	}
}
for x in [0, 1, 7, 8, 120] { try checkUInt128(UInt128(x)) }
function generic = <Tag>(_tag: Tag, x: Integer): Integer => {
	let divisor = 7
	mutable value = x
	for 0..3 { value = value %% divisor }
	value
}
for x in [-1000, -1, 0, 1, 1000] {
	let d = 7 + arguments.length
	for 0..3 {
		assert (try x %% d) == (try slow(x, d))
		assert x %% globalDivisor == (try slow(x, globalDivisor))
	}
	assert generic(true, x) == (try slow(x, 7))
}
try checkInt8(Int8.minValue)
try checkInt8(Int8.maxValue)
try checkInt16(Int16.minValue)
try checkInt16(Int16.maxValue)
try checkInt32(Int32.minValue)
try checkInt32(Int32.maxValue)
try checkInt64(Int64.minValue)
try checkInt64(Int64.maxValue)
try checkInt128(Int128.minValue)
try checkInt128(Int128.maxValue)
try checkUInt8(UInt8.minValue)
try checkUInt8(UInt8.maxValue)
try checkUInt16(UInt16.minValue)
try checkUInt16(UInt16.maxValue)
try checkUInt32(UInt32.minValue)
try checkUInt32(UInt32.maxValue)
try checkUInt64(UInt64.minValue)
try checkUInt64(UInt64.maxValue)
try checkUInt128(UInt128.minValue)
try checkUInt128(UInt128.maxValue)
static computed = @generic(true, -8)
assert computed == 6
console.log("remainder widths ok")
