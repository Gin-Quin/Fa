for x in [-120, -8, -1, 0, 1, 8, 120] { try checkInt128(Int128(x)) }
function slowUInt8 = (x: UInt8, d: UInt8) throws DivisionByZero => try x %% d
function checkUInt8 = (value: UInt8) throws DivisionByZero => {
	let one: UInt8 = 1
	let two: UInt8 = 2
	let power: UInt8 = 16
	let seven: UInt8 = 7
	for 0..3 {
		assert value %% one == (try slowUInt8(value, one))
		assert value %% two == (try slowUInt8(value, two))
		assert value %% power == (try slowUInt8(value, power))
		assert value %% seven == (try slowUInt8(value, seven))
		assert value %% 7 == (try slowUInt8(value, 7))
	}
}
for x in [0, 1, 7, 8, 120] { try checkUInt8(UInt8(x)) }
function slowUInt16 = (x: UInt16, d: UInt16) throws DivisionByZero => try x %% d
function checkUInt16 = (value: UInt16) throws DivisionByZero => {
	let one: UInt16 = 1
	let two: UInt16 = 2
	let power: UInt16 = 16
	let seven: UInt16 = 7
	for 0..3 {
		assert value %% one == (try slowUInt16(value, one))
		assert value %% two == (try slowUInt16(value, two))
		assert value %% power == (try slowUInt16(value, power))
		assert value %% seven == (try slowUInt16(value, seven))
		assert value %% 7 == (try slowUInt16(value, 7))
	}
}
for x in [0, 1, 7, 8, 120] { try checkUInt16(UInt16(x)) }
function slowUInt32 = (x: UInt32, d: UInt32) throws DivisionByZero => try x %% d
function checkUInt32 = (value: UInt32) throws DivisionByZero => {
