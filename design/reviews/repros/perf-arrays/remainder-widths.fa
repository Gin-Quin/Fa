	for 0..3 {
		assert value %% one == (try slowInt128(value, one))
		assert value %% two == (try slowInt128(value, two))
		assert value %% power == (try slowInt128(value, power))
		assert value %% seven == (try slowInt128(value, seven))
		assert value %% 7 == (try slowInt128(value, 7))
