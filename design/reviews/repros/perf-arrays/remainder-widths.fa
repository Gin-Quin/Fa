-- Every native integer width, singleton lets, statics, literals and dynamic divisors.
static globalDivisor: Integer<min = 1> = 7
function slow = (x: Integer, d: Integer): Integer throws DivisionByZero => try x %% d
function slowInt8 = (x: Int8, d: Int8) throws DivisionByZero => try x %% d
function checkInt8 = (value: Int8) throws DivisionByZero => {
	let one: Int8 = 1
	let two: Int8 = 2
	let power: Int8 = 16
	let seven: Int8 = 7
	let negative: Int8 = -7
	let minusOne: Int8 = -1
	for 0..3 {
		assert value %% one == (try slowInt8(value, one))
		assert value %% two == (try slowInt8(value, two))
		assert value %% power == (try slowInt8(value, power))
		assert value %% seven == (try slowInt8(value, seven))
		assert value %% 7 == (try slowInt8(value, 7))
		assert value %% negative == (try slowInt8(value, negative))
		assert value %% minusOne == 0
	}
}
for x in [-120, -8, -1, 0, 1, 8, 120] { try checkInt8(Int8(x)) }
function slowInt16 = (x: Int16, d: Int16) throws DivisionByZero => try x %% d
function checkInt16 = (value: Int16) throws DivisionByZero => {
	let one: Int16 = 1
	let two: Int16 = 2
	let power: Int16 = 16
	let seven: Int16 = 7
	let negative: Int16 = -7
	let minusOne: Int16 = -1
	for 0..3 {
		assert value %% one == (try slowInt16(value, one))
		assert value %% two == (try slowInt16(value, two))
		assert value %% power == (try slowInt16(value, power))
		assert value %% seven == (try slowInt16(value, seven))
		assert value %% 7 == (try slowInt16(value, 7))
		assert value %% negative == (try slowInt16(value, negative))
		assert value %% minusOne == 0
	}
}
for x in [-120, -8, -1, 0, 1, 8, 120] { try checkInt16(Int16(x)) }
