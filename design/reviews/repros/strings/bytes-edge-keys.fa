-- Raw bytes resembling the edge forms of cut string spans must compare and hash as raw bytes.
let lowHead = Bytes.from([152, 128])
let lowHeadLonger = Bytes.from([152, 128, 97])
let highTail = Bytes.from([240, 159, 152])
let canonicalLow = Bytes.from([237, 184, 128])
let replacement = Bytes.from([239, 191, 189])
console.log(lowHead == canonicalLow, highTail == replacement, highTail == Bytes.from([240, 159, 152]))
mutable keys: Map<Bytes, Integer> = []
keys[copy lowHead] = 1
keys[copy highTail] = 2
keys[copy canonicalLow] = 3
keys[copy replacement] = 4
keys[copy lowHeadLonger] = 5
console.log(keys.size, keys.get(Bytes.from([152, 128])) ?? 0, keys.get(Bytes.from([240, 159, 152])) ?? 0, keys.get(Bytes.from([237, 184, 128])) ?? 0, keys.get(Bytes.from([239, 191, 189])) ?? 0)
mutable set: Set<Bytes> = []
set.add(copy lowHead)
set.add(copy canonicalLow)
console.log(set.size, set.includes(Bytes.from([152, 128])), set.includes(Bytes.from([237, 184, 128])), set.includes(Bytes.from([239, 191, 189])))
use part = lowHeadLonger[0..2]
console.log(part == lowHead, keys.get(copy part) ?? 0)
-- prints: false false true
-- prints: 5 1 2 3 4
-- prints: 2 true true false
-- prints: true 1
