-- An async function started as a task, appending a template to a local
-- string: the compiler emits invalid IR ("Instruction does not dominate all
-- uses") on every target.
async function work = (n: Integer): String => {
	mutable text = "t"
	text += "{n}"
	text
}
let task = start work(1)
console.log(await task catch _error => "cancelled") -- prints: t1
