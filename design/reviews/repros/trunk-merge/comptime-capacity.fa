-- Compile-time capacity: "during compile-time evaluation, storage hints are
-- ignored, `reserve` does nothing, and `capacity` equals `length` (or
-- `size`)" (collections/arrays.md, strings.md). Each line prints
-- capacity - length (or size) for one kind of collection, at compile time.
function arrays = (): Integer => {
	mutable items = Array.from([1, 2], capacity = 100)
	items.reserve(200)
	items.capacity - items.length
}
function growing = (): Integer => {
	mutable items = GrowingArray<Integer>.from([1, 2], capacity = 100)
	items.reserve(200)
	items.capacity - items.length
}
function pools = (): Integer => {
	mutable items = Pool.from([1, 2], capacity = 100)
	items.reserve(200)
	items.capacity - items.size
}
function growingPools = (): Integer => {
	mutable items = GrowingPool.from([1, 2], capacity = 100)
	items.reserve(200)
	items.capacity - items.size
}
function maps = (): Integer => {
	mutable items = Map.from([(1, 2)], capacity = 100)
	items.reserve(200)
	items.capacity - items.size
}
function sets = (): Integer => {
	mutable items = GrowingSet.from([1, 2], capacity = 100)
	items.reserve(200)
	items.capacity - items.size
}
function strings = (): Integer => {
	mutable text = String.from("héllo", capacity = 100)
	text.reserve(200)
	text.capacity - text.length
}
console.log(@arrays()) -- prints: 0
console.log(@growing()) -- prints: 0
console.log(@pools()) -- prints: 0
console.log(@growingPools()) -- prints: 0
console.log(@maps()) -- prints: 0
console.log(@sets()) -- prints: 0
console.log(@strings()) -- prints: 0
