-- Frame tables (`fa_table_local`) of the three entry layouts in recursive
-- functions (512-byte budget), past the budget, with string keys and values
-- that own memory, borrowed by loops and lookups only.
function depth = (n: Integer<min = 0, max = 50>, key: String): Integer => {
	let dense: Map<Integer, String> = [(n, "{key} value number {n} long enough"), (n + 1, key), (n + 2, "x")]
	let inline: Map<Int32, Int32> = [(n, 1), (0, 2), (-1, 3)]
	let set: Set<String> = [key, "{key}{n}", "constant"]
	mutable sum = 0
	for (k, v) in dense { sum += k + v.length }
	for (k, v) in inline { sum += v }
	for item in set { sum += item.length }
	sum += (dense.get(n) ?? "").length + (inline.get(0) ?? 0) + (if set.includes("{key}{n}") { 1 } else { 0 })
	if n == 0 { sum } else { sum + depth(n - 1, key) }
}
console.log(depth(40, "key with more than twenty-three bytes")) -- prints: 13253
function big = (n: Integer): Integer => {
	let table: Map<Integer, Integer> = [(n, 1), (n + 1, 2), (n + 2, 3), (n + 3, 4), (n + 4, 5), (n + 5, 6), (n + 6, 7), (n + 7, 8), (n + 8, 9), (n + 9, 10), (n + 10, 11), (n + 11, 12), (n + 12, 13), (n + 13, 14), (n + 14, 15), (n + 15, 16), (n + 16, 17), (n + 17, 18), (n + 18, 19), (n + 19, 20), (n + 20, 21), (n + 21, 22), (n + 22, 23), (n + 23, 24), (n + 24, 25), (n + 25, 26), (n + 26, 27), (n + 27, 28), (n + 28, 29), (n + 29, 30), (n + 30, 31), (n + 31, 32), (n + 32, 33), (n + 33, 34), (n + 34, 35)]
	mutable sum = 0
	for (k, v) in table { sum += v }
	sum + (table.get(n + 34) ?? 0) + table.size
}
console.log(big(1), big(1000)) -- prints: 700 700
