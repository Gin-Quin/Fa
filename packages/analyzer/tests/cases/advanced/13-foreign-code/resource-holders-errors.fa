-- a value holding a resource is move-only like the resource: an item of a
-- collection can't move out of it, a field can't move out of a resource,
-- and a moved field must be assigned again before the holder is used
-- file: main.fa
type Holder = { label: String, handle: Handle }

function close = (handle: Handle) => console.log(handle.descriptor)

export function = () => {
	mutable handles: Array<Handle> = [Handle { descriptor = 1 }]
	let first = handles[0]                          -- error: MEM002
	close(handles[0])                               -- error: MEM002
	let taken = handles.take(0)
	mutable holder = Holder { label = "h", handle = Handle { descriptor = 2 } }
	let moved = holder.handle
	console.log(holder.label)
	console.log(holder)                             -- error: MEM002
	holder.handle = Handle { descriptor = 3 }
	let again = holder
	let connection = Connection { handle = Handle { descriptor = 4 } }
	let inside = connection.handle                  -- error: MEM002
	close(taken)
	close(moved)
	console.log(again.label)
}
-- file: Handle.foreign.fa
export type = {
	descriptor: Int32
	function destroy = (self) => console.log("closed {self.descriptor}")
}
-- file: Connection.foreign.fa
export type = {
	handle: Handle
	function destroy = (self) => console.log("closed connection {self.handle.descriptor}")
}
