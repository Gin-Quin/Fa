-- docs: concurrency.md, "Tasks", "Cancelling a task", "Awaiting several tasks"
type Response = { body: String }
type HttpError = Errors { HttpError = { status: Integer } }
async function fetchData = (url: String): Response throws HttpError => Response { body = url }

async function loadAll = (urls: Array<String>): Array<Response> throws HttpError => {
	mutable tasks: Array<Task<Response> throws HttpError> = []
	for url in urls {
		tasks.push(start fetchData(url))
	}
	try await Task.all(tasks)
}

-- cancelling
async function slowOperation = (): Integer => 42
let userCancelled = arguments.length > 1
let task = start slowOperation()

if userCancelled {
	task.cancel()
}
-- `Cancelled` is added since `cancel()` may have been called
let result = await task catch error => 0
let other = start slowOperation()
let value = await other -- type value: Integer

-- combinators
async function combine = (urls: Array<String>) throws HttpError => {
	mutable first: Array<Task<Response> throws HttpError> = []
	mutable second: Array<Task<Response> throws HttpError> = []
	mutable third: Array<Task<Response> throws HttpError> = []
	for url in urls {
		first.push(start fetchData(url))
		second.push(start fetchData(url))
		third.push(start fetchData(url))
	}
	let responses = try await Task.all(first)   -- every result, or the first error
	let fastest = try await Task.any(second)    -- the outcome of the first task to finish
	let outcomes = await Task.settled(third)    -- the outcome of every task, errors included
	console.log("{responses.length} {fastest.body} {outcomes.length}")
	let all = Task.all([]) -- type all: Task(Array(Never))
}

async function loadPage = (): Array<Response> throws HttpError => {
	try await Task.all([
		start fetchData("https://api.example.com/header")
		start fetchData("https://api.example.com/content")
	])
}

-- a task can't be copied: awaiting it or giving it to a combinator moves it
async function moved = () throws HttpError => {
	let one = start fetchData("one")
	let response = try await one
	let again = try await one -- error MEM002
	let two = start fetchData("two")
	let both = try await Task.all([two])
	let after = try await two -- error MEM002
}
