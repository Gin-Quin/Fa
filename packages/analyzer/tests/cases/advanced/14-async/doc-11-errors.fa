-- pending: a gap of error types, not of async: `ParseError =>` in a `when` over `HttpError | ParseError` is TY057, and `error.toString()` of an error is E-OBJ-5 (also without async)
-- docs: concurrency.md, "Errors"
type Response = { body: String }
type Profile = { name: String }
type HttpError = Errors { HttpError = { status: Integer } }
let defaultProfile = Profile { name = "anonymous" }
async function fetchData = (url: String): Response throws HttpError => Response { body = url }
function parseProfile = (body: String): Profile throws ParseError => {
	let id = try Integer.parse(body)
	Profile { name = "user {id}" }
}

async function loadProfile = (id: Integer): Profile throws HttpError | ParseError => {
	let response = try await fetchData("/users/{id}")
	try parseProfile(response.body)
}

async function showProfile = (id: Integer) => {
	let profile = await loadProfile(id) catch error => when error is {
		HttpError => defaultProfile
		ParseError => {
			console.log("Bad payload: {error.toString()}")
			defaultProfile
		}
	}

	console.log(profile.name)
}

-- the errors of a started function are raised when its task is awaited
async function later = (id: Integer) throws HttpError | ParseError => {
	let task = start loadProfile(id)
	let first = try await task
	let other = start loadProfile(id)
	let second = await other catch error => defaultProfile
	let unhandled = start loadProfile(id)
	let third = await unhandled -- error E-ERR-3
}
