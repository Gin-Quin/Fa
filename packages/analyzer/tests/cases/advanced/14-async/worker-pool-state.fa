-- docs: concurrency.md, "Worker pools": `state` is the initial state of each
-- worker, optional when every field of the worker type has a default (or is
-- optional: the defaults of a type of another file are not known yet)
-- analysis-target: native
-- file: Scaler.worker.fa
export type = {
	factor: Integer

	function scale = (self, value: Integer): Integer => value * self.factor
}
-- file: Counter.worker.fa
export type = {
	label: String?

	function next = (self): Integer => 1
}
-- file: main.fa
use { WorkerPool, WorkerTimeout } = std.concurrency

type Plain = { value: Integer }

async function main = () => {
	mutable scalers = WorkerPool(Scaler) {
		count = 2
		state = Scaler { factor = 3 }
		timeout = 1000
	}
	let task: Task(Integer) throws WorkerTimeout = scalers.submit((worker) => await worker.scale(2))
	console.log(await task catch error => 0)
	scalers.shutdown()
	mutable counters = WorkerPool(Counter) { count = 2 } -- `Counter {}` for each worker
	counters.shutdown()
	mutable missing = WorkerPool(Scaler) { count = 2 } -- error: E-OBJ-2
	mutable wrong = WorkerPool(Scaler) { count = 2, state = Counter {} } -- error: STR001
	mutable extra = WorkerPool(Counter) { count = 2, size = 3 } -- error: E-OBJ-1
	mutable plain = WorkerPool(Plain) { count = 1, state = Plain { value = 1 } } -- error: E-TYPE-1
}
