-- docs: concurrency.md, "Worker pools": on the web, the pool's workers are Web Workers (step J2), and `submit` is awaited (a blocking `submit` needs a thread of `native`)
-- analysis-target: web
-- file: Scaler.worker.fa
export type = {
	factor: Integer

	function scale = (self, value: Integer): Integer => value * self.factor
}
-- file: main.fa
use { WorkerPool } = std.concurrency

async function main = () => {
	mutable scalers = WorkerPool(Scaler) { count = 2, state = Scaler { factor = 3 } }
	let scaled = await scalers.submit((scaler) => await scaler.scale(2))
	let blocked = scalers.submit((scaler) => await scaler.scale(3)) -- error: CONC010
	scalers.shutdown()
}
