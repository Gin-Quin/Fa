use { Channel, AtomicBoolean } = std.concurrency
mutable channel = Channel(Integer) { capacity = 2 }
try channel.send(1) -- error CONC010
let sent = channel.trySend(2)
let received = channel.receive() -- error CONC010
let next = channel.tryReceive()
channel.close()
mutable flag = AtomicBoolean { value = false }
let previous = flag.swap(true)
let shared = flag -- a copy shares the flag
console.log(shared.load())
