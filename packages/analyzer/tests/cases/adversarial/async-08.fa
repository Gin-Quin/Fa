-- cancelled in one branch only: the task may still run after the `if`
async function upload = (scores: Array<Integer>) => console.log("{scores.length}")
async function main = () => {
	mutable scores: Array<Integer> = [1, 2, 3]
	let task = start upload(scores)
	if arguments.length > 1 {
		task.cancel()
	} else {
		await task
	}
	scores.push(4)
	let other = start upload(scores)
	if arguments.length > 2 {
		other.cancel()
	}
	scores.push(5) -- error: REF013
}
