-- Worker handles retain the same worker when copied.
-- analysis-target: native
-- file: Counter.worker.fa
export type = {
	start: Integer
	function next = (self): Integer => self.start + 1
}
-- file: main.fa
async function main = () => {
	mutable counter = Counter { start = 1 }
	mutable copy = counter
	console.log(await counter.next())
}
