-- a declaration inside a branch doesn't repair the outer reference
type Person = { name: String }
mutable people: Array(Person) = [Person { name = "Ana" }]
use first = people[0]
people.push(Person { name = "Bao" })
if arguments.length > 1 {
	use first = people[0]
	console.log(first.name)
}
console.log(first.name) -- error: REF001
