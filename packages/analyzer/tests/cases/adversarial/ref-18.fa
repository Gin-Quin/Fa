-- may designate with ranges: delete(i) invalidates people[i..]
type Person = { name: String }
function example = (i: Integer<min = 0, max = 1>) => {
	mutable people: Array<Person> = [Person { name = "Ana" }, Person { name = "Bao" }, Person { name = "Cleo" }, Person { name = "Dan" }]
	use last = people[3]
	use zero = people[0]
	people.delete(i)
	console.log(last.name) -- error: REF001
	console.log(zero.name) -- error: REF001
}
example(0)
