-- deleting a user writes the posts' authors: a module-level `posts` must be mutable
mutable users: Pool<User> = []
let posts: Pool<Post> = [] -- error: REL019
type User = {
	name: String
	articles: Pool<posts->author>
}
type Post = {
	title: String
	author: (User in users)?
}
use ana = users.add({ name = "Ana" })
users.delete(ana)
