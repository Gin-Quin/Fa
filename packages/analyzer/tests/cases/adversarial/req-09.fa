-- a watch outlives the block that provides its requirements (returned subscription)
type Settings = { factor: Integer }
function factor = (): Integer requires settings: Settings => settings.factor
reactive count = 0
function install = (): Subscription => {
	provide Settings = { factor = 2 }
	let subscription = watch { -- error: REQ010
		console.log("{count * factor()}")
	}
	subscription
}
let kept = install()
count = 3
