-- a readonly field passed where a function writes it
type Account = {
	readonly balance: Integer = 0
}
function reset = (thing: { balance: Integer }) mutates thing => {
	thing.balance = 0
}
mutable account = Account {}
reset(account) -- error: STR007
-- reading it through a writable view is fine
function show = (thing: { balance: Integer }) => console.log("{thing.balance}")
show(account)
-- only the fields named by the `mutates` path are written
type Wallet = { readonly owner: String, total: Integer = 0 }
function deposit = (wallet: { owner: String, total: Integer }) mutates wallet.total => {
	wallet.total += 1
}
mutable wallet = Wallet { owner = "Ana" }
deposit(wallet)
