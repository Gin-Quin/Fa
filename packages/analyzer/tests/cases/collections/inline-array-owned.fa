type Box = { names: InlineArray<String, 3> = [] }
function make = (): Box throws CapacityError => {
	mutable box: Box = {}
	try box.names.push("a long string with owned storage and punctuation")
	try box.names.push("second")
	box
}
mutable box = try make()
let duplicate = copy box
try box.names[0] = "changed"
console.log(duplicate.names) -- prints: ["a long string with owned storage and punctuation", "second"]
console.log(box.names.pop()) -- prints: second
console.log(try box.names.take(0)) -- prints: changed

type Item = { number: Integer, rows: Array<Integer> }
mutable items: InlineArray<Item, 3> = [{ number = 1, rows = [2, 3] }]
let snapshot = copy items
items[0].rows.push(4)
console.log(snapshot[0].rows) -- prints: [2, 3]
console.log(items[0].rows) -- prints: [2, 3, 4]
items.clear()

mutable pool: GrowingPool<Box> = []
use entry = pool.add({ names = ["pooled"] })
try entry.names.push("second")
for item in pool { console.log(item.names) } -- prints: ["pooled", "second"]
mutable array: Array<Box> = [{ names = ["array"] }]
try array[0].names.push("second")
console.log(array[0].names) -- prints: ["array", "second"]
