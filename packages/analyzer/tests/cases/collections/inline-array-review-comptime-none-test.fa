function build = (): Boolean => {
	mutable values: InlineArray<none, 2> = []
	values.push(none)
	values.pop() is none -- warning: W-CMP-1
}
console.log(build()) -- prints: true
static result = @build()
console.log(result) -- prints: true

function ordinary = (): Boolean => {
	mutable values: Array<none> = []
	values.push(none)
	values.pop() is none -- warning: W-CMP-1
}
console.log(ordinary()) -- prints: true
static ordinaryResult = @ordinary()
console.log(ordinaryResult) -- prints: true
