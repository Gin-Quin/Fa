-- Iterators (types brief §5.0.6, control-flow/loops.md): `values()` and
-- `keys()`, the lazy methods, `for` over an iterator.
let numbers = [1, 2, 3, 4, 5, 6]
let firstLarge = numbers.values().map((n) => n * 1000).find((n) => n > 5000)
console.log(firstLarge ?? 0) -- prints: 6000
console.log(numbers.values().reduce((sum, n) => sum + n, 0)) -- prints: 21
console.log(numbers.values().firstValues().toArray()) -- prints: [1]
console.log(numbers.values().every((n) => n > 0)) -- prints: true
console.log(numbers.values().some((n) => n > 5)) -- prints: true
let evens = numbers.values().filter((n) => n %% 2 == 0) -- type evens: Iterator<Integer>
console.log(evens.toArray()) -- prints: [2, 4, 6]
let scores: Map<String, Integer> = [("ana", 12), ("bao", 17)]
for name in scores.keys() {
	console.log(name)
}
-- prints: ana
-- prints: bao
for score in scores.values() {
	console.log(score)
}
-- prints: 12
-- prints: 17
let tags: Set<String> = ["fa"]
console.log(tags.values().toArray()) -- prints: ["fa"]
-- the variable of a loop over `values()` designates the element
mutable doubled = [1, 2, 3]
for value in doubled.values() {
	value *= 2
}
console.log(doubled) -- prints: [2, 4, 6]
console.log(["a", "b", "c"].join(", ")) -- prints: a, b, c
