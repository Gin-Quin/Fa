-- prints: [1, 9, 3] [9, 3]
-- prints: [1, 9, 3] [9, 3]

function summary = (): String throws IndexError => {
	mutable values = [1, 2, 3]
	use middle = values[1..3]
	try middle[0] = 9
	"{values} {middle}"
}
static compiled = @summary()
console.log(compiled)
console.log(try summary())

function writeFirst = (items: Array<Integer>) throws IndexError mutates items[..] => {
	try items[0] = 7
}
function argumentsAndMethods = (): String throws IndexError => {
	mutable values = [0, 3, 1, 2, 4]
	mutable use middle = values[1..-1]
	try writeFirst(middle)
	middle.sortInPlace((a, b) => a - b)
	middle.reverseInPlace()
	let found = middle.some((item) => item == 7)
	mutable sum = 0
	for item in middle { sum += item }
	"{values} {middle} {found} {sum}"
}
static throughArguments = @argumentsAndMethods()
console.log(throughArguments)          -- prints: [0, 7, 2, 1, 4] [7, 2, 1] true 10
console.log(try argumentsAndMethods()) -- prints: [0, 7, 2, 1, 4] [7, 2, 1] true 10

function byteViews = (): String throws IndexError => {
	mutable bytes = Bytes.from([1, 2, 3, 4])
	mutable use middle = bytes[1..-1]
	try middle[-1] = 8
	mutable sum = 0
	for byte, index in middle {
		sum += byte
		if index == 0 { try middle[1] = 9 }
	}
	"{bytes} {middle} {sum}"
}
static throughBytes = @byteViews()
console.log(throughBytes)    -- prints: [1, 2, 9, 4] [2, 9] 11
console.log(try byteViews()) -- prints: [1, 2, 9, 4] [2, 9] 11

function frozenDesignation = (): String throws IndexError => {
	mutable values = [1, 2, 3]
	mutable use current = values[0..1]
	mutable use kept = values[0..1]
	for index in 0..3 {
		reuse current = values[index..index + 1]
		if index == 0 { reuse kept = current }
	}
	try current[0] = 9
	let saved = copy kept
	"{kept} {current} {values} {saved}"
}
static frozen = @frozenDesignation()
console.log(frozen)                  -- prints: [1] [9] [1, 2, 9] [1]
console.log(try frozenDesignation()) -- prints: [1] [9] [1, 2, 9] [1]

function callbackWrites = (): String => {
	mutable values = [{ score = 1 }, { score = 2 }, { score = 3 }]
	use middle = values[1..]
	let found = middle.some((item) => {
		item.score += 5
		true
	})
	let scores = values.map((item) => item.score)
	"{scores} {found}"
}
static callbackResult = @callbackWrites()
console.log(callbackResult)   -- prints: [1, 7, 3] true
console.log(callbackWrites()) -- prints: [1, 7, 3] true

function failedSort = (text: String): String => {
	mutable values = [0, 4, 3, 2, 1, 9]
	use middle = values[1..-1]
	do {
		middle.sortInPlace((left, right) => {
			let _number = try Integer.parse(text)
			left - right
		})
	} catch _error => {}
	"{values} {middle}"
}
static failedSortResult = @failedSort("bad")
console.log(failedSortResult)  -- prints: [0, 4, 3, 2, 1, 9] [4, 3, 2, 1]
console.log(failedSort("bad")) -- prints: [0, 4, 3, 2, 1, 9] [4, 3, 2, 1]
