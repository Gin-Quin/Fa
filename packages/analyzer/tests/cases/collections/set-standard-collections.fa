static equal7 = Set<Bytes>.from([Bytes.from([1, 2]), Bytes.from([1, 3])])
	== Set<Bytes>.from([Bytes.from([1, 3]), Bytes.from([1, 2])])
static different7 = Set<Bytes>.from([Bytes.from([1, 2])]) != Set<Bytes>.from([Bytes.from([1, 3])])
static growingEqual7 = GrowingSet<Bytes>.from([Bytes.from([1, 2]), Bytes.from([1, 3])])
	== GrowingSet<Bytes>.from([Bytes.from([1, 3]), Bytes.from([1, 2])])
console.log(
	equal7
	Set<Bytes>.from([Bytes.from([1, 2]), Bytes.from([1, 3])])
		== Set<Bytes>.from([Bytes.from([1, 3]), Bytes.from([1, 2])])
	different7
	Set<Bytes>.from([Bytes.from([1, 2])]) != Set<Bytes>.from([Bytes.from([1, 3])])
	growingEqual7
	GrowingSet<Bytes>.from([Bytes.from([1, 2]), Bytes.from([1, 3])])
		== GrowingSet<Bytes>.from([Bytes.from([1, 3]), Bytes.from([1, 2])])
) -- prints: true true true true true true
