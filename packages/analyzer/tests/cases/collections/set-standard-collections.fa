-- Complete-item equality through generic code, at compile time and runtime.
function exercise = <Item>(first: Item, second: Item): Boolean => {
	mutable items: Set<Item> = [first, first]
	assert items.size == 1
	assert items.includes(first)
	assert not items.includes(second)
	assert not items.add(first)
	assert items.add(second)
	assert items.delete(first)
	assert not items.delete(first)
	assert not items.includes(first)
	let taken = items.take(second) ?? first
	assert items.isEmpty()
	assert items.add(taken)
	assert items.includes(second)
	items.clear()
	assert items.isEmpty()
	mutable growing = GrowingSet<Item>.from([first, first], capacity = 8)
	assert not growing.add(first)
	assert growing.add(second)
	assert growing.includes(first)
	true
}
console.log(@exercise<Array<Integer>>([1, 2], [2, 1]), exercise<Array<Integer>>([1, 2], [2, 1])) -- prints: true true
console.log(
	@exercise<InlineArray<Integer, 4>>([1, 2], [2, 1])
	exercise<InlineArray<Integer, 4>>([1, 2], [2, 1])
) -- prints: true true
console.log(
	@exercise<GrowingArray<Integer>>([1, 2], [2, 1])
	exercise<GrowingArray<Integer>>([1, 2], [2, 1])
)                                                                                            -- prints: true true
console.log(@exercise<Set<Integer>>([1, 2], [1, 3]), exercise<Set<Integer>>([1, 2], [1, 3])) -- prints: true true
console.log(
	@exercise<GrowingSet<Integer>>([1, 2], [1, 3])
	exercise<GrowingSet<Integer>>([1, 2], [1, 3])
) -- prints: true true
console.log(
	@exercise<Map<Integer, String>>([(1, "a"), (2, "b")], [(1, "a"), (2, "c")])
	exercise<Map<Integer, String>>([(1, "a"), (2, "b")], [(1, "a"), (2, "c")])
) -- prints: true true
console.log(
	@exercise<GrowingMap<Integer, String>>([(1, "a"), (2, "b")], [(1, "a"), (2, "c")])
	exercise<GrowingMap<Integer, String>>([(1, "a"), (2, "b")], [(1, "a"), (2, "c")])
) -- prints: true true
console.log(
	@exercise<Bytes>(Bytes.from([1, 2]), Bytes.from([1, 3]))
	exercise<Bytes>(Bytes.from([1, 2]), Bytes.from([1, 3]))
) -- prints: true true

function unorderedItems = (): Boolean => {
	mutable sets: Set<Set<Integer>> = [[1, 2], [2, 1]]
	assert sets.size == 1
	assert sets.includes([2, 1])
	assert sets.delete([2, 1])
	mutable maps: Set<Map<Integer, String>> = [[(1, "a"), (2, "b")], [(2, "b"), (1, "a")]]
	assert maps.size == 1
	assert maps.includes([(2, "b"), (1, "a")])
	assert maps.delete([(2, "b"), (1, "a")])
	true
}
console.log(@unorderedItems(), unorderedItems()) -- prints: true true

static equal0 = Set<Array<Integer>>.from([[1, 2], [2, 1]])
	== Set<Array<Integer>>.from([[2, 1], [1, 2]])
static different0 = Set<Array<Integer>>.from([[1, 2]]) != Set<Array<Integer>>.from([[2, 1]])
static growingEqual0 = GrowingSet<Array<Integer>>.from([[1, 2], [2, 1]])
	== GrowingSet<Array<Integer>>.from([[2, 1], [1, 2]])
console.log(
	equal0
	Set<Array<Integer>>.from([[1, 2], [2, 1]]) == Set<Array<Integer>>.from([[2, 1], [1, 2]])
	different0
	Set<Array<Integer>>.from([[1, 2]]) != Set<Array<Integer>>.from([[2, 1]])
	growingEqual0
	GrowingSet<Array<Integer>>.from([[1, 2], [2, 1]])
		== GrowingSet<Array<Integer>>.from([[2, 1], [1, 2]])
) -- prints: true true true true true true

