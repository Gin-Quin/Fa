-- Complete-item equality through generic code, at compile time and runtime.
function exercise = <Item>(first: Item, second: Item): Boolean => {
	mutable items: Set<Item> = [first, first]
	assert items.size == 1
	assert items.includes(first)
	assert not items.includes(second)
	assert not items.add(first)
	assert items.add(second)
	assert items.delete(first)
	assert not items.delete(first)
	assert not items.includes(first)
	let taken = items.take(second) ?? first
	assert items.isEmpty()
	assert items.add(taken)
	assert items.includes(second)
	items.clear()
	assert items.isEmpty()
	mutable growing = GrowingSet<Item>.from([first, first], capacity = 8)
	assert not growing.add(first)
	assert growing.add(second)
	assert growing.includes(first)
	true
}
type Color = Enum { Red, Blue }
console.log(@exercise<Integer>(1, 2), exercise<Integer>(1, 2))               -- prints: true true
console.log(@exercise<Float>(0.0, 2.5), exercise<Float>(0.0, 2.5))           -- prints: true true
console.log(@exercise<Percentage>(10%, 20%), exercise<Percentage>(10%, 20%)) -- prints: true true
console.log(@exercise<Boolean>(true, false), exercise<Boolean>(true, false)) -- prints: true true
console.log(
	@exercise<String>("a long owned string beyond inline storage", "different")
	exercise<String>("a long owned string beyond inline storage", "different")
)                                                                                            -- prints: true true
console.log(@exercise<Color>(Color.Red, Color.Blue), exercise<Color>(Color.Red, Color.Blue)) -- prints: true true
console.log(@exercise<Integer?>(none, 2), exercise<Integer?>(none, 2))                       -- prints: true true
console.log(@exercise<Integer | String>(1, "1"), exercise<Integer | String>(1, "1"))         -- prints: true true
console.log(@exercise<Float32>(0.5, 2.5), exercise<Float32>(0.5, 2.5))                       -- prints: true true
console.log(@exercise<BigInt>(1n, 2n), exercise<BigInt>(1n, 2n))                             -- prints: true true

static equal0 = Set<Integer>.from([1, 2]) == Set<Integer>.from([2, 1])
static different0 = Set<Integer>.from([1]) != Set<Integer>.from([2])
static growingEqual0 = GrowingSet<Integer>.from([1, 2]) == GrowingSet<Integer>.from([2, 1])
console.log(
	equal0
	Set<Integer>.from([1, 2]) == Set<Integer>.from([2, 1])
	different0
	Set<Integer>.from([1]) != Set<Integer>.from([2])
	growingEqual0
	GrowingSet<Integer>.from([1, 2]) == GrowingSet<Integer>.from([2, 1])
) -- prints: true true true true true true

static equal1 = Set<Float>.from([0.0, 2.5]) == Set<Float>.from([2.5, 0.0])
static different1 = Set<Float>.from([0.0]) != Set<Float>.from([2.5])
static growingEqual1 = GrowingSet<Float>.from([0.0, 2.5]) == GrowingSet<Float>.from([2.5, 0.0])
console.log(
	equal1
	Set<Float>.from([0.0, 2.5]) == Set<Float>.from([2.5, 0.0])
	different1
	Set<Float>.from([0.0]) != Set<Float>.from([2.5])
	growingEqual1
	GrowingSet<Float>.from([0.0, 2.5]) == GrowingSet<Float>.from([2.5, 0.0])
) -- prints: true true true true true true

static equal2 = Set<Percentage>.from([10%, 20%]) == Set<Percentage>.from([20%, 10%])
static different2 = Set<Percentage>.from([10%]) != Set<Percentage>.from([20%])
static growingEqual2 = GrowingSet<Percentage>.from([10%, 20%])
	== GrowingSet<Percentage>.from([20%, 10%])
console.log(
	equal2
	Set<Percentage>.from([10%, 20%]) == Set<Percentage>.from([20%, 10%])
	different2
	Set<Percentage>.from([10%]) != Set<Percentage>.from([20%])
	growingEqual2
	GrowingSet<Percentage>.from([10%, 20%]) == GrowingSet<Percentage>.from([20%, 10%])
) -- prints: true true true true true true

static equal3 = Set<Boolean>.from([true, false]) == Set<Boolean>.from([false, true])
static different3 = Set<Boolean>.from([true]) != Set<Boolean>.from([false])
static growingEqual3 = GrowingSet<Boolean>.from([true, false])
	== GrowingSet<Boolean>.from([false, true])
console.log(
	equal3
	Set<Boolean>.from([true, false]) == Set<Boolean>.from([false, true])
	different3
	Set<Boolean>.from([true]) != Set<Boolean>.from([false])
	growingEqual3
	GrowingSet<Boolean>.from([true, false]) == GrowingSet<Boolean>.from([false, true])
) -- prints: true true true true true true

static equal4 = Set<String>.from(["a long owned string beyond inline storage", "different"])
	== Set<String>.from(["different", "a long owned string beyond inline storage"])
static different4 = Set<String>.from(["a long owned string beyond inline storage"])
	!= Set<String>.from(["different"])
static growingEqual4 = GrowingSet<String>.from([
	"a long owned string beyond inline storage"
	"different"
])
	== GrowingSet<String>.from(["different", "a long owned string beyond inline storage"])
console.log(
	equal4
	Set<String>.from(["a long owned string beyond inline storage", "different"])
		== Set<String>.from(["different", "a long owned string beyond inline storage"])
	different4
	Set<String>.from(["a long owned string beyond inline storage"])
		!= Set<String>.from(["different"])
	growingEqual4
	GrowingSet<String>.from(["a long owned string beyond inline storage", "different"])
		== GrowingSet<String>.from(["different", "a long owned string beyond inline storage"])
) -- prints: true true true true true true

static equal5 = Set<Color>.from([Color.Red, Color.Blue]) == Set<Color>.from([Color.Blue, Color.Red])
static different5 = Set<Color>.from([Color.Red]) != Set<Color>.from([Color.Blue])
static growingEqual5 = GrowingSet<Color>.from([Color.Red, Color.Blue])
	== GrowingSet<Color>.from([Color.Blue, Color.Red])
console.log(
	equal5
	Set<Color>.from([Color.Red, Color.Blue]) == Set<Color>.from([Color.Blue, Color.Red])
	different5
	Set<Color>.from([Color.Red]) != Set<Color>.from([Color.Blue])
	growingEqual5
	GrowingSet<Color>.from([Color.Red, Color.Blue])
		== GrowingSet<Color>.from([Color.Blue, Color.Red])
) -- prints: true true true true true true

static equal6 = Set<Integer?>.from([none, 2]) == Set<Integer?>.from([2, none])
static different6 = Set<Integer?>.from([none]) != Set<Integer?>.from([2])
static growingEqual6 = GrowingSet<Integer?>.from([none, 2]) == GrowingSet<Integer?>.from([2, none])
console.log(
	equal6
	Set<Integer?>.from([none, 2]) == Set<Integer?>.from([2, none])
	different6
	Set<Integer?>.from([none]) != Set<Integer?>.from([2])
	growingEqual6
	GrowingSet<Integer?>.from([none, 2]) == GrowingSet<Integer?>.from([2, none])
) -- prints: true true true true true true

static equal7 = Set<Integer | String>.from([1, "1"]) == Set<Integer | String>.from(["1", 1])
static different7 = Set<Integer | String>.from([1]) != Set<Integer | String>.from(["1"])
static growingEqual7 = GrowingSet<Integer | String>.from([1, "1"])
	== GrowingSet<Integer | String>.from(["1", 1])
console.log(
	equal7
	Set<Integer | String>.from([1, "1"]) == Set<Integer | String>.from(["1", 1])
	different7
	Set<Integer | String>.from([1]) != Set<Integer | String>.from(["1"])
	growingEqual7
	GrowingSet<Integer | String>.from([1, "1"]) == GrowingSet<Integer | String>.from(["1", 1])
) -- prints: true true true true true true
