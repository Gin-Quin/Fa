-- kind: test
function sameNumber = (a: Integer, b: Integer): Boolean => a == b
function isNone = (value: Integer?): Boolean => value == none
function isBytes = (value: Bytes | Array<Byte>): Boolean => value is Bytes
function positionOfError = (bytes: Bytes): Integer => {
	let _text = String.fromUtf8(bytes) catch error => return error.position
	-1
}

static data = Bytes.from(items = [1, 195, 169, 255])
static zeros = Bytes.filled(length = 3)
static filled = Bytes.filled(value = 255, length = 2)
static length = data.length
static last = data[-1]
static part = data[1..3]
static optional = data.get(-1)
static missing = data.get(100)
static items = data.toArray()
static display = data.toString()
static decoded = String.fromUtf8("é日😀".toUtf8())
static lossy = String.fromUtf8Lossy(data)
static errorPosition = @positionOfError(data)
static encodedHalf = "😀"[0].toUtf8()
static byteKind = @isBytes(data)
static arrayKind = @isBytes([1, 2])
static schema = @typeToSchema(Bytes)
type Binary = TypeFromSchema<Schema.Bytes>

function changed = (): Bytes throws IndexError => {
	mutable duplicate = Bytes.from([1, 2, 3, 4])
	mutable use middle = duplicate[1..3]
	try middle[1] = 255
	duplicate[-1] = 128
	duplicate
}
function collect = (): Array<Integer> => {
	mutable result: Array<Integer> = []
	for byte, index in "é😀".toUtf8() { result.push(byte + index) }
	result
}
static edited = @changed()
static walked = @collect()

@test "bytes and UTF-8 conversions at compile time" {
	assert sameNumber(length, 4) and sameNumber(last, 255) and sameNumber(optional, 255) and isNone(missing)
	assert part == "é".toUtf8()
	assert zeros == Bytes.from([0, 0, 0]) and filled == Bytes.from([255, 255])
	assert items == [1, 195, 169, 255] and display == "[1, 195, 169, 255]"
	assert decoded == "é日😀" and lossy == "\x01é�" and sameNumber(errorPosition, 3)
	assert encodedHalf == Bytes.from([239, 191, 189])
	assert byteKind and not arrayKind and schema == Schema.Bytes
	assert edited == Bytes.from([1, 2, 255, 128]) and not data.isEmpty()
	assert walked == [195, 170, 242, 162, 156, 133]
}
