-- file: main.fa
use { keys } = ./keys
use keyModule = ./keys
let first = { z = 9, a = 1 }
let second = { a = 2, z = 8 }
static direct = @keys<{ z: Integer, a: Integer }, { z, a }>({ z = 9, a = 1 })
static nested = @keyModule.keys<{ a: Integer, z: Integer }, { a, z }>({ a = 2, z = 8 })
console.log(direct, nested) -- prints: a,z a,z
console.log(keys<Type<first>, { z, a }>(first), keyModule.keys<Type<second>, { a, z }>(second)) -- prints: a,z a,z

-- file: keys.fa
export function keys = <Item, fields: Keys<Item>>(_value: Item, suffix: String = ""): String => {
	mutable result: Array<String> = []
	@for key in fields { result.push(key) }
	result.join(",") + suffix
}
