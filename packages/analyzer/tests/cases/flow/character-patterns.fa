-- a string literal pattern on a `String` compares the character
let text = "a)b+"
for c in text.characters() {
	if c is ")" {
		console.log("close {c}")
	} else if c is "+" | "-" {
		console.log("sign {c}")
	} else {
		console.log("other {c}")
	}
	let kind = when c is {
		")" => "paren"
		"a" | "b" => "letter"
		else => "symbol"
	}
	console.log(kind)
}
-- prints: other a
-- prints: letter
-- prints: close )
-- prints: paren
-- prints: other b
-- prints: letter
-- prints: sign +
-- prints: symbol
