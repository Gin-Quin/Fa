-- a union of built-in errors in `throws` covers each of them
function compute = (items: Array(Integer), divisor: Integer): Integer throws IndexError | DivisionByZero => {
	let first = try items[0]
	let result = try first // divisor
	result
}
console.log(compute([6], 2) catch error => 0) -- prints: 3
console.log(compute([], 2) catch error => -1) -- prints: -1
console.log(compute([6], 0) catch error => -2) -- prints: -2
