-- Scalar type expressions, ranged integers, optionals and conversions.
let score: Integer(min = 0, max = 10) = 5 -- type score: Integer(min = 0, max = 10)
let low: Int8(min = -3) = 1 -- type low: Int8(min = -3)
let maybe: Integer? = none -- type maybe: Integer?
let flag: Boolean = true
let ratio: Float = 1
let empty: Integer(min = 5, max = 1) = 5 -- error: E-NUM-13
let wide: Int8(max = 300) = 1 -- error: E-NUM-13
let over: Integer(min = 0, max = 10) = 11 -- error: E-NUM-6
let nothing: Void? = none -- error: E-OPT-9
let unknown: Nope = 1 -- error: TY007
let notAType = 1
let value: notAType = 1 -- error: TY008

let converted = Int8(3) -- type converted: Int8
let impossible = Int8(true) -- error: E-NUM-16
let typeAsValue = Integer -- error: TY008

function apply = (f: (x: Integer) => Integer, v: Integer): Integer => f(v)
let applied = apply((x) => x, 1) -- type applied: Integer
