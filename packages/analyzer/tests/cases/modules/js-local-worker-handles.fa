-- file: main.fa
use { Mutex, WorkerPool } = std.concurrency
async function main = () => {
	mutable source = Plain {}
	mutable count = 1
	let subscription = watch { console.log(count) }
	mutable local = Mutex<Subscription> { value = subscription }
	let localGuard = local.tryLock() ?? return
	localGuard.value.stop()
	let hidden: () => Integer = wrap(local)
	mutable holder = Holder { action = hidden } -- error CONC010
	let hiddenWorker: () => Integer = wrap(source)
	mutable other = Holder { action = hiddenWorker } -- error CONC010
	mutable pool = WorkerPool<Plain> { count = 1 }
	let bad = await pool.submit((_worker) => hidden()) -- error CONC010
	console.log(await bad)
	holder.stop()
	other.stop()
	subscription.stop()
	pool.shutdown()
	source.stop()
}
await main()
