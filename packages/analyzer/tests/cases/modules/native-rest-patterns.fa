-- require-split: true
-- file: library/parts.fa
let { label, ...dimensions } = { label = "box", width = 4, height = 5 }
let [first, ...words] = ["one", "two", "three"]
export namespace = {
	function describe = (): String => "{label} {dimensions.width}x{dimensions.height} {first} {words}"
	function tail = <Item>(items: Array<Item>): Array<Item> throws IndexError => {
		try let [_first, ...rest] = copy items
		rest
	}
}
-- file: application/main.fa
export function = (arguments: Array<String>): Integer => {
	console.log(library.parts.describe())
	console.log(library.parts.tail(["a", "b"]) catch _error => [])
	0
}
-- prints: box 4x5 one ["two", "three"]
-- prints: ["b"]
