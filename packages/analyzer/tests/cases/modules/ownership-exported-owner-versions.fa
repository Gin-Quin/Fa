-- prints: 7 [1, 3] [1]
-- file: library/owners.fa
mutable original: Array<Integer> = [1]
function read = (): Integer => original.sum()
let preserved = copy original
mutable saved = original
original = [2, 5]
saved.push(3)
export = { read = read, saved = saved, preserved = preserved }
-- file: application/main.fa
export function = () => console.log(library.owners.read(), library.owners.saved, library.owners.preserved)
