-- skip-target: wasm
-- prints: 3 4 5
-- file: application/main.fa
type Alias = library.Echo
use { Echo } = library
export async function = () => {
	mutable qualified = library.Echo { value = 3 }
	mutable aliased = Alias { value = 4 }
	mutable imported = Echo { value = 5 }
	console.log(await qualified.read(), await aliased.read(), await imported.read())
	qualified.stop()
	aliased.stop()
	imported.stop()
}
-- file: library/Echo.worker.fa
export type = {
	value: Integer
	function read = (self): Integer => self.value
}
