-- analysis-target: native
-- file: Holder.worker.fa
export type = {
	function read = (self): Integer => 0
}
-- file: bind.fa
use { Mutex } = std.concurrency
export function = (gate: Mutex<Task<Integer>>) => do {
	function inspect = (gate: Mutex<Task<Integer>>, extra: Integer): Integer => if gate.tryLock() == none { extra } else { 1 }
	inspect with (gate = gate, extra = 0)
}
-- file: bindGuard.fa
export function = <T>(guard: T) => do {
	function inspect = (_guard: T, extra: Integer): Integer => extra
	inspect with (_guard = guard, extra = 0)
}
-- file: main.fa
use { Mutex, WorkerPool } = std.concurrency
async function run = () => {
	let pending = start do { 1 }
	mutable gate = Mutex<Task<Integer>> { value = pending }
	let action: () => Integer = bind(gate)
	mutable pool = WorkerPool<Holder> { count = 1, state = Holder {} }
	let work = await pool.submit((_worker) => action()) -- error: CONC008
	console.log(await work)
	mutable value = Mutex<Integer> { value = 1 }
	let guard = value.tryLock() ?? return
	let guarded: () => Integer = bindGuard(guard)
	let other = await pool.submit((_worker) => guarded()) -- error: CONC008
	console.log(await other)
	pool.shutdown()
}
await run()
