-- file: main.fa
use { Mutex, WorkerPool } = std.concurrency
type Action = () => Integer
async function main = () => {
	let pending = start do { 1 }
	mutable gate = Mutex<Task<Integer>> { value = pending }
	let made = makeReader(gate)
	let stored = { action = made }
	let annotated: Action = stored.action
	mutable worker = Holder { action = annotated } -- error CONC008
	mutable pool = WorkerPool<Holder> { count = 1, state = Holder { action = annotated } } -- error CONC008
	console.log(await worker.invoke(annotated)) -- error CONC008
	worker.stop()
	pool.shutdown()
}
await main()
