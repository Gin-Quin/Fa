-- Completed deletions, callback writes and the unvisited tail survive an error.
type Person = { score: Integer }
function inspect = (text: String): Array<Integer> => {
	mutable items: Map<Integer, Person> = [
		(1, { score = 0 })
		(2, { score = 0 })
		(3, { score = 0 })
	]
	mutable examined = 0
	do {
		items.deleteWhere((_key, item) => {
			examined += 1
			item.score += 1
			if examined == 2 { let _number = try Integer.parse(text) }
			true
		})
	} catch _error => {}
	mutable result: Array<Integer> = []
	for (_key, item) in items { result.push(item.score) }
	result.sort()
}
static checked = @inspect("bad")
console.log(checked)        -- prints: [0, 1]
console.log(inspect("bad")) -- prints: [0, 1]
