-- prints: right right
-- prints: -5 -5

type OrderError = Errors { Failed = { label: String } }

function fail = (label: String): Integer throws OrderError => throw OrderError.Failed { label }

function difference = (left: Integer, right: Integer): Integer => left - right

function first = (): String => do {
	let _unexpected = difference(right = fail("right"), left = fail("left"))
	"unexpected"
} catch error => error.label

function reordered = (): Integer => difference(right = 7, left = 2)

static firstWritten = @first()
static boundInOrder = @reordered()
console.log(firstWritten, first())
console.log(boundInOrder, reordered())
