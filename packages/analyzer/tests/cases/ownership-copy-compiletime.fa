-- Compile-time copies apply the same projections and conversions as runtime copies.
function converted = (): Array<{ keep: Float }> => {
	let rows = [{ keep = Float32(1.25), omitted = [2] }]
	let result: Array<{ keep: Float }> = copy rows
	assert rows[0].omitted.length == 1
	result
}
static projected = @converted()
assert projected.get(0)?.keep == 1.25
console.log(projected.length) -- prints: 1

type Small = { value: Float32, extra: String, next: Small? }
type Wide = { value: Float, next: Wide? }
function widen = (): Integer => {
	let small = Small { value = 1.25, extra = "head", next = Small { value = 2.5, extra = "tail" } }
	let wide: Wide = copy small
	assert small.extra == "head"
	assert wide.value == 1.25
	assert wide.next?.value == 2.5
	if wide.next is none { 0 } else { 2 }
}
static wide = @widen()
console.log(wide) -- prints: 2

function choose = (flag: Boolean): Array<Float> => {
	let first: Array<Float32> = [1.25]
	let second: Array<Float32> = [2.5]
	copy (if flag { first } else { second })
}
static chosen = @choose(true)
assert chosen.get(0) == 1.25
console.log(chosen.length) -- prints: 1
