-- Existing defaults borrow; a fresh selected default is finalized by its call.
type Resource = {
	name: String
	function destroy = (self) => { console.log("drop {self.name}") }
}
function choose = (
	source: Resource
	flag: Boolean
	value: Resource = if flag { source } else { Resource { name = "fresh" } }
) => {
	console.log(value.name)
}
function show = (value: Resource = { name = "literal" }) => { console.log(value.name) }
function blockDefault = (
	value: Resource = do {
		let local = Resource { name = "block" }
		local
	}
) => { console.log(value.name) }
function fallback = (
	source: Resource?
	value: Resource = source ?? Resource { name = "fallback" }
) => { console.log(value.name) }
function lookup = (
	source: Map<String, Resource>
	key: String
	value: Resource = source.get(key) ?? Resource { name = "missing" }
) => { console.log(value.name) }
type DefaultError = Errors { Failed }
function fail = (): Integer throws DefaultError => throw DefaultError.Failed
function laterFailure = (
	value: Resource = { name = "before failure" }
	later: Integer = try fail()
) throws DefaultError => {
	console.log(value.name, later)
}
function run = () => {
	let held = Resource { name = "existing" }
	function label = (value: Resource = held) => { console.log(value.name) }
	label()
	console.log("after borrow")
	choose(held, true)
	console.log("between")
	choose(held, false)
	console.log("after choice")
	show(held)
	show()
	blockDefault()
	fallback(held)
	fallback(none)
	let entries: Map<String, Resource> = [("held", Resource { name = "map" })]
	lookup(entries, "held")
	lookup(entries, "absent")
	do { laterFailure() } catch _error => console.log("caught fresh default")
	do { laterFailure(held) } catch _error => console.log("caught borrowed default")
	function optional = (value: Resource? = held) => { console.log(value?.name) }
	optional()
}
run()
-- prints: existing
-- prints: after borrow
-- prints: existing
-- prints: between
-- prints: fresh
-- prints: drop fresh
-- prints: after choice
-- prints: existing
-- prints: literal
-- prints: drop literal
-- prints: block
-- prints: drop block
-- prints: existing
-- prints: fallback
-- prints: drop fallback
-- prints: map
-- prints: missing
-- prints: drop missing
-- prints: drop before failure
-- prints: caught fresh default
-- prints: caught borrowed default
-- prints: existing
-- prints: drop map
-- prints: drop existing
