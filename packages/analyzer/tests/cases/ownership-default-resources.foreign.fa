-- Existing defaults borrow; a fresh selected default is finalized by its call.
type Resource = {
	name: String
	function destroy = (self) => { console.log("drop {self.name}") }
}
function choose = (source: Resource, flag: Boolean, value: Resource = if flag { source } else { Resource { name = "fresh" } }) => {
	console.log(value.name)
}
function show = (value: Resource = Resource { name = "literal" }) => { console.log(value.name) }
function blockDefault = (value: Resource = do {
	let local = Resource { name = "block" }
	local
}) => { console.log(value.name) }
function fallback = (source: Resource?, value: Resource = source ?? Resource { name = "fallback" }) => { console.log(value.name) }
function run = () => {
	let held = Resource { name = "existing" }
	function label = (value: Resource = held) => { console.log(value.name) }
	label()
	console.log("after borrow")
	choose(held, true)
	console.log("between")
	choose(held, false)
	console.log("after choice")
	show(held)
	show()
	blockDefault()
	fallback(held)
	fallback(none)
}
run()
-- prints: existing
-- prints: after borrow
-- prints: existing
-- prints: between
-- prints: fresh
-- prints: drop fresh
-- prints: after choice
-- prints: existing
-- prints: literal
-- prints: drop literal
-- prints: block
-- prints: drop block
-- prints: existing
-- prints: fallback
-- prints: drop fallback
-- prints: drop existing
