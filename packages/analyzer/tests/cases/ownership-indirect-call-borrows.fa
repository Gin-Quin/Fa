-- prints: 2 2
-- prints: 1 1
-- prints: 2 2

type Reader = () => Integer
function zero = (): Integer => 0

function independent = (): Integer => {
	let items = [1]
	function read = (): Integer => items.length
	let invoke = read
	let moved = copy items
	invoke() + moved.length
}

function replaced = (): Integer => {
	let items = [1]
	function read = (): Integer => items.length
	mutable invoke: Reader = read
	invoke = zero
	let moved = items
	invoke() + moved.length
}

function projected = (): Integer => {
	let items = [1]
	let snapshot = copy items
	function read = (): Integer => snapshot.length
	let holder = { run = read }
	let readers = [holder.run, zero]
	let selected = readers[0]
	let moved = items
	selected() + moved.length
}

static independentResult = @independent()
static replacedResult = @replaced()
static projectedResult = @projected()
console.log(independentResult, independent())
console.log(replacedResult, replaced())
console.log(projectedResult, projected())
