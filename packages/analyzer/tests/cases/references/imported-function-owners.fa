-- prints: 5
-- file: main.fa
mutable model: Model = {}
use added = model.add(3)
use found = first(model)
if found is not none { found.value = 5 }
console.log(added.value)
-- file: Model.fa
export type = {
	nodes: GrowingPool<Node> = []
	type Node = { value: Integer }
	function add = (self, value: Integer): Node in self.nodes mutates self.nodes.size => self.nodes.add({ value = value })
}
-- file: first.fa
export function = (model: Model): (Model.Node in model.nodes)? => model.nodes.find((node) => true)
