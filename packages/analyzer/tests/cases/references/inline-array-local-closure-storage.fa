-- Storing a local closure is not its eventual reference-lifetime escape.
type Callback = () => Integer
type Holder = { callback: Callback }
function make = (): Callback => {
	mutable values: GrowingPool<Integer> = []
	use value = values.add(7)
	mutable holder: Holder = { callback = () => value }
	value = 9
	console.log(holder.callback()) -- prints: 9
	holder.callback = () => 42
	holder.callback
}
console.log(make()()) -- prints: 42
function local = () => {
	mutable values: GrowingPool<Integer> = []
	use value = values.add(10)
	let callbacks: InlineArray<Callback, 1> = [() => value]
	value = 11
	console.log(callbacks[0]()) -- prints: 11
}
local()
