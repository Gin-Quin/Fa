-- Regression from the links 1a review.
type Node = { value: Integer }
function wrong = (
	outer: GrowingPool<Node>
	other: GrowingPool<Node>
): Node in other mutates outer.size => {
	function captured = (_fake: GrowingPool<Node>): Node in outer => outer.add({ value = 7 }) -- error: REF008
	captured(other) -- error: REF008
}
function escape = (owner: GrowingPool<Node>): Node in owner => {
	mutable local: GrowingPool<Node> = []
	wrong(local, owner)
}
mutable b: GrowingPool<Node> = []
use node = escape(b)
console.log(node.value)
