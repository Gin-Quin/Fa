-- file: library/places.fa
export namespace = {
 type Node = { left: Integer, right: Integer, children: Array<Integer> }
 function element = (values: Array<Integer>, index: Integer): Integer in values throws IndexError => try values[index]
 function field = (values: Array<Node>, index: Integer): Integer in values throws IndexError => try values[index].left
 function choose = (values: Array<Node>, right: Boolean): Integer in values throws IndexError => {
  if right { try values[0].right } else { try values[0].left }
 }
 function first = <T>(values: Array<T>): T in values throws IndexError => try values[0]
 function forward = <T>(values: Array<T>): T in values throws IndexError => try first(values)
}
-- file: application/main.fa
use places = library.places
function exercise = (): Array<Integer> throws IndexError => {
 mutable values: Array<Integer> = [1]
 use item = try places.element(values, 0)
 item = 7
 mutable nodes: Array<places.Node> = [{ left = 2, right = 3, children = [4] }]
 use left = try places.field(nodes, 0)
 nodes[0].children.clear()
 let fieldPicker: (values: Array<places.Node>, index: Integer) => Integer in values throws IndexError = places.field
 use sameLeft = try fieldPicker(nodes, 0)
 nodes[0].children.clear()
 sameLeft += 0
 left = 8
 let pick: (values: Array<places.Node>, right: Boolean) => Integer in values throws IndexError = places.choose
 use right = try pick(nodes, true)
 right = 9
 use first = try places.forward(values)
 first += 10
 use node = try places.forward(nodes)
 node.left += 10
 [values[0], nodes[0].left, nodes[0].right]
}
static result = @exercise()
export function = () throws IndexError => {
 console.log(result) -- prints: [17, 18, 9]
 console.log(try exercise()) -- prints: [17, 18, 9]
}
