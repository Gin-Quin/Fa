-- opt-level: 0
-- Byte items use primitive references into Uint8Array on JavaScript.
function byteAt = (bytes: Bytes, index: Integer): Byte in bytes throws IndexError => try bytes[index]
function setByte = (bytes: Bytes, byte: Byte in bytes, value: Byte) mutates byte => {
	use target = byte
	target = value
}
function textPart = (text: String): String in text throws IndexError => try text[1..3]
function textUnit = (text: String): String in text throws IndexError => try text[1]
function bytePart = (bytes: Bytes): Bytes in bytes throws IndexError => try bytes[0..2]
function forwardBytes = (bytes: Bytes): Bytes in bytes throws IndexError => try bytePart(bytes)
function maybeText = (text: String, present: Boolean): (String in text)? throws IndexError => {
	if present { try textPart(text) } else { none }
}
function exercise = (): Integer throws IndexError => {
	mutable bytes = Bytes.from([1, 2, 3, 4])
	use byte = try byteAt(bytes, -1)
	setByte(bytes, byte, 9)
	mutable use part = bytes[1..3]
	try part[0] = 7
	reuse part = bytes[2..4]
	try part[0] = 8
	type BytePart = (bytes: Bytes) => Bytes in bytes throws IndexError
	let readBytes: BytePart = forwardBytes
	use prefix = try readBytes(bytes)
	try prefix[0] = 4
	let text = "a😀z"
	type TextPart = (text: String) => String in text throws IndexError
	let readText: TextPart = textPart
	use word = try readText(text)
	use absent = try maybeText(text, false)
	assert absent is none
	use unit = try textUnit(text)
	assert try unit.codeUnitAt(0) == 55357
	bytes[0] + bytes[1] + bytes[2] + bytes[3] + word.length + unit.length
}
static result = @exercise()
console.log(result) -- prints: 31
console.log(try exercise()) -- prints: 31
