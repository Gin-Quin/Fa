function textPart = (text: String): String in text throws IndexError => try text[1..3]
function bytePart = (bytes: Bytes): Bytes in bytes throws IndexError => try bytes[0..2]
mutable text = "abcd"
use word = try textPart(text)
word = "xy" -- error: REF016
use unit = text[0]
unit = "x" -- error: E-DECL-3
mutable bytes = Bytes.filled(4)
use part = try bytePart(bytes)
part = Bytes.filled(2) -- error: REF016

function overwriteUnit = (text: String, unit: String in text) => {
	use alias = unit
	alias = "x" -- error: E-DECL-3
}

function overwriteBytes = (bytes: Bytes, part: Bytes in bytes) => {
	use alias = part
	alias = Bytes.filled(2) -- error: REF016
}
