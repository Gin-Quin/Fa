-- file: main.fa
function exercise = (): Integer throws IndexError => {
	mutable bytes = Bytes.from([1, 2, 3])
	use part = try bytePart(bytes)
	try part[0] = 9
	let text = "a😀b"
	type Read = (text: String) => String in text throws IndexError
	let read: Read = textPart
	use word = try read(text)
	bytes[1] + word.length
}
static result = @exercise()
console.log(result)
console.log(try exercise())
-- file: bytePart.fa
export function = (bytes: Bytes): Bytes in bytes throws IndexError => try bytes[1..3]
-- file: textPart.fa
export function = (text: String): String in text throws IndexError => try text[1..3]
