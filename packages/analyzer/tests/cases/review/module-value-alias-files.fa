-- review 11, across files: an argument the callee changes may not alias a module-level value it reads, whatever the callee's file
-- file: main.fa
try settings.grow(settings.config) -- error: REF013
try settings.grow(settings.other)
-- file: settings.fa
type Config = { names: Array<String> }
export namespace = {
	mutable config = Config { names = ["a"] }
	mutable other = Config { names = ["b"] }
	function grow = (target: Config) throws IndexError mutates target => {
		use first = try config.names[0]
		for index in 0..100 {
			target.names.push("x")
		}
		console.log(first)
	}
}
