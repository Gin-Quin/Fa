-- Optional imported/generic methods use the same guarded continuation.
-- file: library/Person.fa
export type<label: String> = {
	name: String
	async function describe = (self): String => {
		await std.time.sleep(1)
		"{label}: {self.name}"
	}
}
-- file: library/invoke.fa
export async function = <Item: { describe: async (self) => String }>(value: Item?): String? =>
	await value?.describe()
-- file: application/main.fa
async function direct = (value: library.Person<"direct">?): String? => await value?.describe()
async function relay = (value: library.Person<"relayed">?): String? => await library.invoke(value)
async function started = (value: library.Person<"started">?) => {
	let task = start value?.describe()
	if task is none { console.log("none") } else { console.log(await task) }
}
async function startedGeneric = <Item: { describe: async (self) => String }>(value: Item?) => {
	let task = start value?.describe()
	if task is none { console.log("none") } else { console.log(await task) }
}
export async function = () => {
	await started(none)                                                     -- prints: none
	await started(library.Person { name = "Di" })                           -- prints: started: Di
	await startedGeneric(value = library.Person<"generic"> { name = "Er" }) -- prints: generic: Er
	await startedGeneric<library.Person<"generic">>(none)                   -- prints: none
	let value = library.Person<"imported"> { name = "Ada" }
	console.log(await library.invoke(value))                            -- prints: imported: Ada
	console.log(await library.invoke<library.Person<"imported">>(none)) -- prints: none
	console.log(await direct(none))                                     -- prints: none
	console.log(await direct(library.Person { name = "Bo" }))           -- prints: direct: Bo
	console.log(await relay(none))                                      -- prints: none
	console.log(await relay(library.Person { name = "Cy" }))            -- prints: relayed: Cy
}
