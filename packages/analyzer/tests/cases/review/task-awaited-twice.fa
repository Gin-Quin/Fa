-- review 14: a call of a local function uses the task it captures: not after the task was moved
async function compute = (n: Integer): Integer => n * 2

async function capture = () => {
	let task = start compute(1)
	async function later = () => await task
	let moved = task
	console.log(await moved)
	console.log(await later()) -- error: MEM002
}
await capture()
