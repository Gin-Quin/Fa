-- review 18: a value just built as a member of a named union is known to hold it (unions.md)
type Shape = Union {
	Circle = { r: Integer }
	Square = { s: Integer }
}
let s = Shape.Circle { r = 1 }
console.log(s.r) -- prints: 1
mutable t: Shape = Shape.Square { s = 2 }
console.log(t.s) -- prints: 2
t = Shape.Circle { r = 3 }
console.log(t.r) -- prints: 3
