-- Equal data layouts do not merge methods. The annotation or constructor
-- determines both ordinary dispatch and a generic method argument.
-- require-split: true
-- file: application/main.fa
type Person = {
	name: String
	function describe = (self): String => "Hello {self.name}"
}
type Alias = Person
type Imported = library.Greeting
function describe = <Item: { describe: (self) => String }>(item: Item): String => item.describe()
function identity = <Item>(item: Item): Item => item
function makeGreeting = (): library.Greeting => library.Greeting { name = "Cleo" }
function showBoth = (show: <Item: { describe: (self) => String }>(item: Item) => String, person: Person, greeting: library.Greeting): String => "{show(person)} {show(greeting)}"
type Holder<Item> = { value: Item }
type Speaker<Item: { describe: (self) => String }> = {
	value: Item
	function describe = (self): String => self.value.describe()
}
function inside = <Item: { describe: (self) => String }>(holder: Holder<Item>): String => holder.value.describe()
function describeList = <Item: { describe: (self) => String }>(items: Array<Item>): String => items.map((item) => item.describe()).join(", ")
export function = () => {
	let person = Person { name = "Ada" }
	let greeting: library.Greeting = { name = "Bea" }
	let alias: Alias = person
	console.log(person.describe(), greeting.describe(), alias.describe())
-- prints: Hello Ada Hi Bea Hello Ada
	console.log(describe(person), describe(greeting))
-- prints: Hello Ada Hi Bea
	console.log(describe<Imported>(greeting))
-- prints: Hi Bea
	console.log(identity(greeting).describe(), makeGreeting().describe(), library.make().describe(), library.person.describe())
-- prints: Hi Bea Hi Cleo Hi Dara Hi Ed
	console.log(showBoth(describe, person, greeting))
-- prints: Hello Ada Hi Bea
	let holder = Holder<Imported> { value = greeting }
	let localHolder = Holder<Person> { value = person }
	console.log(holder.value.describe(), localHolder.value.describe(), inside(holder), inside(localHolder))
-- prints: Hi Bea Hello Ada Hi Bea Hello Ada
	console.log(describe(Speaker<Imported> { value = greeting }), describe(Speaker<Person> { value = person }))
-- prints: Hi Bea Hello Ada
	let greetings: Array<Imported> = [greeting]
	let people = [person]
	console.log(describeList(greetings), describeList(people), greetings[0].describe())
-- prints: Hi Bea Hello Ada Hi Bea
	for item in greetings { console.log(item.describe()) }
-- prints: Hi Bea
	let filtered = greetings.reverse().filter((_item) => true)
	console.log(describeList(filtered))
-- prints: Hi Bea
	let found = greetings.get(0)
	if found is not none { console.log(found.describe()) }
-- prints: Hi Bea
	for item in greetings.values() { console.log(item.describe()) }
-- prints: Hi Bea
	let pair = (person, greeting)
	console.log(pair[0].describe(), pair[1].describe())
-- prints: Hello Ada Hi Bea
	let foreign = library.Tagged<"C"> { name = "foreign" }
	console.log(foreign.describe(), describe(foreign))
-- prints: C: foreign C: foreign
}
-- file: library/Greeting.fa
export type = {
	name: String
	function describe = (self): String => "Hi {self.name}"
}
-- file: library/make.fa
export function = (): Greeting => Greeting { name = "Dara" }
-- file: library/person.fa
export = Greeting { name = "Ed" }
-- file: library/Tagged.fa
export type<label: String> = {
	name: String
	function describe = (self): String => "{label}: {self.name}"
}
