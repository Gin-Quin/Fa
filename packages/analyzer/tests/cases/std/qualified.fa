-- the names of `std`, in full
mutable counter = std.concurrency.AtomicInteger { value = 0 }
mutable lock = std.concurrency.Mutex(Integer) { value = 0 }
function read = (shared: std.concurrency.Mutex(Integer)): Integer => 1
console.log(counter.increment()) -- prints: 1
let start = std.time.now() -- type start: Integer
console.log(start > 0) -- prints: true
