-- Tuples, ranges and destructuring (E3, values brief §10, §12, §16).
type Point = { x: Integer, y: Integer }

-- tuples
let pair = (1, "one") -- type pair: Tuple<Integer, String>
let typed: (Float, Integer) = (1, 2) -- type typed: Tuple<Float, Integer>
let first = pair[0] -- type first: Integer
let outside = pair[2] -- error: E-TUP-3
let unit = () -- error: E-TUP-1
let single: Tuple<Integer> = 1 -- error: E-TUP-1
mutable counts = (0, 0)
counts[1] = 5
pair[0] = 2 -- error: E-DECL-4
let same = pair == (1, "one")
let ordered = (1, 2) < (2, 3) -- error: E-CMP-2
function divide = (a: Integer, b: Integer<min = 1>): Tuple<Integer, Integer> => (a // b, a %% b)

-- destructuring
let (quotient, remainder) = divide(17, 5) -- type quotient: Integer
let (small, big) = (1, 300)
let byte: UInt8 = small
let { x, y as height } = Point { x = 1, y = 2 }
mutable { x as left } = Point { x = 3, y = 4 }
left += 1
let { z = 0 } = Point { x = 1, y = 2 } -- type z: Integer
let { w } = Point { x = 1, y = 2 } -- error: E-DST-3
let [head, ...tail] = [1, 2, 3] -- type tail: Array<Integer>
let (a, b, c) = (1, 2) -- error: E-DST-5
let { name } = 5 -- error: E-DST-2
let { p, p as q } = { p = 1 }
let { r, s as r } = { r = 1, s = 2 } -- error: E-DST-7
function sum = ({ x, y }: Point): Integer => x + y
function firstOf = (values: Array<Integer>): Integer throws IndexError => {
	try let [one] = values
	one
}
function unproven = (values: Array<Integer>) => {
	let [one, two] = values -- error: E-ERR-3
	if values.length >= 2 {
		let [three, four] = values
	}
}

-- in loops
for (number, label) in [(1, "a"), (2, "b")] {
	console.log(number + 1, label)
}
for { x as px } in [Point { x = 1, y = 2 }] {
	console.log(px)
}

-- ranges
let range = 1..4 -- type range: Range
mutable span = 0..10
span.end = none
let start = range.start -- type start: Integer?
let slice = [10, 20, 30, 40][1..3] -- type slice: Array<Integer>
let tooLong = [10, 20][0..5] catch error => [] -- type tooLong: Array<Integer>
-- ^ error: E-NUM-17; warning: W-ERR-2
let inside = 2 is in range
let literal = 2 is in 0..3 -- warning: W-RNG-1
let ratio = 1.5
let wrongPattern = ratio is 0..2 -- error: E-RNG-4
let notPattern = 3 is range -- error: E-CMP-5
mutable total = 0
for index in range {
	total += index
}
console.log(first, counts, same, quotient, remainder, byte, x, height, left, z, head, tail, sum(Point { x = 1, y = 2 }))
console.log(span, start, slice, tooLong, inside, literal, total)
