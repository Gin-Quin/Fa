-- note: generic function values with environments, in generic functions, and constrained
function tagAll = (tag: <T>(value: T) => String): String => "{tag(1)} {tag("a")} {tag(true)}"
let prefix = "#"
console.log(tagAll(<T>(value: T): String => "{prefix}{value}")) -- prints: #1 #a #true

-- a generic function value called from an instance of a generic function
function both = <U>(transform: <T>(value: T) => T, value: U): Array<U> => [transform(value), transform(value)]
console.log(both(<T>(value: T) => value, 4), both(<T>(value: T) => value, "b")) -- prints: [4, 4] ["b", "b"]

-- an environment made at each call of a function, then given and dropped
function tagWith = (prefix: String): String => tagAll(<T>(value: T): String => "{prefix}{value}")
console.log(tagWith("<"), tagWith(">")) -- prints: <1 <a <true >1 >a >true

-- a constraint: the instances its places never call aren't made
function keep = <T: Integer | Float>(value: T): T => value
function apply = (operation: <T: Integer | Float>(value: T) => T): String => "{operation(2)} {operation(1.5)}"
console.log(apply(keep), apply(<T>(value: T) => value)) -- prints: 2 1.5 2 1.5
