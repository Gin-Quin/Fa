-- note: a generic function carries its list on its value, and means what the parenthesized
-- spelling of the transition, `function first(Item) = …`, means (phase 1)
function first = <Item>(items: Array<Item>): Item? => items.get(0)
function older = <Item>(items: Array<Item>): Item? => items.get(0)
function load = async <Output>(value: Output): Output => value
type Stack<Item> = {
	#items: Array<Item> = []
	function push = (self, item: Item) mutates self => {
		self.#items.push(item)
	}
	function map = <Result>(self, transform: (item: Item) => Result) => Stack<Result> { #items = self.#items.map(transform) }
	function toArray = (self) => self.#items[..]
}

let name = first(["Ada", "Alan"]) -- type name: String?
let same = older(["Ada", "Alan"]) -- type same: String?
console.log(name, same, first<Integer>([3])) -- prints: Ada Ada 3
mutable stack = Stack<Integer> {}
stack.push(1)
stack.push(2)
console.log(stack.map((x) => x * 2).toArray()) -- prints: [2, 4]
