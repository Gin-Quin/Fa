-- note: 3.11-generics/gn-12.fa written with angle brackets (`fa migrate-generics`)
-- brief: ✓ gn-12: compile-time value parameters; equal values give one type
type Matrix<Element, rows: Integer, columns: Integer> = { values: Array<Element> }
type A = Matrix<Float, 4, 4>
type B = Matrix<Float, 2 + 2, 4>
let a: A = { values = [] }
let b: B = a -- valid: A ≡ B
