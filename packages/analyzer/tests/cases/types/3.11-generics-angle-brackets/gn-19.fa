-- note: 3.11-generics/gn-19.fa written with angle brackets (`fa migrate-generics`)
-- brief: ✓ gn-19: generic function as a value, instantiated by the expected type → ["Ada", "Alan"]
function identity = <Value>(value: Value): Value => value
console.log(["Ada", "Alan"].map(identity))
-- prints: ["Ada", "Alan"]
