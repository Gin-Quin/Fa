-- note: ranged integers written with angle brackets
type Digit = Integer<min = 0, max = 9>
let digit: Digit = 7
let tooBig: Integer<min = 0, max = 9> = 12 -- error: E-NUM-6
let negative: Digit = -1 -- error: E-NUM-6
let small: Int8<min = 0> = 3
let same: Integer(min = 0, max = 9) = digit -- the transition spelling
