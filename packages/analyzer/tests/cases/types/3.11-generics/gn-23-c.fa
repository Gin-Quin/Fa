-- brief: gn-23 and gn-24 with the functions in another file
-- file: library/select.fa
export function = <Entity, keys: Keys<Entity>>(entity: Entity): Pick<Entity, keys> => pick(entity, keys)
-- file: library/remove.fa
export function = <Entity, keys: Keys<Entity>>(entity: Entity): Omit<Entity, keys> => omit(entity, keys)
-- file: library/renamed.fa
export function = (human: { name: String }, name: String): Type<human> => {
	mutable copy = human
	copy.name = name
	copy
}
-- file: application/main.fa
type User = { name: String, email: String, password: String }
export function = () => {
	let user = User { name = "Ada", email = "a@b", password = "s" }
	console.log(library.select<User, { name, email }>(user))
	console.log(library.renamed(user, "Bea").name)
	console.log(library.remove<User, { password }>(user))
}
-- prints: { name = "Ada", email = "a@b" }
-- prints: Bea
-- prints: { name = "Ada", email = "a@b" }
