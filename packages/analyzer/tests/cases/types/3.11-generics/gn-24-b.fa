type Tight = { name: "a" | "b", age: Integer }
type Loose = { name: String, age: Integer }
let early = renamed(Tight { name = "a", age = 1 }, "zzz", 0)
let fine = renamed(Loose { name = "a", age = 1 }, "zzz", 0)
function renamed = (human: { name: String }, name: String, depth: Integer): Type<human> => {
	if depth > 0 {
		return renamed(human, name, depth - 1)
	}
	mutable duplicate = human
	duplicate.name = name
	duplicate
}
