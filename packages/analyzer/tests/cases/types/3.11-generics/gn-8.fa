-- brief: ✓ gn-8: union constraint checked per member (D19) → 4 / 3.0
-- note: a whole float prints without `.0` (values/numbers.md, printing): the brief's `6.0` and `3.0` are `6` and `3`
function double = <Value: Integer | Float>(value: Value) => value * 2
console.log(double(2))
console.log(double(1.5))
-- prints: 4
-- prints: 3
