-- note: `pick` and `omit` copy the fields they keep, from a place or a temporary, nested groups too (the result prints its fields in its subject's order, as gn-23 expects)
type Profile = { name: String, tags: Array<String>, address: { city: String, street: String } }
function make = (name: String): Profile => Profile { name, tags = ["a"], address = { city = "Paris", street = "Rue" } }
let profile = make("Ada")
console.log(pick(profile, { name, address { city } })) -- prints: { name = "Ada", address = { city = "Paris" } }
console.log(omit(make("Alan"), { tags, address { street } })) -- prints: { name = "Alan", address = { city = "Paris" } }
let kept = pick(profile, { tags })
console.log(kept.tags, profile.name) -- prints: ["a"] Ada
