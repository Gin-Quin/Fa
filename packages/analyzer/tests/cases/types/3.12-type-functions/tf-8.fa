-- brief: ✓ tf-8: Partial / Required → "{ foo: String?, bar: Integer? }" / "{ foo: String, bar: Integer }"
type P = { foo: String, bar: Integer }
console.log(@typeToString(Partial<P>))
console.log(@typeToString(Required<Partial<P>>))
let patch: Partial<P> = { bar = 12 }
console.log(patch.foo)
-- prints: { foo: String?, bar: Integer? }
-- prints: { foo: String, bar: Integer }
-- prints: none
