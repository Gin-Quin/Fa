type Scored = { score: Integer }
type Player = { name: String, score: Integer<min = 0, max = 10> }
function penalize = (scored: Scored) mutates scored => {
	scored.score = -5
}
mutable player = Player { name = "Ana", score = 3 }
penalize(player)
