-- 32 flags (bit 31), more than 32 (a JavaScript bigint), 128 (a native i128)
type Wide = Fields { f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31 }
type Wider = Fields { f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31, f32, f33, f34, f35, g { a, b, c, d } }
type Widest = Fields { f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31, f32, f33, f34, f35, f36, f37, f38, f39, f40, f41, f42, f43, f44, f45, f46, f47, f48, f49, f50, f51, f52, f53, f54, f55, f56, f57, f58, f59, f60, f61, f62, f63, f64, f65, f66, f67, f68, f69, f70, f71, f72, f73, f74, f75, f76, f77, f78, f79, f80, f81, f82, f83, f84, f85, f86, f87, f88, f89, f90, f91, f92, f93, f94, f95, f96, f97, f98, f99, f100, f101, f102, f103, f104, f105, f106, f107, f108, f109, f110, f111, f112, f113, f114, f115, f116, f117, f118, f119, f120, f121, f122, f123, f124, f125, last { x, y } }
let w = Wide { f31, f0 }
console.log(Integer(w))
console.log(w)
console.log(Wide.f31 is in w)
mutable v = w - Wide.f0
console.log(Integer(v))
v += { f30 }
console.log(v.toStringArray())
let x = Wider { f35, g { b } }
console.log(Integer(x))
console.log(x)
console.log(Wider.g is in x, Wider.g.b is in x)
let y = x + Wider.g
console.log(y.toStringArray())
console.log(y == x + { g { a, c, d } })
let z: Widest = { f0, last { y } }
console.log(UInt128(z))
console.log(z)
console.log((z - Widest.last).toStringArray())
-- prints: 2147483649
-- prints: { f0, f31 }
-- prints: true
-- prints: 2147483648
-- prints: ["f30", "f31"]
-- prints: 171798691840
-- prints: { f35, g { b } }
-- prints: false true
-- prints: ["f35", "g.a", "g.b", "g.c", "g.d"]
-- prints: true
-- prints: 170141183460469231731687303715884105729
-- prints: { f0, last { y } }
-- prints: ["f0"]
