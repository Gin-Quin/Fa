-- pending: M1 (imported from the types brief)
-- brief: ✓ fd-2: block with return type → "negative" / "zero" / "positive"
function classify = (value: Integer): String => {
	if value < 0 {
		return "negative"
	}
	if value == 0 {
		return "zero"
	}
	"positive"
}
console.log(classify(-1))
console.log(classify(0))
console.log(classify(1))
-- prints: "negative"
-- prints: "zero"
-- prints: "positive"
