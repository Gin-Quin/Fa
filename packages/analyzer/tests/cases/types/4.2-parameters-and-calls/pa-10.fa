-- skip-target: native wasm native-freestanding (native backend bug: a `Set` spread into a variadic parameter sums garbage)
-- brief: ✓ pa-10: a Set spreads into a variadic → 6
-- context: declarations reused from pa-7
function sum = (...values: Integer): Integer => {
	mutable total = 0
	for value in values {
		total += value
	}
	total
}
let set: Set(Integer) = [1, 2, 3]
console.log(sum(...set))
-- prints: 6
