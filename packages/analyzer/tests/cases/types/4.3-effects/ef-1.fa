type Player = { name: String, score: Integer }
function resetScore = (player: Player) mutates player.score => {
	player.score = 0
}
mutable ana = Player { name = "Ana", score = 5 }
resetScore(ana)
console.log(ana.score)
console.log(ana.name)
-- prints: 0
-- prints: "Ana"
