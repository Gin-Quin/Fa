-- brief: ✓ ar-2: negative index and slices → 30 / [2, 3, 4] / [2, 3, 4] / [3, 4, 5] / [4, 5] / []
let numbers = [10, 20, 30]
console.log(numbers[-1])
let data = [1, 2, 3, 4, 5]
console.log(data[1..4])
console.log(data[1..=3])
console.log(data[2..])
console.log(data[-2..])
console.log(data[3..1])
-- prints: 30
-- prints: [2, 3, 4]
-- prints: [2, 3, 4]
-- prints: [3, 4, 5]
-- prints: [4, 5]
-- prints: []
