-- brief: ✗ ma-7: EF032 (delete of an unknown key invalidates `score`)
-- context: declarations reused from ma-6 (repeated), `readName` added
function readName = (): String => "bao"
mutable sc: Map(String, Integer) = [("ana", 10), ("bao", 7)]
use score = sc.get("ana")
let loser = readName()
sc.delete(loser)
console.log(score) -- error: EF032
