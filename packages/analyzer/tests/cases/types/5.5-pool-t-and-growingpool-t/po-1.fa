type Human = { name: String, age: Integer }
mutable pool: Pool(Human) = []
use john = pool.add({ name = "John", age = 20 })
pool.add({ name = "Alice", age = 25 })
pool.add({ name = "Bob", age = 32 })
john.age += 1
console.log(john.age)
