-- brief: `toUtf8()` gives the UTF-8 bytes of a string → `[97, 98, 99] [97, 195, 169, 240, 159, 152, 128] 7 []` and `532 195 128 0`
let text = "aé😀"
console.log("abc".toUtf8(), text.toUtf8(), text.toUtf8().length, "".toUtf8())
let bytes = text.toUtf8() -- type bytes: Bytes
mutable sum = 0
for byte in "hello".toUtf8() {
	sum += byte
}
console.log(sum, try bytes[1], try text.toUtf8()[-1], text.toUtf8().get(9) ?? 0)
-- prints: [97, 98, 99] [97, 195, 169, 240, 159, 152, 128] 7 []
-- prints: 532 195 128 0
