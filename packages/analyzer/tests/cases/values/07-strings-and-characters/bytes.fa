-- Fixed-length binary data shares the array index and reference rules.
mutable bytes = Bytes.from([1, 2, 3]) -- type bytes: Bytes
bytes[0] = 255 -- no-check
let first = bytes[-1] -- type first: UInt8
let middle = bytes[1..3] -- type middle: Bytes
let maybe = bytes.get(10) -- type maybe: UInt8?
let array = bytes.toArray() -- type array: Array<UInt8>
let empty = Bytes.filled(0)
let filled = Bytes.filled(2, value = 255) -- type filled: Bytes
let zero = filled[0] -- no-check
use header = bytes[0..2]
console.log(header, first, middle, maybe, array, empty, filled, zero)
for byte, index in bytes {
	let value: Byte = byte
	console.log(value, bytes[index]) -- no-check
}
function at = (bytes: Bytes, index: Integer): Byte throws IndexError => try bytes[index]
function slice = (bytes: Bytes, end: Integer): Bytes throws IndexError => try bytes[..end]
function change = (data: Bytes) throws IndexError mutates data => { try data[0] = 1 }
let formatted: String = bytes.toString()
let isEmpty: Boolean = bytes.isEmpty()
let same: Boolean = bytes == Bytes.from([255, 2, 3])
console.log(formatted, isEmpty, same, at(bytes, 0) catch _error => 0, slice(bytes, 2) catch _error => Bytes.filled(0))
