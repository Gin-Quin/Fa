function rule = (): String throws IndexError => {
	mutable data = Bytes.from([1, 2, 3, 4])
	use source = data[0..3]
	mutable use destination = data[1..4]
	for index in 0..3 { try destination[index] = try source[index] }
	let copied = data.toString()
	reuse destination = data[..]
	for index in 0..4 { try destination[index] = 7 }
	mutable items = [1, 2]
	mutable use part = items[..]
	items.push(3)
	reuse part = items[1..3]
	try part[0] = 9
	mutable text = "abc"
	mutable use word = text[0..1]
	text.reserve(10)
	reuse word = try text[1..2]
	let kept = word
	text = "x" + (try text[1..])
	"{copied} {data} {items} {kept} {text}"
}
static result = @rule()
console.log(result, (try rule()) == result) -- prints: [1, 1, 1, 1] [7, 7, 7, 7] [1, 9, 3] b xbc true
