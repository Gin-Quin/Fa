function rule = (space: String): String => {
	let text = space + "x" + space
	"{text.trim()} {text.trimStart().length} {text.trimEnd().length} {space.trim().length} {"\u{85}x\u{85}".trim().length} {"\u{200B}x\u{200B}".trim().length} {"e\u{301}".trim() == "e\u{301}"}"
}
static space = "\u{9}\u{A}\u{B}\u{C}\u{D} \u{A0}\u{1680}\u{2000}\u{2001}\u{2002}\u{2003}\u{2004}\u{2005}\u{2006}\u{2007}\u{2008}\u{2009}\u{200A}\u{2028}\u{2029}\u{202F}\u{205F}\u{3000}\u{FEFF}"
static result = @rule(space)
console.log(result, rule(space) == result) -- prints: x 26 26 0 3 3 true true
