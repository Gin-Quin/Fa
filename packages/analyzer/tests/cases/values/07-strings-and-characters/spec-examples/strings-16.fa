-- Specification example: strings 16
mutable text = "hello world"

use word = text[0..5] -- a slice: no copy
console.log(word) -- "hello"

text += "!" -- mutates `text`: it may reallocate its storage
console.log(word) -- error: E-DECL-16 (`word` was invalidated: declare it again with `use word = text[...]`

