-- skip-target: native wasm native-freestanding
-- (the LLVM backend passes a mutated parameter by value: its `mutates` effect is lost)
-- brief: → `1`
type Counter = { #count: Integer = 0, function increment = (self) mutates self => {
self.#count += 1
}, function current = (self): Integer => self.#count }
mutable c = Counter {}
c.increment()
console.log(c.current())
-- prints: 1
