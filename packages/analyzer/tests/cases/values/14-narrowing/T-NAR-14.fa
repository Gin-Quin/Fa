-- corrected: `let g = () => …` is E-DECL-6, and a local `function` is hoisted (it may run before the test): the closure is given to a call
-- brief: → `5` [D-102]
function call = (g: () => Integer): Integer => g()
function f = (x: Integer?) => {
if x is not none {
console.log(call(() => x + 1))
}
}
f(4)
-- prints: 5
