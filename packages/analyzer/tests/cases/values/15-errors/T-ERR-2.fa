-- context: the types and `load` of T-ERR-1 (exact signatures: `throws ApiError.NotFound`, E-ERR-10)
-- brief: → `84`
type ApiError = Errors { NotFound = { id: String }, Timeout }
function load = (id: String): Integer throws ApiError.NotFound => {
if id == "" {
throw ApiError.NotFound { id }
}
42
}
function twice = (id: String): Integer throws ApiError.NotFound => {
let v = try load(id)
v * 2
}
console.log(twice("a") catch error => -1)
-- prints: 84
