-- brief: → `(4, 5) (0, 0)` (the first call needs its own `catch`: a `catch` covers its left operand only)
function firstTwo = (values: Array(Integer)): Tuple(Integer, Integer) throws IndexError => {
try let [first, second] = values
(first, second)
}
console.log(firstTwo([4, 5, 6]) catch e => (0, 0), firstTwo([4]) catch e => (0, 0))
-- prints: (4, 5) (0, 0)
