-- pending: no engine lowers a tuple binding in a `when` arm yet (compile-time evaluation, JavaScript, LLVM)
-- brief: → `12 6`
type Position = { x: Float, y: Float }
type Shape = Union { Point, Circle = { radius: Float }, Rectangle = { width: Float, height: Float }, Segment = Tuple<Position, Position> }
function area = (shape: Shape): Float => when shape is {
Shape.Point => 0.0
Shape.Circle as circle => circle.radius * circle.radius * 3.0
Shape.Rectangle as { width, height } => width * height
Shape.Segment as (start, end) => 0.0
}
console.log(area(Shape.Circle { radius = 2.0 }), area(Shape.Rectangle { width = 2.0, height = 3.0 }))
-- prints: 12 6
