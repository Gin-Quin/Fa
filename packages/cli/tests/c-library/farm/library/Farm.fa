-- A farm: a Fa value, which C holds behind a pointer
export type = {
	name: String
	animals: Int64

	-- C receives the position of the member as a status
	type Error = Errors {
		Empty
		TooMany = { count: Int64 }
		BadName = { name: String }
	}

	function countAnimals = (self): Int64 throws Self.Error => {
		if self.animals == 0 {
			throw Self.Error.Empty
		}
		self.animals
	}
}
