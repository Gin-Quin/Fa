-- The C interface of the library (`build.cLibrary.api`)
type Point = CStruct {
	x: Int32
	y: Float32
}

type Triple = CStruct {
	a: Float64
	b: Float64
	c: Float64
}

type MathError = Errors {
	DivisionByZero
	Negative = { value: Int32 }
}

export namespace = {
	function createFarm = (name: CString): Pointer<Farm> => Pointer.allocate(Farm { name = name.toString(), animals = 0 })

	function destroyFarm = (farm: Pointer<Farm>) => farm.free()

	function addAnimals = (farm: Pointer<Farm>, count: Int64) throws Farm.Error.TooMany => {
		let current = farm.read()
		if current.animals + count > 100 {
			throw Farm.Error.TooMany { count = current.animals + count }
		}
		farm.write(Farm { name = current.name, animals = current.animals + count })
	}

	function animalCount = (farm: Pointer<Farm>): Int64 throws Farm.Error.Empty => try farm.value.countAnimals()

	function nameLength = (farm: Pointer<Farm>): Int64 => farm.value.name.length

	function greet = (name: CString) => {
		console.log("{greetings.greeting}, {name.toString()}!")
	}

	function sumOfSquares = (): Int64 => {
		mutable total: Int64 = 0
		for square in greetings.squares {
			total += square
		}
		total
	}

	function scale = (point: Point, factor: Int32): Point => Point { x = point.x * factor, y = point.y * 2.0 }

	function sum = (triple: Triple): Float64 => triple.a + triple.b + triple.c

	function makeTriple = (value: Float64): Triple => Triple { a = value, b = value * 2.0, c = value * 3.0 }

	function divide = (a: Int32, b: Int32): Int32 throws MathError => {
		if b == 0 {
			throw MathError.DivisionByZero
		}
		if a < 0 {
			throw MathError.Negative { value = a }
		}
		a // b
	}

	function isEven = (value: Int64): Boolean => value %% 2 == 0

	function maybeFarm = (create: Boolean): Pointer<Farm>? => {
		if create {
			return Pointer.allocate(Farm { name = "Maybe", animals = 1 })
		}
		none
	}

	function half = (value: Float32): Float32 => value / 2.0

	function rename = (farm: Pointer<Farm>, name: CString) throws Farm.Error.BadName => {
		let text = name.toString()
		if text.length > 40 {
			throw Farm.Error.BadName { name = text }
		}
		farm.write(Farm { name = text, animals = farm.read().animals })
	}
}
