export function = (arguments: Array<String>): Integer => {
	mutable counts = library.tally([3, 1, 3, 7, 3, 1])
	-- a deleteWhere over the tally's map type, in another unit
	counts.deleteWhere((key, value) => value == 1)
	mutable total = 0
	for (key, value) in counts {
		total += Integer(key) * 100 + Integer(value)
	}
	mutable words = library.words("a b a c a b")
	words["d"] = 9
	mutable squares = library.squares(50)
	squares.delete(4)
	mutable sum = 0
	for (key, value) in squares {
		sum += value
	}
	console.log(counts.size, total, words.get("a") ?? 0, words.size, squares.size, sum)
	0
}
