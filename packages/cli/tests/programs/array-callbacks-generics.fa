-- The Array API with function values (a callback may leave out its `index`),
-- and generic functions (erased).
function double = (value: Integer): Integer => value * 2
function label = (value: Integer, index: Integer): String => "{index}:{value}"
function isEven = (value: Integer): Boolean => value %% 2 == 0
let values = [3, 1, 4, 1, 5]
console.log(values.map(double), values.map(label), values.filter(isEven))
-- prints: [6, 2, 8, 2, 10] ["0:3", "1:1", "2:4", "3:1", "4:5"] [4]
console.log(values.map((value, index) => value * index), values.find(isEven), values.some(isEven), values.every(isEven))
-- prints: [0, 1, 8, 3, 20] 4 true false
console.log(values.reduce((total, value, index) => total + value * index, 0), values.reduce((a, b) => a + b, 0))
-- prints: 32 14
console.log(values.sort((a, b) => b - a), values.sort(), values.indexOf(4), values.includes(9))
-- prints: [5, 4, 3, 1, 1] [1, 1, 3, 4, 5] 2 false
mutable kept = values
kept.deleteWhere(isEven)
console.log(kept, values.sum())
-- prints: [3, 1, 1, 5] 14

function first = <Item>(items: Array<Item>): Item? => items.get(0)
function pair = <Left, Right>(left: Left, right: Right): Tuple<Left, Right> => (left, right)
console.log(first([1, 2]), first(["a"]), first(Array<String>.from([])), pair(1, "one"))
-- prints: 1 a none (1, "one")

function both = <Number: Integer | Float>(a: Number, b: Number): Array<Number> => [a, b]
console.log(both(1, 2), both(0.5, 2.0))
-- prints: [1, 2] [0.5, 2]

-- methods required by a constraint, value parameters: hidden parameters
type Cat = { name: String, function describe = (self): String => "I am {self.name}" }
function describeAll = <Item: { describe: (self) => String }>(items: Array<Item>) => {
	for item in items {
		console.log(item.describe())
	}
}
function describeTwice = <Item: { describe: (self) => String }>(item: Item) => describeAll([item, item])
describeTwice(Cat { name = "Tom" })
-- prints: I am Tom
-- prints: I am Tom
function repeatText = <times: Integer<min = 0>>(text: String): String => {
	mutable result = ""
	for 0..times {
		result += text
	}
	result
}
let triple = repeatText<3>
console.log(repeatText<2>("ab"), triple("x"))
-- prints: abab xxx
