-- `local = place` copies the place: the local's array may be reused, but
-- never where a loop iterates it or a function reads it.
function rotate = (source: Array<Integer>, times: Integer): Array<Integer> => {
	mutable current = copy source
	mutable longer = [0, 0, 0, 0]
	mutable seen: Array<Integer> = []
	for 0..times {
		current = copy source
		longer = copy source
		seen.push(current.length + longer.length)
	}
	mutable shared = copy source
	shared = copy longer
	shared.push(9)
	console.log(source, current, longer, shared, seen)
	current
}
let numbers = [1, 2, 3]
let rotated = rotate(numbers, 2)
console.log(rotated, numbers)
-- prints: [1, 2, 3] [1, 2, 3] [1, 2, 3] [1, 2, 3, 9] [6, 6]
-- prints: [1, 2, 3] [1, 2, 3]

-- Replacing the collection a loop iterates over is REF012 (a compile error), so it isn't tested here.

function captured = (first: Array<Integer>, second: Array<Integer>) => {
	mutable current = copy first
	function read = (): Integer => current.length
	current = copy second
	console.log(read(), current)
}
captured([1], [5, 6])
-- prints: 2 [5, 6]
