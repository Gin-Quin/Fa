-- Storage hints leave contents unchanged on every target.
mutable text = String.from("hello", capacity = 100)
text.reserve(200)
text += "!"
assert text.capacity >= text.length
console.log(text) -- prints: hello!
mutable array = Array<Integer>.from([1, 2], capacity = 10)
array.reserve(40)
array.push(3)
assert array.capacity >= array.length
console.log(array) -- prints: [1, 2, 3]
mutable growing = GrowingArray<Integer>.from([10, 20], capacity = 128)
use first = try growing[0]
growing.reserve(1000)
for i in 0..2000 {
    growing.push(i)
}
assert growing.capacity >= growing.length
console.log(first, try growing[129], growing.length) -- prints: 10 127 2002
let copied = growing
assert try copied[130] == 128
growing = []
growing.push(7)
console.log(growing) -- prints: [7]
mutable set = Set.from([1, 2], capacity = 200)
set.reserve(300)
set.add(3)
assert set.capacity >= set.size
console.log(set.size) -- prints: 3
mutable growingSet = GrowingSet.from([1, 2], capacity = 200)
let member = growingSet.find((value) => value == 1)
growingSet.reserve(500)
growingSet.add(3)
console.log(member ?? 0, growingSet.size) -- prints: 1 3
mutable map = Map.from([(1, "one")], capacity = 80)
use entry = map.getOrInsert(1, "unused")
map.reserve(200)
map[2] = "two"
console.log(entry, map.size) -- prints: one 2
mutable growingMap = GrowingMap.from([(1, "one")], capacity = 80)
growingMap.reserve(200)
growingMap[2] = "two"
console.log(growingMap.size) -- prints: 2
type Point = { x: Integer, label: String }
mutable pool = Pool<Point>.from([{ x = 1, label = "a" }], capacity = 100)
use point = pool.add({ x = 2, label = "b" })
pool.reserve(2000)
point.x += 1
assert pool.capacity >= pool.size
console.log(point.x, pool.size) -- prints: 3 2
mutable growingPool = GrowingPool<Point>.from([{ x = 1, label = "a" }], capacity = 100)
use kept = growingPool.add({ x = 2, label = "b" })
growingPool.reserve(2000)
console.log(kept.x, growingPool.size) -- prints: 2 2
mutable columns = Columnar<Point>.from([{ x = 1, label = "a" }], capacity = 100)
use columnPoint = columns.add({ x = 2, label = "b" })
columns.reserve(2000)
columnPoint.x += 2
console.log(columnPoint.x, columns.size) -- prints: 4 2
mutable growingColumns = GrowingColumnar<Point>.from([{ x = 1, label = "a" }], capacity = 100)
growingColumns.reserve(2000)
console.log(growingColumns.size) -- prints: 1
mutable ordered = OrderedColumnar<Point>.from([{ x = 1, label = "a" }], capacity = 100)
ordered.reserve(2000)
ordered.add({ x = 2, label = "b" })
console.log(ordered.length) -- prints: 2
-- Hint expressions must run, even when the backend ignores storage hints.
function hint = (): Integer<min = 0> => {
	console.log("hint")
	30
}
let hinted = Array.from([1], capacity = hint()) -- prints: hint
assert hinted.length == 1

-- The Boolean fill optimization must evaluate the hint before its loop bound.
function fillFlags = (): Integer throws IndexError => {
    mutable flags = Array<Boolean>.from([], capacity = hint())
    for 0..4 { flags.push(true) }
    assert try flags[0]
    flags.length
}
console.log(try fillFlags()) -- prints: hint
-- prints: 4
