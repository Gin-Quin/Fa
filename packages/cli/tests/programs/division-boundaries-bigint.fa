]
function boundaryDivisors = (): Array<BigInt> => [
	1n
	2n
	7n
	16n
	170141183460469231731687303715884105727n
	-1n
	-2n
	-7n
	-170141183460469231731687303715884105728n
]
function dynamic = (value: BigInt, divisor: BigInt): (BigInt, BigInt) throws DivisionByZero =>
	((try value // divisor), (try value %% divisor))
function literals = (
	value: BigInt
): (BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt, BigInt) =>
	(value // 1n, value %% 1n, value // 2n, value %% 2n, value // 7n, value %% 7n, value
		// 16n, value %% 16n, value %% -1n, value // -2n, value %% -2n, value // -7n, value %% -7n)
function wide = (value: BigInt): (BigInt, BigInt) => (value // 65537n, value %% 65537n)
function rows = (): String throws DivisionByZero => {
	mutable output = ""
	for value in boundaryValues() {
		for divisor in boundaryDivisors() {
			let (quotient, rest) = try dynamic(value, divisor)
			output += "{quotient},{rest};"
		}
	}
	output
}
function literalRows = (): String => {
	mutable output = ""
	for value in boundaryValues() {
		let actual = literals(value)
		output += "{actual[0]},{actual[1]},{actual[2]},{actual[3]},{actual[4]},{actual[5]},{actual[6]},{actual[7]},{actual[8]},{actual[9]},{actual[10]},{actual[11]},{actual[12]};"
	}
	output
}
function wideRows = (): String => {
	mutable output = ""
	for value in boundaryValues() {
		let (quotient, rest) = wide(value)
		output += "{quotient},{rest};"
	}
	output
}
static expected = @rows()
static literalExpected = @literalRows()
static wideExpected = @wideRows()
assert (try rows()) == expected
assert literalRows() == literalExpected
assert wideRows() == wideExpected
function zeroDivision = (value: BigInt, divisor: BigInt): Boolean => {
	let _result = value // divisor catch _error => return true
	false
}
static zeroDivisionExpected = @zeroDivision(1n, 0n)
assert zeroDivisionExpected
assert zeroDivision(1n, 0n)
function zeroRemainder = (value: BigInt, divisor: BigInt): Boolean => {
	let _result = value %% divisor catch _error => return true
	false
}
static zeroRemainderExpected = @zeroRemainder(1n, 0n)
assert zeroRemainderExpected
assert zeroRemainder(1n, 0n)
console.log("division BigInt ok") -- prints: division BigInt ok
