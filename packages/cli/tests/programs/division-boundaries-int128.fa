]
static divisors: Array<Int128> = [
	1
	2
	7
	16
	170141183460469231731687303715884105727
	-1
	-2
	-7
	-170141183460469231731687303715884105728
]
function dynamic = (value: Int128, divisor: Int128): (Int128, Int128) throws DivisionByZero =>
	((try value // divisor), (try value %% divisor))
function literals = (
	value: Int128
): (Int128, Int128, Int128, Int128, Int128, Int128, Int128, Int128) =>
	(value // 1, value %% 1, value // 2, value %% 2, value // 7, value %% 7, value // 16, value
		%% 16)
function wide = (value: Int128): (Int128, Int128) => {
	let quotient: Int128 = value // 65537
	let rest: Int128 = value %% 65537
	(quotient, rest)
}
function rows = (): Array<(Int128, Int128)> throws DivisionByZero => {
	mutable output: Array<(Int128, Int128)> = []
	for value in inputs {
		for divisor in divisors {
			if value == Int128.minValue and divisor == -1 {
				assert value %% divisor == 0
				continue
			}
			output.push(try dynamic(value, divisor))
		}
	}
	output
}
static expected: Array<(Int128, Int128)> = @rows()
function literalRows = (): Array<(Int128, Int128, Int128, Int128, Int128, Int128, Int128, Int128)> =>
	inputs.map(literals)
static literalExpected: Array<(Int128, Int128, Int128, Int128, Int128, Int128, Int128, Int128)> = @literalRows()
function wideRows = (): Array<(Int128, Int128)> => inputs.map(wide)
static wideExpected: Array<(Int128, Int128)> = @wideRows()
assert (try rows()) == expected
assert inputs.map(literals) == literalExpected
assert inputs.map(wide) == wideExpected
function zeroDivision = (value: Int128, divisor: Int128): Boolean => {
	let _result = value // divisor catch _error => return true
	false
}
static zeroDivisionExpected = @zeroDivision(1, 0)
assert zeroDivisionExpected
assert zeroDivision(1, 0)
function zeroRemainder = (value: Int128, divisor: Int128): Boolean => {
	let _result = value %% divisor catch _error => return true
	false
}
static zeroRemainderExpected = @zeroRemainder(1, 0)
assert zeroRemainderExpected
assert zeroRemainder(1, 0)
console.log("division Int128 ok") -- prints: division Int128 ok
