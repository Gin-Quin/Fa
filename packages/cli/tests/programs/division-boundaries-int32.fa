static divisors: Array<Int32> = [1, 2, 7, 16, 2147483647, -1, -2, -7, -2147483648]
function dynamic = (value: Int32, divisor: Int32): (Int32, Int32) throws DivisionByZero =>
	((try value // divisor), (try value %% divisor))
function literals = (value: Int32): (Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32) =>
	(value // 1, value %% 1, value // 2, value %% 2, value // 7, value %% 7, value // 16, value
		%% 16)
function wide = (value: Int32): (Int128, Int128) => {
	let quotient: Int128 = value // 65537
	let rest: Int128 = value %% 65537
	(quotient, rest)
}
function rows = (): Array<(Int32, Int32)> throws DivisionByZero => {
	mutable output: Array<(Int32, Int32)> = []
	for value in inputs {
		for divisor in divisors {
			if value == Int32.minValue and divisor == -1 {
				assert value %% divisor == 0
				continue
			}
			output.push(try dynamic(value, divisor))
		}
	}
	output
}
static expected: Array<(Int32, Int32)> = @rows()
function literalRows = (): Array<(Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32)> =>
	inputs.map(literals)
static literalExpected: Array<(Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32)> = @literalRows()
function wideRows = (): Array<(Int128, Int128)> => inputs.map(wide)
static wideExpected: Array<(Int128, Int128)> = @wideRows()
assert (try rows()) == expected
assert inputs.map(literals) == literalExpected
assert inputs.map(wide) == wideExpected
function zeroDivision = (value: Int32, divisor: Int32): Boolean => {
	let _result = value // divisor catch _error => return true
	false
}
static zeroDivisionExpected = @zeroDivision(1, 0)
assert zeroDivisionExpected
assert zeroDivision(1, 0)
function zeroRemainder = (value: Int32, divisor: Int32): Boolean => {
	let _result = value %% divisor catch _error => return true
	false
}
static zeroRemainderExpected = @zeroRemainder(1, 0)
assert zeroRemainderExpected
assert zeroRemainder(1, 0)
console.log("division Int32 ok") -- prints: division Int32 ok
