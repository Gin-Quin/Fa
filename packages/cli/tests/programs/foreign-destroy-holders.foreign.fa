-- skip-target: wasm native-freestanding
-- an object holding a value with `destroy` is move-only, like one holding a
-- task: parameters borrow it, a field moved out is destroyed by its new
-- owner, and the holder's drop skips it
function allocate: (size: Int64) => Pointer<Int32> = @extern("malloc")
function release: (block: Pointer<Int32>) => Void = @extern("free")

type Buffer = {
	block: Pointer<Int32>
	name: String
	function make = (name: String): Self => Self { block = allocate(4), name = name }
	function destroy = (self) => {
		console.log("destroyed {self.name}")
		release(self.block)
	}
}

type Holder = { label: String, buffer: Buffer }

function consume = (holder: Holder) => {
	console.log("consumed {holder.label}")
}

do {
	let first = Holder { label = "first", buffer = Buffer.make("a") }
	consume(first) -- prints: consumed first
	let second = Holder { label = "second", buffer = Buffer.make("b") }
	let buffer = second.buffer
	console.log(buffer.name) -- prints: b
	mutable third = Holder { label = "third", buffer = Buffer.make("c") }
	let moved = third.buffer
	third.buffer = Buffer.make("d")
	console.log(moved.name, third.label) -- prints: c third
} -- prints: destroyed c
-- prints: destroyed d
-- prints: destroyed b
-- prints: destroyed a
console.log("end") -- prints: end
