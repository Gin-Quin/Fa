type Resource = {
	name: String
	function destroy = (self) => { console.log("drop {self.name}") }
}
function clear = <Item, capacity: UInt32>(values: InlineArray<Item, capacity>) mutates values => {
	values.clear()
}
mutable values: InlineArray<Resource, 1> = [Resource { name = "one" }]
clear<Resource, 1>(values)
-- prints: drop one
