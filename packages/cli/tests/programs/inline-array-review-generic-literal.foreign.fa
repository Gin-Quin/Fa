type Resource = {
	name: String
	function destroy = (self) => { console.log("drop {self.name}") }
}
type Failure = Errors { No }
function fail = (): Resource throws Failure => { throw Failure.No }
function pair = <Item, capacity: Integer<min = 2, max = 4>>(
	first: Item
	next: () => Item throws Failure
): InlineArray<Item, capacity> throws Failure => [first, try next()]
pair<Resource, 2>(Resource { name = "prefix" }, fail) catch _error => console.log("failed")
-- prints: drop prefix
-- prints: failed
