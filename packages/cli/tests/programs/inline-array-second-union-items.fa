-- Fictitious tuple metadata was removed: exercise real inline union items.
type Value = Union {
	None
	Packed = { flag: Boolean, count: Int16, small: Int8 }
	Word = String
}
function mutate = (items: InlineArray<Value, 2>) mutates items[..] => {
	for item in items {
		if item is Value.Packed {
			item.flag = false
			item.count += 1
		}
	}
}
function build = (): InlineArray<Value, 2> => {
	mutable items: InlineArray<Value, 2> = [Value.Packed { flag = true, count = 2, small = 3 }]
	mutate(items)
	items
}
console.log(build()) -- prints: [Value.Packed { count = 3, flag = false, small = 3 }]
