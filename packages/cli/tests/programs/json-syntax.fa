-- skip-target: native-freestanding
-- Syntax diagnostics are Fa's, on every engine and for String or Bytes.
use { Json } = std.json
function message = (text: String | Bytes): String => {
	let _value: Integer = Json.parse(text) catch error => {
		return error.message
	}
	"unexpected success"
}
function attempt = (text: String | Bytes) => {
	console.log(message(text))
}
attempt("")
static result0 = message("")
console.log(result0)
-- prints: JSON Parse error: Unexpected EOF
-- prints: JSON Parse error: Unexpected EOF
attempt("".toUtf8())
static result1 = message("".toUtf8())
console.log(result1)
-- prints: JSON Parse error: Unexpected EOF
-- prints: JSON Parse error: Unexpected EOF
attempt("{{")
static result2 = message("{{")
console.log(result2)
-- prints: JSON Parse error: Expected '}'
-- prints: JSON Parse error: Expected '}'
