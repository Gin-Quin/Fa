-- Native's 1000-container boundary also applies to successful parsing.
-- The extra field is ignored by conversion, after syntax validation.
function depthMessage = (text: String | Bytes): String => {
	let _value: { marker: Integer? } = Json.parse(text) catch error => { return error.message }
	"ok"
}
static deep999Text = depthMessage("{{\"data\":" + "[".repeat(999) + "0" + "]".repeat(999) + "}}")
console.log(deep999Text)                                                                  -- prints: ok
console.log(depthMessage("{{\"data\":" + "[".repeat(999) + "0" + "]".repeat(999) + "}}")) -- prints: ok
static deep999Bytes = depthMessage(
	("{{\"data\":" + "[".repeat(999) + "0" + "]".repeat(999) + "}}").toUtf8()
)
console.log(deep999Bytes) -- prints: ok
console.log(
	depthMessage(("{{\"data\":" + "[".repeat(999) + "0" + "]".repeat(999) + "}}").toUtf8())
) -- prints: ok
static deep1000Text = depthMessage("{{\"data\":" + "[".repeat(1000) + "0" + "]".repeat(1000) + "}}")
console.log(deep1000Text)                                                                   -- prints: JSON Parse error: Exceeded the maximum depth
console.log(depthMessage("{{\"data\":" + "[".repeat(1000) + "0" + "]".repeat(1000) + "}}")) -- prints: JSON Parse error: Exceeded the maximum depth
static deep1000Bytes = depthMessage(
	("{{\"data\":" + "[".repeat(1000) + "0" + "]".repeat(1000) + "}}").toUtf8()
)
console.log(deep1000Bytes) -- prints: JSON Parse error: Exceeded the maximum depth
console.log(
	depthMessage(("{{\"data\":" + "[".repeat(1000) + "0" + "]".repeat(1000) + "}}").toUtf8())
) -- prints: JSON Parse error: Exceeded the maximum depth
static deep1001Text = depthMessage("{{\"data\":" + "[".repeat(1001) + "0" + "]".repeat(1001) + "}}")
console.log(deep1001Text)                                                                   -- prints: JSON Parse error: Exceeded the maximum depth
console.log(depthMessage("{{\"data\":" + "[".repeat(1001) + "0" + "]".repeat(1001) + "}}")) -- prints: JSON Parse error: Exceeded the maximum depth
static deep1001Bytes = depthMessage(
	("{{\"data\":" + "[".repeat(1001) + "0" + "]".repeat(1001) + "}}").toUtf8()
)
console.log(deep1001Bytes) -- prints: JSON Parse error: Exceeded the maximum depth
console.log(
	depthMessage(("{{\"data\":" + "[".repeat(1001) + "0" + "]".repeat(1001) + "}}").toUtf8())
) -- prints: JSON Parse error: Exceeded the maximum depth

-- Remaining UTF-8 prefix/continuation widths and line-independent diagnostics.
attempt(Bytes.from([194])) -- prints: invalid UTF-8 in JSON input
static utf8Extra0 = message(Bytes.from([194]))
console.log(utf8Extra0)              -- prints: invalid UTF-8 in JSON input
attempt(Bytes.from([240, 159, 146])) -- prints: invalid UTF-8 in JSON input
static utf8Extra1 = message(Bytes.from([240, 159, 146]))
console.log(utf8Extra1)             -- prints: invalid UTF-8 in JSON input
attempt(Bytes.from([226, 40, 161])) -- prints: invalid UTF-8 in JSON input
static utf8Extra2 = message(Bytes.from([226, 40, 161]))
console.log(utf8Extra2)                   -- prints: invalid UTF-8 in JSON input
attempt(Bytes.from([240, 128, 128, 128])) -- prints: invalid UTF-8 in JSON input
static utf8Extra3 = message(Bytes.from([240, 128, 128, 128]))
console.log(utf8Extra3)                   -- prints: invalid UTF-8 in JSON input
attempt(Bytes.from([245, 128, 128, 128])) -- prints: invalid UTF-8 in JSON input
static utf8Extra4 = message(Bytes.from([245, 128, 128, 128]))
console.log(utf8Extra4)        -- prints: invalid UTF-8 in JSON input
attempt(Bytes.from([194, 32])) -- prints: invalid UTF-8 in JSON input
static utf8Extra5 = message(Bytes.from([194, 32]))
console.log(utf8Extra5)         -- prints: invalid UTF-8 in JSON input
attempt(Bytes.from([224, 160])) -- prints: invalid UTF-8 in JSON input
static utf8Extra6 = message(Bytes.from([224, 160]))
console.log(utf8Extra6) -- prints: invalid UTF-8 in JSON input
attempt("\n[1,]")       -- prints: JSON Parse error: Unexpected comma at the end of array expression
static multiline = message("\n[1,]")
console.log(multiline) -- prints: JSON Parse error: Unexpected comma at the end of array expression

-- Diagnostic text preserves complete scalars and lone UTF-16 units.
function quotedMessage = (text: String | Bytes): String =>
	"quoted: " + Json.stringify(message(text))
static high = "\u{10000}"[0]
static low = "\u{10000}"[1]
static invalidEscapeScalarText0 = quotedMessage("\"\\é\"")
console.log(invalidEscapeScalarText0) -- prints: quoted: "JSON Parse error: Invalid escape character é"
console.log(quotedMessage("\"\\é\"")) -- prints: quoted: "JSON Parse error: Invalid escape character é"
static invalidEscapeScalarBytes0 = quotedMessage(("\"\\é\"").toUtf8())
console.log(invalidEscapeScalarBytes0)           -- prints: quoted: "JSON Parse error: Invalid escape character é"
console.log(quotedMessage(("\"\\é\"").toUtf8())) -- prints: quoted: "JSON Parse error: Invalid escape character é"
static invalidEscapeScalarText1 = quotedMessage("\"\\😀\"")
console.log(invalidEscapeScalarText1) -- prints: quoted: "JSON Parse error: Invalid escape character 😀"
console.log(quotedMessage("\"\\😀\"")) -- prints: quoted: "JSON Parse error: Invalid escape character 😀"
static invalidEscapeScalarBytes1 = quotedMessage(("\"\\😀\"").toUtf8())
console.log(invalidEscapeScalarBytes1)           -- prints: quoted: "JSON Parse error: Invalid escape character 😀"
console.log(quotedMessage(("\"\\😀\"").toUtf8())) -- prints: quoted: "JSON Parse error: Invalid escape character 😀"
static errorUnit0 = quotedMessage(high)
console.log(errorUnit0)          -- prints: quoted: "JSON Parse error: Unrecognized token '\ud800'"
console.log(quotedMessage(high)) -- prints: quoted: "JSON Parse error: Unrecognized token '\ud800'"
static errorUnit1 = quotedMessage(low)
console.log(errorUnit1)         -- prints: quoted: "JSON Parse error: Unrecognized token '\udc00'"
console.log(quotedMessage(low)) -- prints: quoted: "JSON Parse error: Unrecognized token '\udc00'"
static errorUnit2 = quotedMessage("\"\\" + high + "\"")
console.log(errorUnit2)                          -- prints: quoted: "JSON Parse error: Invalid escape character \ud800"
console.log(quotedMessage("\"\\" + high + "\"")) -- prints: quoted: "JSON Parse error: Invalid escape character \ud800"
static errorUnit3 = quotedMessage("\"\\" + low + "\"")
console.log(errorUnit3)                         -- prints: quoted: "JSON Parse error: Invalid escape character \udc00"
console.log(quotedMessage("\"\\" + low + "\"")) -- prints: quoted: "JSON Parse error: Invalid escape character \udc00"
static errorUnit4 = quotedMessage("[" + high)
console.log(errorUnit4)                -- prints: quoted: "JSON Parse error: Unrecognized token '\ud800'"
console.log(quotedMessage("[" + high)) -- prints: quoted: "JSON Parse error: Unrecognized token '\ud800'"
static errorUnit5 = quotedMessage("{{" + high)
console.log(errorUnit5)                 -- prints: quoted: "JSON Parse error: Expected '}'"
console.log(quotedMessage("{{" + high)) -- prints: quoted: "JSON Parse error: Expected '}'"
static errorUnit6 = quotedMessage("null " + high)
console.log(errorUnit6)                    -- prints: quoted: "JSON Parse error: Unable to parse JSON string"
console.log(quotedMessage("null " + high)) -- prints: quoted: "JSON Parse error: Unable to parse JSON string"
static errorUnit7 = quotedMessage("\"\\q" + high)
console.log(errorUnit7)                    -- prints: quoted: "JSON Parse error: Unterminated string"
console.log(quotedMessage("\"\\q" + high)) -- prints: quoted: "JSON Parse error: Unterminated string"

-- Obtain lone units through a runtime call as well as a static constant.
function inputUnit = (text: String, index: Integer): String throws IndexError => try text[index]
static dynamicUnitError0 = quotedMessage(inputUnit("\u{10000}", 0))
console.log(dynamicUnitError0)                            -- prints: quoted: "JSON Parse error: Unrecognized token '\ud800'"
console.log(quotedMessage(try inputUnit("\u{10000}", 0))) -- prints: quoted: "JSON Parse error: Unrecognized token '\ud800'"
static dynamicUnitError1 = quotedMessage(inputUnit("\u{10000}", 1))
console.log(dynamicUnitError1)                            -- prints: quoted: "JSON Parse error: Unrecognized token '\udc00'"
console.log(quotedMessage(try inputUnit("\u{10000}", 1))) -- prints: quoted: "JSON Parse error: Unrecognized token '\udc00'"
static dynamicUnitError2 = quotedMessage("\"\\" + (inputUnit("\u{10000}", 0)) + "\"")
console.log(dynamicUnitError2)                                              -- prints: quoted: "JSON Parse error: Invalid escape character \ud800"
console.log(quotedMessage("\"\\" + (try inputUnit("\u{10000}", 0)) + "\"")) -- prints: quoted: "JSON Parse error: Invalid escape character \ud800"
static dynamicUnitError3 = quotedMessage("\"\\" + (inputUnit("\u{10000}", 1)) + "\"")
console.log(dynamicUnitError3)                                              -- prints: quoted: "JSON Parse error: Invalid escape character \udc00"
console.log(quotedMessage("\"\\" + (try inputUnit("\u{10000}", 1)) + "\"")) -- prints: quoted: "JSON Parse error: Invalid escape character \udc00"
