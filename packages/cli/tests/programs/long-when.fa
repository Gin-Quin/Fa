-- A `when` of at least 64 arms is written flat on JavaScript: a `switch` when
-- every pattern is a constant, a labeled block of `if`s otherwise (a range,
-- a `break` in an arm, which must leave the loop and not the `switch`).
type Level = Enum { level0, level1, level2, level3, level4, level5, level6, level7, level8, level9, level10, level11, level12, level13, level14, level15, level16, level17, level18, level19, level20, level21, level22, level23, level24, level25, level26, level27, level28, level29, level30, level31, level32, level33, level34, level35, level36, level37, level38, level39, level40, level41, level42, level43, level44, level45, level46, level47, level48, level49, level50, level51, level52, level53, level54, level55, level56, level57, level58, level59, level60, level61, level62, level63, level64, level65, level66, level67, level68, level69 }

function code = (n: Integer): String => when n is {
	0 => "c0"
	1 => "c1"
	2 => "c2"
	3 => "c3"
