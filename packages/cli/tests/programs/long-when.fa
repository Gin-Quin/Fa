	33 => "c33"
	34 => "c34"
	35 => "c35"
	36 => "c36"
	37 => "c37"
	38 => "c38"
	39 => "c39"
	40 => "c40"
	41 => "c41"
	42 => "c42"
	43 => "c43"
	44 => "c44"
	45 => "c45"
	46 => "c46"
	47 => "c47"
	48 => "c48"
	49 => "c49"
	50 => "c50"
	51 => "c51"
	52 => "c52"
	53 => "c53"
	54 => "c54"
	55 => "c55"
	56 => "c56"
	57 => "c57"
	58 => "c58"
	59 => "c59"
	60 => "c60"
	61 => "c61"
	62 => "c62"
	63 => "c63"
	64 => "c64"
	65 => "c65"
	66 => "c66"
	67 => "c67"
	68 => "c68"
	69 => "c69"
	else => "other"
}
console.log(code(0), code(42), code(69), code(70)) -- prints: c0 c42 c69 other

