-- The variable of a `for` loop over a mutable array writes its items (T-LOOP-4, T-LOOP-5).
mutable scores = [1, 2, 3]
for score in scores {
	score += 1
}
console.log(scores)
-- prints: [2, 3, 4]
mutable players = [{ name = "John", score = 10 }, { name = "Jane", score = 12 }]
for player in players {
	player.score += 1
}
console.log(players[0].score, players[1].score)
-- prints: 11 13
