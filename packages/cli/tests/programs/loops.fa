-- `for` over ranges, `while`, `loop` with `break` values, `continue`.
for count in 0..3 {
	console.log("Count: {count}")
}
-- prints: Count: 0
-- prints: Count: 1
-- prints: Count: 2
mutable total = 0
for i in 1..=4 {
	total += i
}
console.log(total)
-- prints: 10
mutable times = 0
for 0..5 {
	times += 1
}
console.log(times)
-- prints: 5
mutable remaining = 3
while remaining > 0 {
	console.log(remaining)
	remaining -= 1
}
-- prints: 3
-- prints: 2
-- prints: 1
let target = 50
mutable candidate = 1
let root = loop {
	if candidate * candidate >= target {
		break candidate
	}
	candidate += 1
}
console.log(root)
-- prints: 8
for i in 0..6 {
	if i %% 2 == 0 {
		continue
	}
	if i > 4 {
		break
	}
	console.log("odd {i}")
}
-- prints: odd 1
-- prints: odd 3
mutable i = 0
loop {
	i += 1
	if i == 3 {
		break
	}
}
console.log(i)
-- prints: 3
let x = 5
for x in 0..2 {
	console.log(x)
}
console.log(x)
-- prints: 0
-- prints: 1
-- prints: 5
