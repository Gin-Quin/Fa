-- A successful lookup can supply a following update/removal, not stale shifted slots.
-- asynchronous: false
-- require-split: true

function append = (items: Array<UInt32>, value: UInt32) mutates items => { items.push(value) }
function change = (map: Map<UInt32, UInt32>, key: UInt32) mutates map => {
	map.clear()
	map[3] = 33
	map[key] = 77
	map.reserve(128)
}

function sameKey = (input: UInt32) => {
	let key = input
	mutable map = Map<UInt32, UInt32>.from([(key, 10)], capacity = 16)
	mutable scratch: Array<UInt32> = []
	let found = map.get(key)
	assert found == 10
	append(scratch, key)
	map[key] = 20
	assert map.get(key) == 20
	assert map.take(key) == 20
	assert map.get(key) is none
	assert not map.delete(key)
	map[key] = 30
	assert map.get(key) == 30
	assert map.delete(key)
	assert map.get(key) is none
}

function shiftedSlot = () => {
	-- These keys collide at slot 31 of this table and wrap through slot zero.
	mutable map = Map<UInt32, UInt32>.from([(1, 10), (46, 20), (91, 30)], capacity = 16)
	let key: UInt32 = 91
	assert map.get(key) == 30
	assert map.delete(1)
	map[key] = 31
	assert map.get(key) == 31
	assert map.get(46) == 20
	assert map.size == 2
	assert map.take(key) == 31
	assert map.get(key) is none
	map[key] = 32
	assert map.get(key) == 32
}

function invalidated = () => {
	mutable map: Map<UInt32, UInt32> = [(1, 10)]
	let key: UInt32 = 1
	assert map.get(key) == 10
	change(map, key)
	map[key] = 78
	assert map.get(key) == 78
	map.reserve(128)
	assert map.get(key) == 78
	map.clear()
	assert map.get(key) is none
	map[key] = 79
	assert map.get(key) == 79
	map = [(1, 80)]
	assert map.get(key) == 80
}

function changedKey = () => {
	mutable map: Map<UInt32, UInt32> = [(1, 10), (2, 20)]
	mutable key: UInt32 = 1
	assert map.get(key) == 10
	key = 2
	map[key] = 21
	assert map.get(key) == 21
	assert map.get(1) == 10
}

sameKey(0)
sameKey(7)
sameKey(UInt32.maxValue)
shiftedSlot()
invalidated()
changedKey()
console.log("positive map probes") -- prints: positive map probes
