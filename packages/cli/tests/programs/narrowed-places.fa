-- A narrowed optional or union is a place: the payload of the value, never a
-- copy. Methods, fields, `+=` and `mutates` parameters change the original.
type Counter = {
	count: Integer
	function add = (self, amount: Integer) mutates self => {
		self.count += amount
	}
}
type Bag = { name: String, items: Array<Integer> }
type Shape = Union { Empty, Box = Counter }
function bump = (counter: Counter) mutates counter => {
	counter.count += 10
}
function append = (items: Array<Integer>, item: Integer) mutates items => items.push(item)

-- an optional array, local of the top level
mutable maybe: Array<Integer>? = []
if maybe is not none {
	maybe.push(4)
}
console.log(maybe) -- prints: [4]
if maybe is not none {
	append(maybe, 5)
}
console.log(maybe) -- prints: [4, 5]
if maybe is not none {
	maybe.sortInPlace((a, b) => b - a)
}
console.log(maybe) -- prints: [5, 4]

-- an optional object: a method, a field, a compound assignment, a parameter
mutable counter: Counter? = Counter { count = 1 }
if counter is not none {
	counter.add(2)
}
console.log(counter) -- prints: { count = 3 }
if counter is not none {
	counter.count = 20
}
console.log(counter) -- prints: { count = 20 }
if counter is not none {
	counter.count += 1
}
console.log(counter) -- prints: { count = 21 }
if counter is not none {
	bump(counter)
}
console.log(counter) -- prints: { count = 31 }

-- a field of a narrowed object
mutable bag: Bag? = Bag { name = "bag", items = [1] }
if bag is not none {
	bag.items.push(2)
	bag.name = "full"
}
console.log(bag) -- prints: { name = "full", items = [1, 2] }

-- narrowed by an early exit, and by `when`
function fill = (flag: Boolean) => {
	mutable local: Counter? = if flag { Counter { count = 1 } } else { none }
	if local is none {
		console.log("none")
		return
	}
	local.add(4)
	-- a call that mutates the payload keeps the narrowing
	bump(local)
	local.add(1)
	console.log(local)
}
fill(true) -- prints: { count = 16 }
fill(false) -- prints: none
mutable chosen: Array<Integer>? = [7]
when chosen is {
	none => {}
	else => chosen.push(8)
}
console.log(chosen) -- prints: [7, 8]

-- an optional integer and an optional string
mutable n: Integer? = 3
if n is not none {
	n += 1
}
console.log(n) -- prints: 4
mutable text: String? = "a"
if text is not none {
	text += "b"
}
console.log(text) -- prints: ab

-- a union narrowed by `is`, an optional union, a nested optional
mutable either: Counter | String = Counter { count = 1 }
if either is Counter {
	either.add(2)
}
console.log(either) -- prints: { count = 3 }
mutable shape: Shape? = Shape.Box { count = 1 }
if shape is Shape.Box {
	shape.count += 1
}
console.log(shape) -- prints: Shape.Box { count = 2 }
mutable nested: Counter?? = Counter { count = 1 }
if nested is not none {
	nested.add(1)
}
console.log(nested) -- prints: { count = 2 }

-- an optional tuple, and a value through `use`
mutable pair: (Integer, Counter)? = (1, Counter { count = 1 })
if pair is not none {
	pair[1].add(3)
}
console.log(pair) -- prints: (1, { count = 4 })
mutable box: Counter? = Counter { count = 0 }
if box is not none {
	use inside = box
	inside.add(5)
}
console.log(box) -- prints: { count = 5 }

-- a test repeated on a narrowed value, the place still written
mutable twice: Array<Integer>? = [1]
if twice is not none {
	if twice is not none {
		twice.push(2)
	}
	console.log(twice is none, twice != none) -- prints: false true
}
when twice is {
	none => console.log("none")
	else => twice.push(3)
}
console.log(twice) -- prints: [1, 2, 3]

-- the values of a map, through an optional reference
mutable scores: Map<String, Integer> = [("ana", 10)]
use score = scores.get("ana")
if score is not none {
	score += 1
}
console.log(scores) -- prints: [("ana", 11)]
mutable counters: Map<String, Counter> = [("a", Counter { count = 1 })]
use found = counters.get("a")
if found is not none {
	found.count += 1
	found.add(2)
	found.count *= 2
	found.add(1)
}
console.log(counters) -- prints: [("a", { count = 9 })]
mutable lists: Map<String, Array<Integer>?> = [("a", [1]), ("b", none)]
use list = lists.get("a")
if list is not none {
	list.push(2)
}
use empty = lists.get("b")
use missing = lists.get("z")
console.log(lists, empty, missing) -- prints: [("a", [1, 2]), ("b", none)] none none

-- the same places, locals of a function
function locals = () => {
	mutable items: Array<Integer>? = []
	if items is not none {
		items.push(1)
	}
	mutable one: Counter? = Counter { count = 1 }
	if one is not none {
		one.add(1)
	}
	if one is not none {
		one.count *= 10
	}
	mutable other: Counter | String = Counter { count = 5 }
	if other is Counter {
		bump(other)
	}
	mutable total: Integer? = 1
	if total is not none {
		total -= 3
	}
	mutable label: String? = "x"
	if label is not none {
		label += "y"
	}
	mutable pair: (Integer, Counter)? = (1, Counter { count = 1 })
	if pair is not none {
		pair[1].count += 1
	}
	console.log(items, one, other, total, label, pair)
}
locals() -- prints: [1] { count = 20 } { count = 15 } -2 xy (1, { count = 2 })

-- optional fields, narrowed by a test, an early exit or an assignment
type Holder = { name: String, items: Array<Integer>?, counter: Counter?, total: Integer? }
mutable holder = Holder { name = "h", items = [1], counter = none, total = 1 }
if holder.items is not none {
	holder.items.push(2)
	holder.items.push(3)
	console.log(holder.items.length) -- prints: 3
}
holder.counter = Counter { count = 1 }
holder.counter.add(4)
holder.counter.count *= 2
console.log(holder.counter) -- prints: { count = 10 }
if holder.total is not none {
	holder.total += 2
	holder.total -= 1
}
console.log(holder) -- prints: { name = "h", items = [1, 2, 3], counter = { count = 10 }, total = 2 }
function grow = (h: Holder) mutates h => {
	if h.items is none {
		h.items = []
	}
	h.items.push(h.items.length)
	if h.counter is not none and h.counter.count > 5 {
		h.counter.add(-5)
	}
}
grow(holder)
console.log(holder.items, holder.counter) -- prints: [1, 2, 3, 3] { count = 5 }
mutable maybeHolder: Holder? = Holder { name = "m", items = none, counter = none, total = none }
if maybeHolder is not none {
	grow(maybeHolder)
	grow(maybeHolder)
}
console.log(maybeHolder?.items) -- prints: [0, 1]

-- a value read from a collection into a `mutable` local is a copy
mutable byName: Map<String, Counter> = [("a", Counter { count = 1 })]
mutable row: Array<Counter> = [Counter { count = 1 }, Counter { count = 2 }]
mutable fromMap = byName.get("a")
if fromMap is not none {
	fromMap.count = 10
}
mutable fromList = row.get(0)
if fromList is not none {
	fromList.add(10)
}
mutable match = row.find((counter) => counter.count == 2)
if match is not none {
	match.count = 30
}
mutable kept = row.filter((counter) => counter.count > 0)
try kept[0].count = 40
mutable values = byName.values().toArray()
try values[0].count = 50
let before = row.get(1)
row[1].count = 60
console.log(byName, row) -- prints: [("a", { count = 1 })] [{ count = 1 }, { count = 60 }]
console.log(fromMap, fromList, match, kept, values, before) -- prints: { count = 10 } { count = 11 } { count = 30 } [{ count = 40 }, { count = 2 }] [{ count = 50 }] { count = 2 }
