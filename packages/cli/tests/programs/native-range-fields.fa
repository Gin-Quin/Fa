-- Range fields preserve value semantics, including absent bounds.
mutable r = 1..=4
let saved = r
r.start = none
r.end = none
console.log(r, r == change("z", none), r != .., saved)
-- prints: .. true true 1..=4
r.includesEnd = false
console.log(r == ..)
-- prints: true
r.start = -2
r.end = 3
console.log(r, r == -2..3, r == -2..4)
-- prints: -2..3 true false

function change = <Item>(item: Item, bound: Integer?): Range => {
	mutable box = { item = item, range = 1..5 }
	box.range.start = bound
	box.range.end = none
	box.range.includesEnd = true
	box.range
}
console.log(change("x", 2), change(3, none))
-- prints: 2.. ..
mutable ranges = [1..3, 4..6]
ranges[0].end = 8
console.log(ranges, [r] == [-2..3])
-- prints: [1..8, 4..6] true

async function later = (bound: Integer?): Range => {
	mutable r = 0..9
	await std.time.sleep(1)
	r.start = bound
	r.includesEnd = true
	r
}
console.log(await later(none))
-- prints: ..=9
