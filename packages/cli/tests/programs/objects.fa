-- Object types: literals in declaration order, defaults, fields, methods.
type Point = {
	x: Integer
	y: Integer = 0
	#secret: Integer = 2
	function sum = (self): Integer => self.x + self.y + self.#secret
	function origin = (): Point => Point { x = 0 }
	function moved = (self, dx: Integer): Point => Point { x = self.x + dx, y = self.y }
}

let a = Point { x = 1 }
console.log(a)
-- prints: { x = 1, y = 0 }
let b: Point = { y = 3, x = 2 }
console.log(b, b.x, b.y)
-- prints: { x = 2, y = 3 } 2 3
mutable c = Point.origin()
c.x = 4
c.y += 1
console.log(c, c.sum())
-- prints: { x = 4, y = 1 } 7
console.log(c.moved(10).sum())
-- prints: 17
let anonymous = { n = 1, s = "a" }
console.log(anonymous, "{anonymous.s}{anonymous.n}")
-- prints: { n = 1, s = "a" } a1
mutable settings = { port = 80, host = "localhost" }
settings .= { port = 8080, host = "example.com" }
console.log(settings)
-- prints: { port = 8080, host = "example.com" }
mutable swapped = { x = 1, y = 2 }
swapped .= { x = swapped.y, y = swapped.x }
console.log(swapped)
-- prints: { x = 2, y = 1 }
