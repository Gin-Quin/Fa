-- Absence skips the whole continuation, including lifted arguments.
type Offset = (Integer) => Integer
type Person = {
	name: String
	function greet = (self, suffix: String): String => self.name + suffix
	function maybe = (self, present: Boolean): String? => if present { self.name } else { none }
	function offset = (self): Offset => (value) => value + self.name.length
	async function delayed = (self, suffix: String): String => {
		await std.time.sleep(1)
		return self.name + suffix
	}
}
mutable visits = 0
mutable argumentsRun = 0
function person = (present: Boolean): Person? mutates visits => {
	visits += 1
	if present { Person { name = "Ada" } } else { none }
}
function greet = (present: Boolean): String? mutates visits, argumentsRun => person(present)?.greet(if present {
	argumentsRun += 1
	"!"
} else {
	argumentsRun += 100
	"?"
})
console.log(greet(false), visits, argumentsRun) -- prints: none 1 0
console.log(greet(true), visits, argumentsRun) -- prints: Ada! 2 1
function nested = (value: { child: Person }?): String? => value?.child.greet("!")
console.log(nested(none), nested({ child = Person { name = "Bo" } })) -- prints: none Bo!
function chained = (value: Person?, present: Boolean): String? => value?.maybe(present)?.trim()
console.log(chained(none, true), chained(Person { name = " Ada " }, false), chained(Person { name = " Ada " }, true)) -- prints: none none Ada
function factory = (value: Person?): Integer? => value?.offset()(2)
console.log(factory(none), factory(Person { name = "Ada" })) -- prints: none 5
function callback = (value: { apply: (Integer) => Integer }?): Integer? => value?.apply(3)
console.log(callback(none), callback({ apply = (value) => value + 1 })) -- prints: none 4

function text = (value: String?): String? => value?.trim().toUpperCase()
function number = (value: Integer?): String? => value?.toString()
function wide = (value: Int64?): String? => value?.abs().toString()
function byteLength = (value: Bytes?): Integer? => value?.length
function sum = (value: Set<Int64>?): Int64? => value?.sum()
type Color = Enum { red, blue }
function color = (value: Color?): String? => value?.toString()
console.log(text(none), text("  ada  "), text(""), number(none), number(0)) -- prints: none ADA  none 0
let wideValue: Int64 = -2
let values: Set<Int64> = [2, 3]
console.log(wide(none), wide(wideValue), sum(none), sum(values)) -- prints: none 2 none 5
console.log(byteLength(none), byteLength("".toUtf8()), color(none), color(Color.red)) -- prints: none 0 none red

async function delayed = (value: Person?): String? mutates argumentsRun => await value?.delayed(if value is not none {
	argumentsRun += 1
	"!"
} else { "?" })
console.log(await delayed(none), argumentsRun) -- prints: none 1
console.log(await delayed(Person { name = "Cy" }), argumentsRun) -- prints: Cy! 2
