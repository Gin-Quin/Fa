-- Optional starts produce an optional task; absent calls create no task.
type Box = {
	name: String
	async function describe = (self, suffix: String = "!"): String => self.name + suffix
	function length = (self): Integer => self.name.length
}
async function check = (box: Box?) => {
	let task: Task<String>? = start box?.describe()
	if task is none { console.log("none") }
	else { console.log(await task) }
	let size: Task<Integer>? = start box?.length()
	if size is not none { console.log(await size) }
	let text: String? = if box is not none { box.name } else { none }
	let trimmed: Task<String>? = start text?.trim()
	if trimmed is not none { console.log(await trimmed) }
	start box?.describe()
	let skipped = start box?.describe(if box is not none { "?" } else { console.log("bad argument"); "" })
	if skipped is not none { console.log(await skipped) }
}
await check(none) -- prints: none
await check(Box { name = "Ada" })
-- prints: Ada!
-- prints: 3
-- prints: Ada
-- prints: Ada?
