-- On JavaScript, an `Integer` is checked against ±(2^53 − 1) (T-NUM-46).
function inc = (x: Integer) => x + 1
console.log(inc(9_007_199_254_740_990))
-- prints: 9007199254740991
console.log(inc(9_007_199_254_740_991))
-- exit: 101
-- stderr: stop: integer overflow: 9007199254740992 doesn't fit in Integer
-- stderr: at
