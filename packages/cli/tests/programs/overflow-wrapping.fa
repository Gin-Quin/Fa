-- overflow-checks: false
-- Without overflow checks, sized integers of 32 bits or fewer wrap in two's
-- complement on every target (design/decisions.md, "Backends (after the
-- backend review)"): JavaScript wraps where native code truncates.
function addInt8 = (a: Int8, b: Int8): Int8 => a + b
console.log(addInt8(100, 100)) -- prints: -56
function addUInt8 = (a: UInt8, b: UInt8): UInt8 => a + b
console.log(addUInt8(200, 100)) -- prints: 44
function subUInt16 = (a: UInt16, b: UInt16): UInt16 => a - b
console.log(subUInt16(1, 2)) -- prints: 65535
function mulInt32 = (a: Int32, b: Int32): Int32 => a * b
console.log(mulInt32(123_456_789, 987_654_321)) -- prints: -67153019
function mulUInt32 = (a: UInt32, b: UInt32): UInt32 => a * b
console.log(mulUInt32(4_000_000_000, 3)) -- prints: 3410065408
function grow = (start: Int16): Int16 => {
	mutable value: Int16 = start
	value += 30_000
	value *= 2
	return value
}
console.log(grow(10_000)) -- prints: 14464
