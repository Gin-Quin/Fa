-- An awaited `async` function that only starts tasks is not a blocking call:
-- its tasks start later (`concurrency.md`). Called blocking, they run at
-- once. A detached task reads a module-level `mutable`, it doesn't copy it.
-- (backends review 2026-11-05, findings 9 and 10)
use { sleep } = std.time

mutable awaitedDone = false

async function run = (name: String) => {
	start do {
		console.log("{name} task starts")
		await Task.yield()
		console.log("{name} task ends")
		if name == "awaited" { awaitedDone = true }
	}
	console.log("{name} returns")
}

await run("awaited")
console.log("after awaited")
-- Wait for completion: Task.yield has no wall-clock completion deadline.
while not awaitedDone { await sleep(1) }
-- prints: awaited returns
-- prints: after awaited
-- prints: awaited task starts
-- prints: awaited task ends

run("blocking")
console.log("after blocking")
-- prints: blocking task starts
-- prints: blocking task ends
-- prints: blocking returns
-- prints: after blocking

mutable shared = 1
mutable sharedDone = false
start do {
	await sleep(5)
	console.log("shared", shared) -- prints: shared 2
	sharedDone = true
}
shared = 2
while not sharedDone { await sleep(1) }
console.log("end", shared) -- prints: end 2
