-- Tuples, ranges as values and slices, destructuring.
let pair = (1, "one")
let nested = [(1, 2.5), (2, 0.5)]
console.log(pair, nested, "{pair}", pair[1])
-- prints: (1, "one") [(1, 2.5), (2, 0.5)] (1, "one") one
mutable t = (1, 2)
let u = t
t[0] = 5
console.log(t, u, t == (5, 2), u != (1, 2))
-- prints: (5, 2) (1, 2) true false

function minMax = (values: Array(Integer)): Tuple(Integer, Integer) => {
	mutable low = values[0] catch error => 0
	mutable high = low
	for value in values {
		if value < low { low = value }
		if value > high { high = value }
	}
	(low, high)
}
let (low, high) = minMax([3, 9, 1])
console.log(low, high)
-- prints: 1 9

mutable r = 2..5
let copy = r
r.end = 8
console.log(r, copy, r.start, r.end, r.includesEnd, 4 is in r, 9 is in r)
-- prints: 2..8 2..5 2 8 false true false
let letters = ["a", "b", "c", "d", "e"]
let middle = 1..=3
console.log(letters[middle] catch error => [], letters[1..], "abcdef"[middle] catch error => "")
-- prints: ["b", "c", "d"] ["b", "c", "d", "e"] bcd
mutable sum = 0
for i in copy {
	sum += i
}
console.log(sum)
-- prints: 9

let person = { name = "Ana", age = 3, city = "Lyon" }
let { name, ...others } = person
console.log(name, others)
-- prints: Ana { age = 3, city = "Lyon" }
let points = [{ x = 1, y = 2 }, { x = 3, y = 4 }]
for { x, y as height } in points {
	console.log(x + height)
}
-- prints: 3
-- prints: 7
for (first, second), index in [(1, 2), (3, 4)] {
	console.log(index, first * second)
}
-- prints: 0 2
-- prints: 1 12

type Point = { x: Integer, y: Integer }
function length2 = ({ x, y }: Point): Integer => x * x + y * y
console.log(length2(Point { x = 3, y = 4 }))
-- prints: 25

let [head, ...tail] = [1, 2, 3]
mutable [a, b] = [10, 20]
a += b
console.log(head, tail, a, b)
-- prints: 1 [2, 3] 30 20
