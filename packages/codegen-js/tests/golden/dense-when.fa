-- Small dense integer matches become a switch; sparse matches keep their chains.
function dense = (value: Integer): Integer => when value is {
	-8 => 1
	-7 => 2
	-6 => 3
	-5 => 4
	-4 => 5
	-3 => 6
	-2 => 7
	-1 => 8
	0 => 9
	1 => 10
	2 => 11
	3 => 12
	4 => 13
	5 => 14
	6 => 15
	else => 16
}

function sparse = (value: Integer): Integer => when value is {
	0 => 1
	100 => 2
	200 => 3
	300 => 4
	400 => 5
	500 => 6
	600 => 7
	700 => 8
	800 => 9
	900 => 10
	1000 => 11
	1100 => 12
	1200 => 13
	1300 => 14
	1400 => 15
	else => 16
}
