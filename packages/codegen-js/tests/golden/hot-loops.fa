-- The shapes of hot loops: module constants, divisions of naturals, writes
-- through mutable locals, 32-bit operators.
let limit = 4.0

function inside = (x: Float) => x * x <= limit

function sieve = (size: Integer<min = 2, max = 1_000_000>): Integer => {
	mutable marks: Array<Boolean> = []
	for 0..size {
		marks.push(true)
	}
	mutable count = 0
	for i in 2..marks.length {
		if marks[i] {
			count += 1
			if i <= marks.length // i {
				mutable multiple = i * i
				while multiple < marks.length {
					marks[multiple] = false
					multiple += i
				}
			}
		}
	}
	count
}

function checksum = (values: Array<Integer<min = 0, max = 255>>): Integer => {
	let modulus = 1_000_000_007
	mutable sum = 0
	for value in values {
		sum = (sum * 31 + value) %% modulus
	}
	sum
}

function halves = (a: Integer<min = 0, max = 1000>, b: Integer<min = 1, max = 10>) => a // b

function mix = (a: UInt32, b: UInt32) => a.bitXor(b).wrappingMul(16_777_619)

console.log(inside(1.5), sieve(100), checksum([1, 2, 3]), halves(7, 2), mix(1, 2))
