-- A small C library (`farm.c`): structs by value, out-parameters, an
-- opaque resource released by `destroy`, a callback
use c = std.c

type Point = CStruct {
	x: Int32
	y: Float32
}

type Triple = CStruct {
	a: Float64
	b: Float64
	c: Float64
}

type Color = CStruct {
	rgba: CArray<UInt8, 4>
	weight: Float32
}

type RawFarm = CStruct { }

function colorSum: (color: Color) => Int32 = @extern("color_sum")
function makeColor: (value: UInt8) => Color = @extern("color_make")

function scale: (point: Point, factor: Int32) => Point = @extern("point_scale")
function sum: (triple: Triple) => Float64 = @extern("triple_sum")
function makeTriple: (value: Float64) => Triple = @extern("triple_make")
function increment: (counter: Pointer<Int64>, step: Int64) => Void mutates counter = @extern("counter_increment")
function openFarm: (name: CString) => Pointer<RawFarm> = @extern("farm_open")
function addAnimals: (farm: Pointer<RawFarm>, count: Int32) => Void = @extern("farm_add")
function animals: (farm: Pointer<RawFarm>) => Int32 = @extern("farm_animals")
function farmName: (farm: Pointer<RawFarm>) => CString = @extern("farm_name")
function closeFarm: (farm: Pointer<RawFarm>) => Void = @extern("farm_close")
function openCount: () => Int32 = @extern("farm_open_count")
function applyTwice: (callback: (value: Int64) => Int64, value: Int64) => Int64 = @extern("apply_twice")

type Farm = {
	#raw: Pointer<RawFarm>

	function open = (name: String): Farm => Farm { #raw = openFarm(name) }

	function add = (self, count: Int32) => {
		addAnimals(self.#raw, count)
	}

	function count = (self): Int32 => animals(self.#raw)

	function name = (self): String => farmName(self.#raw).toString()

	function destroy = (self) => {
		closeFarm(self.#raw)
	}
}

function triple = (value: Int64): Int64 => value * 3

function main = () => {
	let scaled = scale(Point { x = 2, y = 1.5 }, 3)
	console.log(scaled.x) -- prints: 6
	console.log(scaled.y) -- prints: 4.5
	console.log(sum(Triple { a = 1.0, b = 2.0, c = 3.5 })) -- prints: 6.5
	let made = makeTriple(2.0)
	console.log(made.c) -- prints: 6
	console.log(colorSum(Color { rgba = [1, 2, 3, 4], weight = 10.0 })) -- prints: 20
	let color = makeColor(7)
	console.log(color.rgba, color.weight) -- prints: [7, 8, 9, 10] 2.5
	mutable counter: Int64 = 40
	increment(counter, 2)
	console.log(counter) -- prints: 42
	console.log(applyTwice(triple, 5)) -- prints: 45
	do {
		let farm = Farm.open("Green Acres")
		farm.add(3)
		farm.add(4)
		console.log(farm.count()) -- prints: 7
		console.log(farm.name()) -- prints: Green Acres
		console.log(openCount()) -- prints: 1
	}
	console.log(openCount()) -- prints: 0
}

main()
