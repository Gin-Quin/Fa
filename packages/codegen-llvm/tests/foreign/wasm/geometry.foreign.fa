-- C compiled to WebAssembly (`geometry.c`), linked with the program, and a
-- function the host gives (`env.mjs`, next to the loader): structs by value
-- under wasm32's C ABI, a host import
type Point = CStruct {
	x: Int32
	y: Float32
}
type Triple = CStruct {
	a: Float64
	b: Float64
	c: Float64
}
type Color = CStruct {
	rgba: CArray<UInt8, 4>
	weight: Float32
}

function scale: (point: Point, factor: Int32) => Point = @extern("point_scale")
function sum: (triple: Triple) => Float64 = @extern("triple_sum")
function makeTriple: (value: Float64) => Triple = @extern("triple_make")
function colorSum: (color: Color) => Int32 = @extern("color_sum")
function twice: (value: Int32) => Int32 = @extern("host_twice")

let scaled = scale(Point { x = 2, y = 1.5 }, 3)
console.log(scaled.x, scaled.y) -- prints: 6 4.5
console.log(sum(makeTriple(2.0))) -- prints: 12
console.log(colorSum(Color { rgba = [1, 2, 3, 4], weight = 10.0 })) -- prints: 20
console.log(twice(21)) -- prints: 42
