-- Values leaving a root's region: fields and subtrees of temporary or dropped
-- roots, optional roots and leaves. `churn` reuses freed regions, so a dangling
-- edge would read another tree.
type Tree = {
	value: Integer
	left: Tree?
	right: Tree?

	function build = (depth: Integer): Tree => if depth > 0 {
		Tree { value = depth, left = Tree.build(depth - 1), right = Tree.build(depth - 1) }
	} else { Tree { value = 0 } }

	function count = (self): Integer => 1 + (self.left?.count() ?? 0) + (self.right?.count() ?? 0)
	function sum = (self): Integer => self.value + (self.left?.sum() ?? 0) + (self.right?.sum() ?? 0)
}

-- Allocates and frees whole regions, so a dangling edge would read reused memory.
function churn = (): Integer => {
	mutable total = 0
	for 0..4 { total += Tree.build(9).count() }
	total
}

-- A field read from a temporary root: the rest of the root is dropped.
let child = copy Tree.build(6).left
assert churn() == 4092
assert child?.count() == 63
assert child?.sum() == 57
let right = copy Tree.build(6).right?.left
assert churn() == 4092
assert right?.sum() == 26

-- Destructuring a temporary root.
let { left, value } = Tree.build(6)
assert churn() == 4092
assert left?.sum() == 57
assert value == 6
function children = (depth: Integer): Integer => {
	let { left, value } = Tree.build(depth)
	churn() + (left?.sum() ?? 0) + value
}
assert children(6) == 4092 + 57 + 6
function maybe = (depth: Integer): Tree? => if depth > 0 { Tree.build(depth) } else { none }
for depth in 0..6 {
	let tree = maybe(depth)
	assert churn() == 4092
	assert (tree?.count() ?? 0) == if depth > 0 { 2 ** (depth + 1) - 1 } else { 0 }
}
let leaf: Tree? = Tree.build(0)
let leafCopy = leaf
assert churn() == 4092
assert leafCopy?.count() == 1
-- A subtree copied out of a root, used after the root is dropped.
function subtree = (depth: Integer): Tree? => {
	let root = Tree.build(depth)
	copy root.left?.right
}
let kept = subtree(7)
assert churn() == 4092
assert kept?.count() == 63
console.log("arena escapes ok") -- prints: arena escapes ok
