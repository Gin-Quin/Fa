-- The same order on every target (design/decisions.md, the async
-- divergences): an `async` function that can't suspend is a blocking call,
-- so the tasks it starts run at once; a detached `start do` at the top
-- level copies the top-level values it uses.
async function report = (label: String) => {
	console.log(label)
}

-- it awaits nothing that suspends: one instance, a blocking call
async function starter = () => {
	start report("started")
	console.log("after the start")
}

await starter()
-- prints: started
-- prints: after the start

mutable count = 1
start do {
	count += 10
	console.log("task sees {count}")
}
count += 1
console.log("top level sees {count}")
-- prints: top level sees 2
-- prints: task sees 11
