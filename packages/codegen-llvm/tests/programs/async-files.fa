-- skip-target: native-freestanding
-- Files natively (design/async.md §5): `File.read`, `readBytes` and
-- `write` blocking (in place) and awaited (on the blocking pool, while the
-- other tasks run), their errors, cancelling a task waiting for a file,
-- and `monotonic`.
use { File, FileError } = std.fs
use { monotonic, sleep } = std.time

let path = "/tmp/fa-async-files-test.txt"
let started = monotonic()

-- blocking
File.writeText(path, "first line") catch error => console.log(error)
console.log(File.readText(path) catch error => "") -- prints: first line

-- awaited: another task runs while the pool works
async function ticker = () => {
	console.log("tick")
}
let tick = start ticker()
await File.writeText(path, "héllo") catch error => console.log(error)
-- prints: tick
await tick
console.log(await File.readText(path) catch error => "") -- prints: héllo
async function size = (): Integer => {
	let bytes = await File.read(path) catch error => return -1
	bytes.length
}
console.log(await size()) -- prints: 6

-- errors
async function describe = (path: String): String => {
	let text = await File.readText(path) catch error => return "{error}"
	text
}
console.log(await describe("/tmp/fa-no-such-directory/file")) -- prints: FileError { path = "/tmp/fa-no-such-directory/file", message = "No such file or directory" }
console.log(File.readText("/tmp") catch error => "{error}") -- prints: FileError { path = "/tmp", message = "Is a directory" }

-- many reads at once
mutable reads: Array<Task<String> throws FileError> = []
for index in 0..20 {
	reads.push(start File.readText(path))
}
let texts = await Task.all(reads) catch error => []
console.log(texts.length) -- prints: 20

-- a task waiting for a file is cancelled (the job's result is dropped)
let reading = start describe(path)
await sleep(0)
reading.cancel()
console.log("cancelled") -- prints: cancelled
console.log(monotonic() > started) -- prints: true
