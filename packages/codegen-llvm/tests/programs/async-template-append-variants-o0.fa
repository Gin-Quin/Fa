-- opt-level: 0
-- Branch-local decimal cleanup in started coroutine append paths.
use { sleep } = std.time
async function delayed = (value: Integer): Integer => {
	await sleep(1)
	value
}
async function build = (n: Integer, flag: Boolean): String => {
	mutable text = "t"
	text += "{n}"
	for index in 0..3 { text += "{index * n}" }
	await sleep(1)
	text += "{n}!"
	text += "x{n}y{await delayed(n + 1)}"
	text += n.toString()
	let part = "k{n}"
	text += part
	text += "{flag}"
	text
}
async function narrow = (n: Int32): String => {
	mutable text = "i"
	for _ in 0..2 {
		text += "{n}"
		await sleep(1)
	}
	text += "{n}{n}"
	text
}
type Shade = Enum { red, blue }
async function scalars = (flag: Boolean, byte: UInt8, shade: Shade): String => {
	mutable text = ""
	text += "{flag}"
	text += "{byte}"
	text += "{shade}"
	text
}
let first = start build(12, true)
console.log(await first) -- prints: t120122412!x12y1312k12true
let second = start narrow(-42)
console.log(await second) -- prints: i-42-42-42-42
let third = start scalars(true, 255, .blue)
console.log(await third) -- prints: true255blue

-- A decimal longer than wasm inline room must release its heap buffer.
let fourth = start build(123_456_789_012_345, false)
console.log(await fourth) -- prints: t1234567890123450123456789012345246913578024690123456789012345!x123456789012345y123456789012346123456789012345k123456789012345false
