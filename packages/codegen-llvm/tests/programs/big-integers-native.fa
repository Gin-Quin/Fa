let huge = 2n ** 70n
let items = [huge, -huge, 3n]
mutable sum = 0n
for value in items {
	sum += value
}
console.log(sum, items[0] == huge, items[1] < items[2])
console.log(try Int64(huge - 1n))
-- prints: 3 true true
-- exit: 1
