-- `BigInt` natively: multi-limb arithmetic, floor division and modulo,
-- powers, conversions and comparisons across the 63-bit boundary (the
-- expected output is JavaScript's `bigint`).
let a = 123_456_789_012_345_678_901_234_567_890n
let b = 98_765_432_109_876_543_210_987_654_321n
console.log(a * b)
console.log(a + b, a - b, b - a)
console.log((try a // b), (try a %% b))
console.log((try -a // b), (try -a %% b), (try a // -b), (try a %% -b), (try -a // -b), (try -a %% -b))
let square = a * a
console.log((try square // b), (try square %% b), square // 7n, square %% -7n)
let big = 2n ** 200n
console.log(big, (try big // (2n ** 100n + 1n)), big %% 1_000_000_007n)
console.log(3n ** 100n, (-3n) ** 51n, 0n ** 0n, (-1n) ** 1001n)
let edge = 4_611_686_018_427_387_903n
console.log(edge + 1n, -edge - 1n, -edge - 2n, edge * 2n)
console.log(edge + 1n > edge, -edge - 2n < -edge - 1n, edge + 1n == 4_611_686_018_427_387_904n)
console.log(9_223_372_036_854_775_807n + 1n, -9_223_372_036_854_775_808n - 1n)
let wide: Int64 = 9_223_372_036_854_775_807
console.log(BigInt(wide) * BigInt(wide), BigInt(wide) + 1n)
console.log((try Int64(edge)), Float(big), Float(a), Float(-b))
console.log("interpolated {a * b}")
let values = [a, -b, 0n, edge + 1n]
console.log(values)
let product = a * b * a * b
console.log((try product // (a * b)), (try product %% (b * b + 1n)), (try product // (b * b + 1n)))
console.log(1n - 1n, 0n * a, (-a).abs(), a.abs() == a)
console.log((10n ** 30n).toString(), 10n ** 30n - 1n)
mutable total = 0n
for index in 1..=30 {
	total = total * 3n + BigInt(index)
}
console.log(total)
mutable factorial = 1n
for index in 1..=40 {
	factorial *= BigInt(index)
}
console.log(factorial, (try factorial // (2n ** 64n)), (try factorial %% (2n ** 64n)))
