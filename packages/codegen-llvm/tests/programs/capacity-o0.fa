-- opt-level: 0
-- Native capacity observations: enough room, no content changes or item moves.
mutable text = String.from("héllo", capacity = 100)
assert text.capacity >= 100
text.reserve(200)
assert text.capacity >= 206
assert text == "héllo"
mutable array = Array<Integer>.from([1, 2], capacity = 100)
assert array.capacity >= 100
array.reserve(200)
assert array.capacity >= 202
let arrayCapacity = array.capacity
for i in 0..200 { array.push(i) }
assert array.capacity == arrayCapacity
mutable segmented = GrowingArray<Integer>.from([], capacity = 100)
assert segmented.capacity >= 100
for i in 0..70 { segmented.push(i) }
use first = try segmented[0]
segmented.reserve(3000)
assert segmented.capacity >= 3070
let segmentCapacity = segmented.capacity
for i in 0..3000 { segmented.push(i) }
assert segmented.capacity == segmentCapacity
assert first == 0
let copy = segmented
assert copy.capacity >= copy.length
assert try copy[200] == 130
segmented = []
assert segmented.capacity == segmentCapacity
segmented.push(9)
assert segmented[0] == 9
-- Fresh empty reservation also chooses a contiguous first segment.
mutable fresh: GrowingArray<Byte> = []
fresh.reserve(10000)
assert fresh.capacity >= 10000
for i in 0..10000 { fresh.push(Byte(i %% 256)) }
assert try fresh[8192] == 0
assert try fresh[9999] == 15
mutable set = Set.from([1, 2], capacity = 100)
assert set.capacity >= 100
set.delete(1)
set.reserve(200)
assert set.capacity >= set.size + 200
let setCapacity = set.capacity
for i in 10..210 { set.add(i) }
assert set.capacity == setCapacity
mutable map = Map.from([(1, 1)], capacity = 100)
assert map.capacity >= 100
use value = map.getOrInsert(1, 0)
map.reserve(300)
assert map.capacity >= map.size + 300
for i in 10..310 { map[i] = i }
assert value == 1
mutable gs = GrowingSet.from([1], capacity = 100)
assert gs.capacity >= 100
gs.reserve(300)
assert gs.capacity >= 301
mutable gm = GrowingMap.from([(1, 1)], capacity = 100)
assert gm.capacity >= 100
gm.reserve(300)
assert gm.capacity >= 301
mutable pool = Pool<Integer>.from([1], capacity = 100)
assert pool.capacity >= 100
pool.reserve(20000)
assert pool.capacity >= 20001
use p = pool.add(2)
pool.reserve(40000)
assert p == 2
pool.delete(p)
assert pool.capacity >= pool.size
mutable gp = GrowingPool<Integer>.from([1], capacity = 100)
assert gp.capacity >= 100
gp.reserve(20000)
assert gp.capacity >= 20001
type Point = { x: Integer, name: String }
mutable columns = Columnar<Point>.from([{ x = 1, name = "one" }], capacity = 20000)
assert columns.capacity >= 20000
use column = columns.add({ x = 2, name = "two" })
columns.reserve(40000)
assert column.x == 2
assert columns.capacity >= 40002
mutable gc = GrowingColumnar<Point>.from([], capacity = 20000)
assert gc.capacity >= 20000
gc.reserve(40000)
assert gc.capacity >= 40000
mutable ordered = OrderedColumnar<Point>.from([], capacity = 100)
assert ordered.capacity >= 100
ordered.reserve(200)
assert ordered.capacity >= 200
-- Zero-sized values still have item counts and accept storage hints.
type Empty = {}
mutable emptyValues = Array<Empty>.from([{}], capacity = 100)
emptyValues.reserve(200)
assert emptyValues.capacity >= 201
mutable emptyGrowing = GrowingArray<Empty>.from([{}], capacity = 100)
emptyGrowing.reserve(200)
assert emptyGrowing.capacity >= 201
emptyGrowing.push({})
assert emptyGrowing.length == 2
console.log("capacity ok") -- prints: capacity ok
