-- A compact collection owns a snapshot and supports the ordinary array API.
mutable text = "abcdef"
let characters = text.characters()
text = "changed"
assert characters.length == 6
assert characters.get(0) == "a"
assert characters.get(-1) == "f"
assert characters.get(6) == none
assert characters.get(-7) == none

mutable duplicate = copy characters
duplicate.push("z")
assert characters.length == 6
assert duplicate.join("") == "abcdefz"

mutable editable = "abc".characters()
try editable[1] = "x"
assert editable.join("") == "axc"
use first = try editable[0]
first = "z"
assert editable.join("") == "zxc"

mutable pushed = "ab".characters()
pushed.push("c")
assert pushed.join("") == "abc"
let slice = try "abcdef".characters()[1..4]
assert slice.join("") == "bcd"
try let [a, b] = "ab".characters()
assert a == "a" and b == "b"
mutable joined = ""
for character in "abc".characters() { joined += character }
assert joined == "abc"
let filtered = "abac".characters().filter((c) => c != "a")
assert filtered.join("-") == "b-c"
assert "é🇫🇷\r\n".characters().join("") == "é🇫🇷\r\n"

mutable byCharacters: Map<Array<String>, Integer> = []
byCharacters["abc".characters()] = 7
assert byCharacters.get("abc".characters()) == 7
assert byCharacters.get("abd".characters()) == none

-- Comparisons after an optional read retain negative-index and end behavior,
-- whether characters are compact, materialized, or multi-byte graphemes.
function spaceAt = (items: Array<String>, index: Integer): Boolean => (items.get(index) ?? "\0") == " "
assert spaceAt(" x".characters(), 0)
assert spaceAt("x ".characters(), -1)
assert not spaceAt(" ".characters(), -2)
assert not spaceAt(" ".characters(), 1)
assert not spaceAt("".characters(), 0)
assert spaceAt([" ", "é", "é", "🇫🇷", "\r\n"], 0)
for i in 1..5 { assert not spaceAt([" ", "é", "é", "🇫🇷", "\r\n"], i) }
assert not spaceAt(pushed, 0)
assert "\r" != "\r\n" and "\r\n" != "\n"
assert "\0" != "" and "" != "\0"
console.log("character views ok")
-- prints: character views ok
