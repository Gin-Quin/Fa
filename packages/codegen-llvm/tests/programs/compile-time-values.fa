-- Compile-time values beyond scalars, and `@for` unrolled natively
type Point = { x: Integer, y: Integer }
function grid = (size: Integer): Array<Point> => {
	mutable points: Array<Point> = []
	for i in 0..size {
		points.push(Point { x = i, y = i * i })
	}
	points
}
static points = @grid(3)
static names: Array<String> = ["ana", "bao"]
static pair = (7, "seven")
static nested = [[1, 2], [3]]
static maybe: Integer? = none
console.log(points) -- prints: [{ x = 0, y = 0 }, { x = 1, y = 1 }, { x = 2, y = 4 }]
let (number, word) = pair
console.log(points.length, number, word) -- prints: 3 7 seven
console.log(nested, names.length, maybe ?? -1) -- prints: [[1, 2], [3]] 2 -1
mutable total = 0
@for name, index in names {
	total += name.length * 10 + index
}
console.log(total) -- prints: 61
@for name in names {
	console.log(name.toUpperCase())
}
-- prints: ANA
-- prints: BAO

-- maps, sets, members and ranges
type Color = Enum { red, green, blue }
type Shape = Union {
	Circle = { radius: Integer }
	Labelled = String
	Empty
}
function ages = (): Map<String, Integer> => {
	mutable result: Map<String, Integer> = []
	result["ana"] = 31
	result["bao"] = 27
	result
}
static table = @ages()
static letters: Set<String> = ["a", "b", "a"]
static favorite = Color.green
static shape: Shape = Shape.Circle { radius = 2 }
static plain: Shape = Shape.Empty
static span = 2..=5
static open = 3..
console.log(table, table["bao"] catch error => 0) -- prints: [("ana", 31), ("bao", 27)] 27
console.log(letters, letters.size) -- prints: ["a", "b"] 2
console.log(favorite, shape, plain) -- prints: green Shape.Circle { radius = 2 } Shape.Empty
console.log(span, open, 4 is in span) -- prints: 2..=5 3.. true
