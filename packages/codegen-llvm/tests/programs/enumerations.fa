-- Enumerations: members, equality, `when`, printing; type declarations.
type Color = Enum { red, green, blue }
type Age = Integer(min = 0)
function warmth = (color: Color): String => when color is {
	Color.red => "warm"
	Color.green | Color.blue => "cool"
}
let sky = Color.blue
console.log(warmth(Color.red), warmth(sky)) -- prints: warm cool
console.log(sky, sky == Color.blue, sky == Color.green) -- prints: Color.blue true false
let age: Age = 30
console.log(age) -- prints: 30
