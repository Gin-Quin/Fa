type Failure = Errors { Bad }
function wide = (value: UInt128): UInt128 => value + UInt128(1)
type Source = { run: (value: UInt128) => UInt128 }
type Target = { run: (value: UInt32) => UInt128 }
function show = (holder: Target): UInt128 => holder.run(7)
let original = Source { run = wide }
let narrowed: Target = original
console.log(narrowed.run(8), show(original)) -- prints: 9 8

function print = (value: Integer): Integer => do {
	console.log("body")
	value + 1
}
type Sync = { run: (value: Integer) => Integer }
type Async = { run: async (value: Integer) => Integer }
let sync = Sync { run = print }
let delayed: Async = sync
let pending = start delayed.run(8)
console.log("queued") -- prints: queued
console.log(await pending) -- prints: body
-- prints: 9

function number = (value: Integer): Integer => value + 1
type Plain = { run: (value: Integer) => Integer }
type Fallible = { run: (value: Integer) => Integer throws Failure.Bad }
let plain = Plain { run = number }
let fallible: Fallible = plain
console.log(try fallible.run(9)) -- prints: 10

type NestedSource = { child: Source }
type NestedTarget = { child: Target }
let nested = NestedSource { child = original }
let view: NestedTarget = nested
console.log(view.child.run(10)) -- prints: 11
