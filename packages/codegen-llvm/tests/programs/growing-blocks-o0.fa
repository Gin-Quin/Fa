-- The GrowingArray paths of growing-blocks.fa, built without optimizations.
-- opt-level: 0
mutable bytes: GrowingArray<Byte> = []
for value in 0..130 {
	bytes.push(Byte(value))
}
use first = try bytes[0]
mutable duplicate: GrowingArray<Byte> = []
for byte in bytes {
	duplicate.push(byte)
}
for position in 60..70 {
	duplicate.push(try bytes[position])
}
for _ in 0..70 {
	duplicate.push(59)
}
console.log(first, duplicate.length, try duplicate[139], try duplicate[-1]) -- prints: 0 210 69 59
mutable count = 0
for byte in copy {
	if byte == 59 {
		count += 1
	}
}
console.log(count) -- prints: 71
duplicate = []
duplicate.push(1)
console.log(duplicate) -- prints: [1]
