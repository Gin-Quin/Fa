-- Growing collections keep their elements in place: references into them
-- survive insertions (collections/growing-collections.md).
type Human = { name: String, age: Integer }

mutable people: GrowingArray(Human) = [{ name = "Ana", age = 30 }]
use first = people[0]
for index in 0..100 {
	people.push({ name = "P{index}", age = index })
}
first.age += 1
console.log(first.name) -- prints: Ana
console.log(people[0].age) -- prints: 31
console.log(people.length) -- prints: 101
console.log(try people[100].name) -- prints: P99
console.log(people[-1].age) -- prints: 99

mutable total = 0
for human in people {
	total += human.age
}
console.log(total) -- prints: 4981
for human, index in people {
	if index < 2 {
		human.age += 10
	}
}
console.log(try people[1].age) -- prints: 10

let names = people.map((human) => human.name)
console.log(try names[0], names.length) -- prints: Ana 101
console.log(people.some((human) => human.name == "P50")) -- prints: true
let copied = people
people[0].name = "Changed"
console.log(try copied[0].name, people[0].name) -- prints: Ana Changed

mutable numbers: GrowingArray(Integer) = []
for value in 1..=20 {
	numbers.push(value * value)
}
console.log(numbers) -- prints: [1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144, 169, 196, 225, 256, 289, 324, 361, 400]
console.log(numbers.get(3), numbers.get(30)) -- prints: 16 none
console.log(numbers.isEmpty()) -- prints: false

mutable counts: GrowingMap(String, Integer) = []
use ana = counts.getOrInsert("ana", 0)
for index in 0..50 {
	counts["key{index}"] = index
}
ana += 5
console.log(try counts["ana"], counts.size) -- prints: 5 51
console.log(try counts["key42"]) -- prints: 42

mutable seen: GrowingSet(String) = []
for index in 0..40 {
	seen.add("v{index %% 7}")
}
console.log(seen.size, seen.includes("v3"), seen.includes("v9")) -- prints: 7 true false
