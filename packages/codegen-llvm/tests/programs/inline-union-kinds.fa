-- Every member kind of an inline union: copies, drops, equality, map keys.
type Color = Enum { Red, Green, Blue }
type Value = Union {
	None
	Flag = Boolean
	Small = Int8
	Big = UInt64
	Real = Float
	Letter = Character
	Word = String
	Shade = Color
	Point = { x: Int32, y: Int32, on: Boolean }
	Labelled = { label: String }
	Packed = { flag: Boolean, count: Int16, small: Int8 }
}

function show = (value: Value): String => when value is {
	Value.None => "none"
	Value.Flag as flag => "flag {flag}"
	Value.Small as small => "small {small}"
	Value.Big as big => "big {big}"
	Value.Real as real => "real {real}"
	Value.Letter as letter => "letter {letter}"
	Value.Word as word => "word {word}"
	Value.Shade as shade => when shade is {
		Color.Red => "red"
		Color.Green => "green"
		Color.Blue => "blue"
	}
	Value.Point as point => "point {point.x} {point.y} {point.on}"
	Value.Labelled as labelled => "labelled {labelled.label}"
	Value.Packed as packed => "packed {packed.flag} {packed.count} {packed.small}"
}

let long = "a long text that does not fit in the value itself".repeat(3)
function values = (): Array(Value) => [
	Value.None,
	Value.Flag(true),
	Value.Flag(false),
	Value.Small(-128),
	Value.Big(18446744073709551615),
	Value.Real(0.5),
	Value.Letter("é"),
	Value.Word("short"),
	Value.Word(long),
	Value.Shade(Color.Blue),
	Value.Point { x = -1, y = 2147483647, on = true },
	Value.Labelled { label = long },
	Value.Packed { flag = true, count = -2, small = 3 },
]

mutable all = values()
let snapshot = all
for value, index in all {
	assert show(value) == show(try snapshot[index])
}
for 0..3 {
	for value in values() { all.push(value) }
}
assert all.length == 52
assert show(all[51]) == "packed true -2 3"

-- Values as map values, copied out of the map.
mutable counts: Map(String, Value) = []
for value in all {
	counts[show(value)] = value
}
assert counts.size == 13
for value in values() {
	let found = counts.get(show(value))
	assert found is not none and show(found) == show(value)
}

-- Optional and nested inline unions.
type Holder = { first: Value, second: Value?, list: Array(Value) }
function holder = (n: Integer(min = 0, max = 10)): Holder => Holder {
	first = Value.Word(long.repeat(n))
	second = if n > 1 { Value.Labelled { label = "x".repeat(n * 10) } } else { none }
	list = values()
}
mutable holders: Array(Holder) = []
for n in 0..5 {
	holders.push(holder(n))
}
let copied = holders
holders = []
for h, n in copied {
	assert show(h.first) == "word {long.repeat(n)}"
	assert (h.second is none) == (n <= 1)
	assert h.list.length == 13
}
console.log("inline union kinds ok") -- prints: inline union kinds ok
