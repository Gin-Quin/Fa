-- A small union declared in one file, built, copied, stored and matched in
-- others: every file agrees on its inline layout.
-- file: Choice.fa
export type = Union {
	Empty
	Number = { value: Int32 }
	Text = { text: String }
}
-- file: describe.fa
export function = (choice: Choice): String => when choice is {
	Choice.Empty => "empty"
	Choice.Number as number => "number {number.value}"
	Choice.Text as text => text.text
}
-- file: collect.fa
export function = (count: Integer<min = 0, max = 100>): Array<Choice> => {
	mutable choices: Array<Choice> = []
	for i in 0..count {
		choices.push(Choice.Number { value = Int32(i) })
		choices.push(Choice.Text { text = "x".repeat(i * 10) })
		choices.push(Choice.Empty)
	}
	choices
}
-- file: main.fa
let choices = collect(20)
let copy = choices
mutable total = 0
for choice, index in copy {
	let text = describe(choice)
	total += text.length
	if index %% 3 == 1 { assert text == "x".repeat(index // 3 * 10) }
}
let first = choices.get(0)
assert first is not none and describe(first) == "number 0"
console.log(total) -- prints: 2170
