-- Fused length queries must preserve graphemes across part boundaries.
function check = (parts: Array<String>, separator: String) => {
	let joined = parts.join(separator)
	assert parts.join(separator).length == joined.length
}
let empty: Array<String> = []
check(empty, "\r")
check(["one"], "\r")
check(["", ""], "é")
check(["e", "\u{301}"], "")
check(["\r", "\n"], "")
check(["👩", "\u{200D}", "🔬"], "")
check(["a", "b", "c"], "\u{301}")
assert "abc".characters().join("-").length == 5
for length in 0..65 {
	let text = "a".repeat(length)
	check([text, "middle", text], ";")
	check(text.split("a"), ";")
}
assert ["e", "\u{301}"].join("").length == 1
assert ["\r", "\n"].join("").length == 1
assert empty.join("anything").length == 0

mutable order = ""
function receiver = (): Array<String> mutates order => {
	order += "r"
	["a", "b"]
}
function separator = (): String mutates order => {
	order += "s"
	"-"
}
assert receiver().join(separator()).length == 3
assert order == "rs"
console.log("join length ok")
-- prints: join length ok
