-- `Array(T)?` is a nullable pointer to the array's header: an empty array is
-- present, `none` is null. Copies, drops, fields, maps and narrowing.
function find = (n: Integer): Array(String)? => if n < 0 { none } else {
	mutable items: Array(String) = []
	for i in 0..n { items.push("item {i} with a long enough text to be on the heap") }
	items
}
function size = (items: Array(String)?): Integer => items?.length ?? -1
assert size(find(-1)) == -1
assert size(find(0)) == 0
assert size(find(3)) == 3
let empty = find(0)
assert empty is not none
let copy = empty
assert copy.length == 0

type Holder = { name: String, items: Array(Integer)?, nested: Array(Array(Integer)?) }
mutable holders: Array(Holder) = []
for i in 0..10 {
	holders.push(Holder {
		name = "holder {i}"
		items = if i %% 2 == 0 { none } else { [i, i + 1] }
		nested = [none, [], [i]]
	})
}
let snapshot = holders
holders = []
mutable total = 0
for holder in snapshot {
	total += holder.items?.length ?? 100
	for inner in holder.nested {
		total += inner?.length ?? 1000
	}
}
assert total == 5 * 100 + 5 * 2 + 10 * (1000 + 0 + 1)

mutable byName: Map(String, Array(Integer)?) = [("a", none), ("b", [1, 2, 3])]
byName["c"] = []
assert byName.get("a") is none
assert byName.get("b")?.length == 3
assert byName.get("c")?.length == 0
mutable maybe: Array(Integer)? = [1]
maybe = none
assert maybe is none
maybe = []
assert maybe.length == 0
maybe = [4, 5]
assert maybe.length == 2
console.log("optional arrays ok") -- prints: optional arrays ok
