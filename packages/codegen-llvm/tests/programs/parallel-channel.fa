-- skip-target: wasm native-freestanding
-- A channel between the iterations of a parallel loop and the main thread:
-- the iterations send, the main thread receives once the loop is done.
use { Channel, AtomicBoolean } = std.concurrency

mutable results = Channel(Integer) { capacity = 1000 }
for parallel n in 1..=100 {
	results.send(n * 2) catch error => console.error("closed")
}
results.close()
mutable total = 0
mutable received = 0
loop {
	let value = results.receive() ?? break
	total += value
	received += 1
}
console.log("{received} values, total {total}") -- prints: 100 values, total 10100
console.log(results.tryReceive() == none) -- prints: true

-- a bounded channel: `trySend` fails when it is full
mutable small = Channel(String) { capacity = 2 }
console.log(small.trySend("a"), small.trySend("b"), small.trySend("c")) -- prints: true true false
console.log(small.tryReceive() ?? "none") -- prints: a
small.close()
console.log(small.trySend("d")) -- prints: false
console.log(small.receive() ?? "none") -- prints: b
console.log(small.receive() ?? "none") -- prints: none

-- sending on a closed channel throws
let sent = do {
	small.send("e")
	true
} catch error => false
console.log(sent) -- prints: false

mutable done = AtomicBoolean { value = false }
console.log(done.compareAndSwap(false, true), done.load()) -- prints: true true
