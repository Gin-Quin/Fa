-- skip-target: wasm
-- `for parallel` (advanced brief §14.2): each iteration writes its own
-- index, or a thread-safe value; the output doesn't depend on the order.
use { AtomicInteger, Mutex } = std.concurrency

type Stats = { count: Integer, total: Integer }

function square = (n: Integer): Integer => n * n

-- the sum of the squares, with an atomic
mutable sum = AtomicInteger { value = 0 }
for parallel n in 1..=1000 {
	sum.add(square(n))
}
console.log(sum.load()) -- prints: 333833500

-- a parallel map into an array
let numbers = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
mutable squares = numbers
for parallel number, index in numbers {
	squares[index] = square(number)
}
console.log(squares) -- prints: [9, 1, 16, 1, 25, 81, 4, 36, 25, 9]

-- the elements of a mutable collection, through the loop variable
mutable values = [1, 2, 3, 4]
for parallel(threads = 2) value in values {
	value *= 10
}
console.log(values) -- prints: [10, 20, 30, 40]

-- a mutex protecting an accumulation
mutable stats = Mutex(Stats) { value = { count = 0, total = 0 } }
for parallel n in 0..10000 {
	mutable guard = stats.lock()
	guard.value.count += 1
	guard.value.total += n
}
do {
	let guard = stats.lock()
	console.log("{guard.value.count} {guard.value.total}") -- prints: 10000 49995000
}

-- strings built in the iterations, owned by them
let names = ["Ana", "Bo", "Cy"]
mutable greetings = ["", "", ""]
for parallel name, index in names {
	greetings[index] = "Hello, {name}!"
}
console.log(greetings) -- prints: ["Hello, Ana!", "Hello, Bo!", "Hello, Cy!"]

-- a parallel loop inside a function, nested in another
function countPairs = (size: Integer): Integer => {
	mutable pairs = AtomicInteger { value = 0 }
	for parallel i in 0..size {
		for parallel j in 0..size {
			if i < j {
				pairs.increment()
			}
		}
	}
	pairs.load()
}
console.log(countPairs(100)) -- prints: 4950
