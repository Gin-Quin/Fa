-- asynchronous: false
type Tree = { value: Integer, children: Array<Tree> }

function build = (depth: Integer, width: Integer): Tree => {
	mutable tree = Tree { value = depth, children = [] }
	if depth > 0 {
		for index in 0..width { tree.children.push(build(depth - 1, index)) }
	}
	tree
}

-- A literal's exact buffer cannot claim four available slots on a later push.
function pair = (): Tree => {
	mutable tree = Tree { value = 7, children = [build(0, 0)] }
	tree.children.push(build(0, 0))
	tree
}

function change = (tree: Tree): Void mutates tree => {
	tree.value += 10
	for child in tree.children { change(child) }
}

function sum = (tree: Tree): Integer => {
	mutable total = tree.value
	for child in tree.children { total += sum(child) }
	total
}

function extract = (): Tree throws IndexError => {
	let parent = build(2, 3)
	try parent.children[2]
}

function extractWide = (): Tree throws IndexError => {
	let parent = build(2, 102)
	try parent.children[101]
}

mutable tree = build(2, 3)
let original = tree
change(tree)
assert sum(original) == 5
assert sum(tree) == 75
assert sum(try extract()) == 1
assert sum(try extractWide()) == 1
assert pair().children.length == 2
-- More than one region chunk uses the ordinary external-buffer cleanup.
let wide = build(1, 100)
let wideCopy = wide
assert wide.children.length == 100
assert sum(wide) == 1
assert sum(wideCopy) == 1
mutable forest = [build(2, 3), build(1, 2)]
let snapshot = forest
for root in forest { change(root) }
assert sum(try snapshot[0]) == 5
assert sum(try snapshot[1]) == 1
assert sum(try forest[0]) == 75
assert sum(try forest[1]) == 31
console.log("object array regions") -- prints: object array regions
