-- asynchronous: false
type Tree = { value: Integer, children: Array<Tree> }
type Leaf = { value: Integer, children: Array<Never> }

function build = (depth: Integer): Tree => {
	mutable tree = Tree { value = depth, children = [] }
	if depth > 0 {
		for index in 0..2 { tree.children.push(build(depth - 1)) }
	}
	tree
}

function leaf = (value: Integer): Leaf => Leaf { value, children = [] }

-- A temporary structural value has no root-region ownership proof.
let converted: Tree = leaf(arguments.length)
assert converted.value == arguments.length
assert converted.children.length == 0
assert build(1).value == 1
console.log("structural root fallback") -- prints: structural root fallback
