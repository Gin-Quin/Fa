-- A 64-bit loop count must not wrap to zero when a string's reservation
-- is narrowed to wasm's 32-bit byte count, before unchecked byte stores.
-- skip-target: native native-freestanding
-- asynchronous: false
-- opt-level: 0
-- exit: 101
-- stderr: out of memory
mutable text = ""
for index in 0..4294967296 {
	text += "x"
	assert index != 0
}
console.log(text.length)
