-- Tables under churn: deletions in the middle of probe runs (shifted back), entries reused,
-- the index grown from its own hashes, copies and clears, keys of several widths and kinds.

-- Integers whose hashes share runs: every key is found again after half of them are deleted.
mutable numbers: Map(Integer, Integer) = []
for key in 0..5000 {
	numbers[key * 4096] = key
}
for key in 0..5000 {
	if key %% 2 == 1 {
		numbers.delete(key * 4096)
	}
}
mutable found = 0
mutable sum = 0
for key in 0..5000 {
	let value = numbers.get(key * 4096)
	if value is not none {
		found += 1
		sum += value
	}
}
console.log(found, sum, numbers.size) -- prints: 2500 6247500 2500

-- The freed entries are reused: a cache of a fixed size under insertions and deletions.
mutable cache: Map(Integer, String) = []
for step in 0..20000 {
	cache[step] = "value {step} long enough to be owned on the heap"
	if step >= 100 {
		cache.delete(step - 100)
	}
}
console.log(cache.size, cache.get(19999) == "value 19999 long enough to be owned on the heap")  -- prints: 100 true
console.log(cache.take(19950) == "value 19950 long enough to be owned on the heap", cache.size) -- prints: true 99

-- A copy is independent of its source, then both are cleared or dropped.
mutable copied = cache
copied.delete(19999)
copied[-1] = "new"
console.log(cache.size, copied.size, cache.includes(19999), copied.includes(19999)) -- prints: 99 99 true false
cache.clear()
console.log(cache.size, cache.get(19999), copied.get(-1)) -- prints: 0 none new
for step in 0..10 {
	cache[step] = "again {step}"
}
console.log(cache.size, cache.get(9)) -- prints: 10 again 9

-- Without deletions, the entries keep their insertion order.
mutable ordered: Map(String, Integer) = []
for word in ["delta", "alpha", "charlie", "bravo"] {
	use count = ordered.getOrInsert(word, 0)
	count += word.length
}
console.log(ordered) -- prints: [("delta", 5), ("alpha", 5), ("charlie", 7), ("bravo", 5)]

-- `deleteWhere` removes entries while walking them.
ordered.deleteWhere((word, count) => count == 5)
console.log(ordered, ordered.size) -- prints: [("charlie", 7)] 1

-- Narrow integers, floats (SameValueZero) and sets.
mutable bytes: Map(Int8, Integer) = []
for value in -128..128 {
	bytes[Int8(value)] = value * 2
}
bytes.delete(-128)
console.log(bytes.size, bytes.get(127), bytes.get(-127), bytes.get(-128)) -- prints: 255 254 -254 none
mutable floats: Set(Float) = [0.0, 1.5]
console.log(floats.includes(-0.0), floats.add(-0.0), floats.add(2.5), floats.size) -- prints: true false true 3
mutable seen: Set(Integer) = []
for value in 0..3000 {
	seen.add(value %% 1000)
	if value %% 3 == 0 {
		seen.delete(value %% 1000)
	}
}
console.log(seen.size, seen.includes(999), seen.includes(0)) -- prints: 667 true true
