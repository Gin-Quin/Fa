-- Unrelated anonymous union boxes must be destroyed alongside the tree.
type Tree = Union {
	Leaf = { payload: String | Integer }
	Branch = { left: Tree, right: Tree }
}

function build = (depth: Integer, payload: String): Tree => if depth == 0 {
	Tree.Leaf { payload = payload }
} else {
	Tree.Branch { left = build(depth - 1, payload), right = build(depth - 1, payload) }
}

function duplicate = (tree: Tree): Tree => copy tree
for 0..3 {
	let duplicate = do {
		let root = build(3, "an owning string beyond inline capacity".repeat(2))
		duplicate(root)
	}
	assert duplicate is Tree.Branch
}
console.log("union payload cleanup ok")
-- prints: union payload cleanup ok
