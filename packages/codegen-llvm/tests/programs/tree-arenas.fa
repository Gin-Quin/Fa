-- Recursive construction groups nodes; root copies keep independent regions.
type Tree = {
	value: Integer
	left: Tree?
	right: Tree?

	function build = (depth: Integer): Tree => if depth > 0 {
		Tree { value = depth, left = Tree.build(depth - 1), right = Tree.build(depth - 1) }
	} else { Tree { value = 0 } }

	function count = (self): Integer => 1 + (self.left?.count() ?? 0) + (self.right?.count() ?? 0)
}

function duplicate = (tree: Tree): Tree => copy tree
function optional = (tree: Tree): Tree? => copy tree

for 0..3 {
	let root = Tree.build(12)
	let duplicate = duplicate(root)
	assert root.count() == 8191
	assert duplicate.count() == 8191
	do {
		let subtree = copy root.left
		assert subtree?.count() == 4095
	}
	let boxed = optional(duplicate)
	assert boxed?.count() == 8191
	let moved: Tree? = Tree.build(8)
	assert moved?.count() == 511
	assert root.right?.count() == 4095
	assert duplicate.count() == 8191
}
console.log("tree arenas ok")
-- prints: tree arenas ok
