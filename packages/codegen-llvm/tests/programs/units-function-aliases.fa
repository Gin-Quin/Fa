-- file: library/operators.fa
export namespace = {
	function original = (): Integer => 41
	function identity = <Item>(value: Item): Item => value
	function greet = (text: String = "default"): String => text
	function choose = <Item>(value: Item, other: Item = value): Item => other
}
-- file: application/main.fa
use { original, identity, greet, choose } = library.operators
function alias = original
function same = identity
function greeting = greet
function choice = choose
function qualified = library.operators.greet
function qualifiedIdentity = library.operators.identity
export function = () => {
	console.log(alias(), same(7), same<String>("word"))
	console.log(greeting(), greeting("given"))
	console.log(choice(7), choice<String>("first", "second"))
	console.log(qualified(), qualifiedIdentity("qualified"))
}
-- prints: 41 7 word
-- prints: default given
-- prints: 7 second
-- prints: default qualified
