-- prints: 1 0
-- file: application/main.fa
export function = () => {
	console.log(library.exercise(7, 9))
	console.log(library.exercise("a string beyond inline capacity", "another string beyond inline capacity"))
	library.shared()
}
-- file: library/exercise.fa
export function = <Item>(first: Item, second: Item): Item => {
	mutable map: Map<String, Item> = [("a", first), ("b", second)]
	mutable use current = (map.get("a"))
	reuse current = none
	assert current is none
	reuse current = (map.get("b"))
	if current is not none { current = first }
	mutable items = [first, second]
	mutable use selected = items.find((_item, index) => index == 1)
	reuse selected = none
	assert selected is none
	reuse selected = items.get(-1)
	if selected is not none { selected = first }
	items[1]
}
-- file: library/shared.fa
mutable values: Map<String, Integer> = [("a", 1)]
mutable use current = values.get("a")
function read = (): Integer => current ?? 0
export function = () => {
	let first = read()
	reuse current = none
	console.log(first, read())
}
