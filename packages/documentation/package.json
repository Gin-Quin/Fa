{
	"name": "documentation",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "bun@1.4.4",
	"license": "MIT",
	"scripts": {
		"dev": "bun run generate-routes && bun run --parallel watch:generate-routes vite:dev",
		"build": "bun run generate-routes && bun --bun vite build",
		"preview": "bun --bun vite preview",
		"check": "bun --bun svelte-kit sync && bun check && bun --bun svelte-check",
		"lint": "biome lint",
		"vite:dev": "bun --bun vite dev",
		"generate-routes": "bun scripts/createDocumentationRoutes.ts",
		"watch:generate-routes": "bun scripts/createDocumentationRoutes.ts --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@sveltepress/theme-default": "^8.11.0",
		"@sveltepress/vite": "^1.10.0",
		"@types/bun": "^1.4.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"js-yaml": "^5.5.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@shikijs/themes": "^4.5.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"patchedDependencies": {
		"@sveltepress/theme-default@8.11.0": "patches/@sveltepress%2Ftheme-default@8.11.0.patch",
		"@sveltepress/vite@1.10.0": "patches/@sveltepress%2Fvite@1.10.0.patch"
	},
	"overrides": {
		"@sveltejs/enhanced-img": "^1.0.0"
	}
}
