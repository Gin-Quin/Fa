{
	"name": "documentation",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@9.15.0",
	"license": "MIT",
	"scripts": {
		"dev": "bun run watch:generate-routes --silent & vite dev",
		"check": "svelte-check",
		"build": "bun run generate-routes && vite build",
		"watch:generate-routes": "chokidar --initial '../../documentation/**/*.md' -c 'bun run generate-routes'",
		"generate-routes": "bun run scripts/createDocumentationRoutes.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@sveltepress/theme-default": "^8.11.0",
		"@sveltepress/vite": "^1.10.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"chokidar-cli": "^3.0.0",
		"js-yaml": "^5.5.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@shikijs/themes": "^4.5.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"patchedDependencies": {
		"@sveltepress/theme-default@8.11.0": "patches/@sveltepress%2Ftheme-default@8.11.0.patch",
		"@sveltepress/vite@1.10.0": "patches/@sveltepress%2Fvite@1.10.0.patch"
	},
	"overrides": {
		"@sveltejs/enhanced-img": "^1.0.0"
	}
}
