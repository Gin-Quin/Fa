{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["$app/types", "bun"],
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["src", "scripts", "vite.config.ts"]
}
