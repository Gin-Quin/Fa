{
	"name": "fa",
	"scopeName": "source.fa",
	"patterns": [{ "include": "#code" }],
	"repository": {
		"code": {
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#strings" },
				{ "include": "#declarations" },
				{ "include": "#keywords" },
				{ "include": "#constants" },
				{ "include": "#numbers" },
				{ "include": "#compileTime" },
				{ "include": "#calls" },
				{ "include": "#types" },
				{ "include": "#operators" }
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.block.documentation.fa",
					"begin": "---",
					"end": "---"
				},
				{
					"name": "comment.line.double-dash.fa",
					"match": "--(?!-).*$"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.fa",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.fa",
					"match": "\\\\."
				},
				{
					"name": "meta.interpolation.fa",
					"begin": "\\{",
					"beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.fa" } },
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.fa" } },
					"contentName": "source.fa",
					"patterns": [{ "include": "#code" }]
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.fa" },
						"2": { "name": "entity.name.function.fa" }
					}
				},
				{
					"match": "\\b(type)\\s+(#?[A-Z][a-zA-Z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.fa" },
						"2": { "name": "entity.name.type.fa" }
					}
				},
				{
					"match": "\\b(test)(?=\\s+(?:skip\\s+|only\\s+)?\")",
					"name": "keyword.control.test.fa"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.other.effect.fa",
					"match": "\\b(throws|requires|mutates|invalidates)\\b"
				},
				{
					"name": "storage.type.fa",
					"match": "\\b(type|function|let|mutable|static|reactive|derived|namespace|use|export|async|readonly)\\b"
				},
				{
					"name": "keyword.control.fa",
					"match": "\\b(for|when|if|else|loop|break|continue|return|do|while|await|start|throw|try|catch|provide|parallel|watch|assert|skip|only)\\b"
				},
				{
					"name": "keyword.operator.word.fa",
					"match": "\\b(not|and|or|is|in|as|then|with)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.fa",
					"match": "\\b(true|false|none)\\b"
				},
				{
					"name": "variable.language.self.fa",
					"match": "\\bself\\b"
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.fa",
			"match": "\\b(?:0x[0-9a-fA-F_]+|0b[01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:e[+-]?\\d+)?)\\b"
		},
		"compileTime": {
			"name": "entity.name.function.macro.fa",
			"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
		},
		"calls": {
			"match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\()",
			"captures": {
				"1": { "name": "entity.name.function.call.fa" }
			}
		},
		"types": {
			"name": "support.type.fa",
			"match": "#?\\b[A-Z][A-Za-z0-9_]*\\b"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.fa",
					"match": "=>|->|\\.\\.\\.|\\.\\.=?|\\?\\?|\\?\\."
				},
				{
					"name": "keyword.operator.fa",
					"match": "\\.=|//=?|%%=?|\\*\\*=?|[-+*/]=?|==|!=|<=|>=|<|>|=|\\||\\?|%"
				}
			]
		}
	}
}
